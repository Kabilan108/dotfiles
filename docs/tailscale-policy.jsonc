// Reference copy of the tailnet policy (source of truth: Tailscale admin
// console).Update this file when the console policy changes.
{
	"tagOwners": {
		// coding agents on dedicated agent boxes (none today)
		"tag:agent": ["autogroup:admin"],

		// tleilax: credential services (Vaultwarden, Executor). Once they move
		// (stage 5), the only tag that may advertise svc:vault and svc:executor.
		"tag:credentials": ["autogroup:admin"],

		// machines that exclusively need media (sietch::jellyfin) access
		"tag:media": ["autogroup:admin"],

		// dedicated storage appliances; no outbound fleet access
		"tag:nas": ["autogroup:admin"],

		// dev boxes
		"tag:server": ["autogroup:admin"],
	},

	"autoApprovers": {
		"services": {
			"svc:blocky":      ["tag:server"],
			"svc:cliproxyapi": ["tag:server"],
			"svc:cpa-admin":   ["tag:server"],
			// tag:server stays until Vaultwarden and Executor leave sietch
			// (stage 5); drop it in the same change that retires sietch's copy.
			"svc:executor": ["tag:server", "tag:credentials"],
			"svc:hark":     ["tag:server"],
			"svc:jellyfin": ["tag:server"],
			"svc:llamacpp": ["tag:server"],
			"svc:siren":    ["tag:server"],
			"svc:vault":    ["tag:server", "tag:credentials"],
		},
	},

	"hosts": {
		"sietch":      "100.71.183.33",
		"jacurutu":    "100.108.28.4",
		"tleilax":     "100.73.84.103",
		"pixel-9":     "100.66.90.94",
		"ipad":        "100.120.97.93",
		"moberg-demo": "100.79.75.43",
	},

	"grants": [
		// Phone browser uses Blocky's DoH endpoint. Jacurutu retains its
		// existing control-plane access through the grant below.
		{"src": ["pixel-9"], "dst": ["svc:blocky"], "ip": ["tcp:443"]},

		// Phone opens the CPA dashboard. Jacurutu reaches it through the grant
		// below; nothing else does.
		{"src": ["pixel-9"], "dst": ["svc:cpa-admin"], "ip": ["tcp:443"]},

		// control plane: jacurutu reaches everything
		{"src": ["jacurutu"], "dst": ["*"], "ip": ["*"]},

		// sietch runs coding agents, so it gets nothing on tleilax. Away from
		// home, jacurutu reaches tleilax's boot-time unlock through sietch over
		// the LAN, which this policy doesn't govern.

		// Wireless ADB uses randomized pairing and connection ports. Allow
		// sietch to initiate TCP connections to the Pixel, but nothing else.
		{"src": ["sietch"], "dst": ["pixel-9"], "ip": ["tcp:*"]},

		// allow sietch to access `moberg-demo` while its still part of the tailnet
		{"src": ["sietch"], "dst": ["moberg-demo"], "ip": ["tcp:22"]},

		// Uncomment if syncthing stops syncing after the allow-all removal:
		// jacurutu-side dialing usually suffices, but if sietch must
		// initiate, permit exactly the syncthing port and nothing else.
		// {"src": ["sietch"], "dst": ["jacurutu"], "ip": ["tcp:22000"]},

		// phone: T3 Code and dev servers on both interactive machines. The phone
		// never uses SSH, so it gets every TCP port except 22. It reaches
		// tleilax's services through the svc: grants only.
		{
			"src": ["pixel-9"],
			"dst": ["sietch", "jacurutu"],
			"ip":  ["tcp:1-21", "tcp:23-65535"],
		},

		// iPad: SSH and T3 Code over Tailscale Serve.
		{
			"src": ["ipad"],
			"dst": ["sietch", "jacurutu", "tleilax"],
			"ip":  ["tcp:22", "tcp:443"],
		},

		// tailnet members reach the hosted services. svc:cliproxyapi is left
		// out: only jacurutu, sietch and agent boxes send inference.
		{
			"src": ["autogroup:member"],
			"dst": [
				"svc:executor",
				"svc:hark",
				"svc:jellyfin",
				"svc:llamacpp",
				"svc:siren",
				"svc:vault",
			],
			"ip": ["tcp:443"],
		},

		// sietch is tagged, so autogroup:member above does not cover it; its
		// own consumers use the svc names too (dictator -> siren). Keep this
		// minimal - add services only when something on sietch needs them.
		{
			"src": ["tag:server"],
			"dst": ["svc:cliproxyapi", "svc:siren", "svc:executor", "svc:vault", "svc:hark"],
			"ip":  ["tcp:443"],
		},

		// human-owned devices administer the NAS through Tailscale Serve.
		{
			"src": ["autogroup:member"],
			"dst": ["tag:nas"],
			"ip":  ["tcp:443"],
		},

		// tleilax sends failed-unit alerts to Hark and reaches nothing else.
		{"src": ["tag:credentials"], "dst": ["svc:hark"], "ip": ["tcp:443"]},

		// tagged clients: media boxes get jellyfin, agent boxes get the MCP/API services
		{"src": ["tag:media"], "dst": ["svc:jellyfin"], "ip": ["tcp:443"]},
		{
			"src": ["tag:agent"],
			"dst": ["svc:cliproxyapi", "svc:siren", "svc:executor", "svc:hark"],
			"ip":  ["tcp:443"],
		},
	],

	"ssh": [
		// human SSH to own untagged devices, check mode
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"],
		},
		// sietch is tagged, so autogroup:self does not cover it
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["tag:server"],
			"users":  ["kabilan"],
		},
	],

	"tests": [
		{"src": "ipad", "accept": [
			"sietch:22",
			"sietch:443",
			"jacurutu:22",
			"jacurutu:443",
			"tleilax:22",
			"tleilax:443",
			"svc:vault:443",
			"svc:jellyfin:443",
		], "deny": ["sietch:7297", "svc:cliproxyapi:443", "svc:cpa-admin:443"]},
		{
			"src": "jacurutu",
			"accept": [
				"sietch:22",
				"sietch:443",
				"tleilax:22",
				"tag:nas:443",
				"svc:blocky:443",
				"svc:cliproxyapi:443",
				"svc:cpa-admin:443",
			],
		},
		{
			"src":    "sietch",
			"accept": ["pixel-9:40000", "svc:cliproxyapi:443"],
			"deny": [
				"tleilax:22",
				"tleilax:443",
				"jacurutu:22",
				"jacurutu:443",
				"tag:nas:443",
				"tag:nas:2049",
				"svc:blocky:443",
				"svc:cpa-admin:443",
			],
		},
		{
			"src":    "tag:credentials",
			"accept": ["svc:hark:443"],
			"deny": [
				"sietch:22",
				"jacurutu:22",
				"tag:nas:443",
				"svc:vault:443",
				"svc:cliproxyapi:443",
				"svc:cpa-admin:443",
			],
		},
		{
			"src": "pixel-9",
			"accept": [
				"sietch:443",
				"sietch:8096",
				"jacurutu:443",
				"tag:nas:443",
				"svc:blocky:443",
				"svc:cpa-admin:443",
			],
			"deny": ["sietch:22", "jacurutu:22", "tleilax:22", "svc:cliproxyapi:443"],
		},
		{
			"src":    "tag:agent",
			"accept": ["svc:cliproxyapi:443"],
			"deny":   ["svc:cpa-admin:443"],
		},
		{
			"src":  "tag:nas",
			"deny": ["sietch:22", "jacurutu:22", "tleilax:22", "sietch:53", "svc:blocky:443"],
		},
	],
	"nodeAttrs": [
		{
			// Funnel policy, which lets tailnet members control Funnel
			// for their own devices.
			// Learn more at https://tailscale.com/docs/features/tailscale-funnel
			"target": ["autogroup:member"],
			"attr":   ["funnel"],
		},
		{"target": ["sietch"], "attr": ["funnel"]},
	],
}

