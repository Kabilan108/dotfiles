{
	"tagOwners": {
		"tag:agent": ["autogroup:admin"],

		"tag:credentials": ["autogroup:admin"],

		"tag:media": ["autogroup:admin"],

		"tag:nas": ["autogroup:admin"],

		"tag:server": ["autogroup:admin"],

		"tag:grokbot": ["autogroup:admin"],
	},

	"autoApprovers": {
		"services": {
			"svc:blocky":      ["tag:server"],
			"svc:cliproxyapi": ["tag:server"],
			"svc:cpa-admin":   ["tag:server"],
			"svc:executor-v2": ["tag:credentials"],
			"svc:hark":     ["tag:server"],
			"svc:jellyfin": ["tag:server"],
			"svc:siren":    ["tag:server"],
		},
	},

	"hosts": {
		"sietch":      "100.71.183.33",
		"jacurutu":    "100.108.28.4",
		"tleilax":     "100.73.84.103",
		"pixel-9":     "100.66.90.94",
		"ipad":        "100.120.97.93",
	},

	"grants": [
		{"src": ["pixel-9"], "dst": ["svc:blocky"], "ip": ["tcp:443"]},

		{"src": ["pixel-9"], "dst": ["svc:cpa-admin"], "ip": ["tcp:443"]},

		{"src": ["jacurutu"], "dst": ["*"], "ip": ["*"]},

		{"src": ["sietch"], "dst": ["pixel-9"], "ip": ["tcp:*"]},

		{
			"src": ["pixel-9"],
			"dst": ["sietch", "jacurutu"],
			"ip":  ["tcp:1-21", "tcp:23-65535"],
		},

		{
			"src": ["ipad"],
			"dst": ["sietch", "jacurutu", "tleilax"],
			"ip":  ["tcp:22", "tcp:443"],
		},

		{
			"src": ["autogroup:member"],
			"dst": [
				"svc:executor-v2",
				"svc:hark",
				"svc:jellyfin",
				"svc:siren",
			],
			"ip": ["tcp:443"],
		},

		{
			"src": ["tag:server"],
			"dst": [
				"svc:cliproxyapi",
				"svc:siren",
				"svc:executor-v2",
				"svc:hark",
			],
			"ip": ["tcp:443"],
		},

		{
			"src": ["autogroup:member"],
			"dst": ["tag:nas"],
			"ip":  ["tcp:443"],
		},

		{"src": ["tag:credentials"], "dst": ["svc:hark"], "ip": ["tcp:443"]},
		{"src": ["tag:credentials"], "dst": ["tag:nas"], "ip": ["tcp:445"]},

		{
			"src": ["tag:grokbot"],
			"dst": ["svc:executor-v2", "sietch"],
			"ip":  ["tcp:443"],
		},

		{"src": ["tag:media"], "dst": ["svc:jellyfin"], "ip": ["tcp:443"]},
		{
			"src": ["tag:agent"],
			"dst": ["svc:cliproxyapi", "svc:siren", "svc:executor-v2", "svc:hark"],
			"ip":  ["tcp:443"],
		},
	],

	"ssh": [
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"],
		},
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["tag:server"],
			"users":  ["kabilan"],
		},
	],

	"tests": [
		{"src": "ipad", "accept": [
			"sietch:22",
			"sietch:443",
			"jacurutu:22",
			"jacurutu:443",
			"tleilax:22",
			"tleilax:443",
			"svc:jellyfin:443",
		], "deny": ["sietch:7297", "svc:cliproxyapi:443", "svc:cpa-admin:443"]},
		{
			"src": "jacurutu",
			"accept": [
				"sietch:22",
				"sietch:443",
				"tleilax:22",
				"tag:nas:443",
				"svc:blocky:443",
				"svc:cliproxyapi:443",
				"svc:cpa-admin:443",
			],
		},
		{
			"src":    "sietch",
			"accept": ["pixel-9:40000", "svc:cliproxyapi:443", "svc:executor-v2:443"],
			"deny": [
				"tleilax:22",
				"tleilax:443",
				"jacurutu:22",
				"jacurutu:443",
				"tag:nas:443",
				"tag:nas:2049",
				"svc:blocky:443",
				"svc:cpa-admin:443",
			],
		},
		{
			"src":    "tag:credentials",
			"accept": ["svc:hark:443", "tag:nas:445"],
			"deny": [
				"sietch:22",
				"sietch:445",
				"jacurutu:22",
				"jacurutu:445",
				"tag:nas:443",
				"tag:nas:22",
				"svc:cliproxyapi:443",
				"svc:cpa-admin:443",
			],
		},
		{
			"src": "pixel-9",
			"accept": [
				"sietch:443",
				"sietch:8096",
				"jacurutu:443",
				"tag:nas:443",
				"svc:blocky:443",
				"svc:cpa-admin:443",
			],
			"deny": ["sietch:22", "jacurutu:22", "tleilax:22", "svc:cliproxyapi:443"],
		},
		{
			"src":    "tag:agent",
			"accept": ["svc:cliproxyapi:443", "svc:executor-v2:443"],
			"deny":   ["svc:cpa-admin:443"],
		},
		{
			"src":    "tag:grokbot",
			"accept": ["svc:executor-v2:443", "sietch:443"],
			"deny": [
				"sietch:22",
				"sietch:8096",
				"jacurutu:22",
				"jacurutu:443",
				"tleilax:22",
				"tleilax:443",
				"pixel-9:443",
				"tag:nas:443",
				"svc:hark:443",
				"svc:jellyfin:443",
				"svc:siren:443",
				"svc:cliproxyapi:443",
				"svc:cpa-admin:443",
				"svc:blocky:443",
			],
		},
		{
			"src":  "tag:nas",
			"deny": ["sietch:22", "jacurutu:22", "tleilax:22", "sietch:53", "svc:blocky:443"],
		},
	],
	"nodeAttrs": [
		{
			"target": ["autogroup:member"],
			"attr":   ["funnel"],
		},
		{"target": ["sietch"], "attr": ["funnel"]},
	],
}
