#!/usr/bin/env bash
set -euo pipefail

# Runs a command in this checkout's root dev shell. .envrc is gitignored, so
# git worktrees lack it; use nix develop there, which reads the same flake.
root=$(git rev-parse --show-toplevel)
if [[ -f "$root/.envrc" ]]; then
    exec direnv exec "$root" "$@"
fi
exec nix develop "$root" --command "$@"
