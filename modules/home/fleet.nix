{
  lib,
  osConfig,
  ...
}:
let
  fleet = import ../../lib/fleet.nix;
  thisHost = osConfig.networking.hostName;
  self = fleet.hosts.${thisHost};
  reachable = lib.filterAttrs (name: _: builtins.elem name self.canAccess) fleet.hosts;

  fleetSshSettings = lib.mapAttrs (name: host: {
    HostName = host.tailscaleIp;
    User = host.user;
    RequestTTY = "yes";
    IdentityFile = [
      "~/.ssh/yk-nfc"
      "~/.ssh/yk-nano"
      "~/.ssh/${name}"
      "~/.ssh/id_ed25519"
    ];
    # without this, ssh also offers every key the desktop ssh-agent holds -
    # including the passwordless agent-<host> key, silently bypassing the
    # hardware-key requirement for human logins
    IdentitiesOnly = "yes";
    ControlMaster = "auto";
    ControlPath = "~/.ssh/cm-%r@%h-%p";
    ControlPersist = "4h";
  }) reachable;

  # non-interactive identities for agents/scripts: never touch the YubiKey,
  # never prompt, authenticate with this machine's restricted agent key
  agentSshSettings = lib.mapAttrs' (
    name: host:
    lib.nameValuePair "${name}-agent" {
      HostName = host.tailscaleIp;
      User = host.user;
      IdentityFile = "~/.ssh/agent-${thisHost}";
      IdentitiesOnly = "yes";
      BatchMode = "yes";
      # Share one connection between agent-key commands, like the sessionizer
      # inventory. The socket path must differ from the login connection's
      # cm-%r@%h-%p, or agent-key commands would ride a hardware-key login.
      # Anything that can use the socket can already read the key.
      ControlMaster = "auto";
      ControlPath = "~/.ssh/cm-agent-%r@%h-%p";
      ControlPersist = "10m";
      ServerAliveInterval = 15;
      ServerAliveCountMax = 2;
    }
  ) reachable;

  # Boot-time disk unlock (lib/fleet.nix initrdUnlock), with the hardware
  # keys only. The boot environment's host key is pinned under
  # <host>-initrd in /etc/ssh/ssh_known_hosts (modules/nixos/fleet.nix); any
  # other key is refused. The -away alias jumps through initrdUnlock.jumpHost,
  # which only forwards the encrypted connection.
  unlockTargets = lib.filterAttrs (_: host: (host.initrdUnlock.lanAddress or null) != null) reachable;
  unlockSshSettings = lib.concatMapAttrs (
    name: host:
    let
      unlock = host.initrdUnlock;
      direct = {
        HostName = unlock.lanAddress;
        Port = unlock.port;
        User = "root";
        HostKeyAlias = "${name}-initrd";
        StrictHostKeyChecking = "yes";
        UserKnownHostsFile = "/dev/null";
        IdentityFile = [
          "~/.ssh/yk-nfc"
          "~/.ssh/yk-nano"
        ];
        IdentitiesOnly = "yes";
        RequestTTY = "yes";
        ControlMaster = "no";
        ControlPath = "none";
      };
    in
    {
      "${name}-unlock" = direct;
      "${name}-unlock-away" = direct // {
        ProxyJump = unlock.jumpHost;
      };
    }
  ) unlockTargets;

  renderHost = name: host: ''
    ## ${name} (${host.role})

    ${host.description}

    - tailnet: `${name}.${fleet.tailnet}` (`${host.tailscaleIp}`)
    - user: `${host.user}`
    - repo roots: ${lib.concatMapStringsSep ", " (r: "`${r}`") host.roots}
    - can ssh into: ${
      if host.canAccess == [ ] then "nothing" else lib.concatStringsSep ", " host.canAccess
    }
    - color: ${host.color.name} (`${host.color.hex}`)
  '';

  renderDevice = name: device: ''
    ## ${name} (${device.role})

    ${device.description}

    - tailnet: `${name}.${fleet.tailnet}` (`${device.tailscaleIp}`)
    - model: ${device.model}
    - OS: ${device.os}
  '';

  # Machine-readable fleet registry for scripts (schema below is the contract; bump
  # version on breaking changes). Keys are deliberately left out.
  fleetJson = builtins.toJSON {
    version = 1;
    inherit (fleet) tailnet;
    self = thisHost;
    machines = lib.mapAttrs (name: host: {
      inherit (host)
        role
        description
        user
        roots
        canAccess
        color
        ;
      hostname = "${name}.${fleet.tailnet}";
      ip = host.tailscaleIp;
    }) fleet.hosts;
    devices = lib.mapAttrs (name: device: {
      inherit (device)
        role
        description
        model
        os
        ;
      hostname = "${name}.${fleet.tailnet}";
      ip = device.tailscaleIp;
    }) fleet.devices;
  };

  computersMd = ''
    # Fleet

    Generated from `lib/fleet.nix` — edit there and rebuild; do not edit this file.
    You are on **${thisHost}**.

    ${lib.concatStringsSep "\n" (lib.mapAttrsToList renderHost fleet.hosts)}

    ${lib.concatStringsSep "\n" (lib.mapAttrsToList renderDevice fleet.devices)}
  '';
in
{
  programs.ssh = {
    enable = true;
    enableDefaultConfig = false;
    includes = [ "config.d/private" ];
    settings =
      fleetSshSettings
      // agentSshSettings
      // unlockSshSettings
      // {
        "github.com" = {
          User = "git";
          IdentityFile = "~/.ssh/github";
        };
        # Keep existing SSH URLs working after the November 2026 hostname migration.
        "bitbucket.org ssh.bitbucket.org" = {
          HostName = "ssh.bitbucket.org";
          User = "git";
          IdentityFile = "~/.ssh/moberg-bitbucket";
          # IPv6 connections to Bitbucket time out on this network.
          AddressFamily = "inet";
        };
      };
  };

  # Materialize ~/.ssh/config as a real user-owned file instead of a
  # nix-store symlink: agent harness shells see the store through an
  # id-mapped mount (files stat as nobody), and ssh rejects a config it
  # thinks isn't owned by the user ("Bad owner or permissions").
  home.file.".ssh/config" = {
    target = lib.mkForce ".ssh/config_source";
    onChange = ''
      (
        set -e
        ssh_config_tmp=$(mktemp "$HOME/.ssh/config.XXXXXXXXXX")
        trap 'rm -f "$ssh_config_tmp"' EXIT
        cat "$HOME/.ssh/config_source" > "$ssh_config_tmp"
        chmod 400 "$ssh_config_tmp"
        mv -fT "$ssh_config_tmp" "$HOME/.ssh/config"
      )
    '';
  };

  home.file.".config/fleet/computers.md".text = computersMd;

  home.file.".config/fleet/fleet.json".text = fleetJson;

  # name, color, Tailscale IP: the remote hosts sessionizer lists.
  home.file.".config/fleet/hosts".text =
    lib.concatStringsSep "\n" (
      lib.mapAttrsToList (name: host: "${name}\t${host.color.hex}\t${host.tailscaleIp}") reachable
    )
    + "\n";
}
