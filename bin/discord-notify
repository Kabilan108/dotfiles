#!/usr/bin/env -S uv --quiet run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///

import argparse
import json
import os
import socket
import ssl
import sys
import urllib.error
import urllib.request
from datetime import UTC, datetime
from pathlib import Path

DEFAULT_WEBHOOK_ENV = "DISCORD_WEBHOOK_URL"
CA_BUNDLE_PATHS = [
    Path("/etc/ssl/certs/ca-certificates.crt"),
    Path("/etc/ssl/certs/ca-bundle.crt"),
]

STATUS_COLORS = {
    "info": 3447003,
    "success": 65280,
    "warning": 16776960,
    "error": 10181038,
}


def parse_field(raw: str) -> dict[str, str | bool]:
    name, separator, value = raw.partition("=")
    if not separator or not name.strip() or not value.strip():
        raise argparse.ArgumentTypeError("fields must use NAME=VALUE")

    return {
        "name": name.strip(),
        "value": value.strip(),
        "inline": True,
    }


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Send a Discord webhook embed notification."
    )
    parser.add_argument("-t", "--title", required=True, help="notification title")
    parser.add_argument(
        "-s",
        "--status",
        choices=sorted(STATUS_COLORS),
        default="info",
        help="notification status/color",
    )
    parser.add_argument(
        "--webhook-url",
        help=f"Discord webhook URL (defaults to ${DEFAULT_WEBHOOK_ENV})",
    )
    parser.add_argument(
        "--body",
        help="notification body; stdin is used when omitted",
    )
    parser.add_argument(
        "--username",
        help="override the webhook username shown in Discord",
    )
    parser.add_argument(
        "--url",
        help="URL Discord should open when the embed title is clicked",
    )
    parser.add_argument(
        "--field",
        action="append",
        default=[],
        type=parse_field,
        metavar="NAME=VALUE",
        help="extra inline embed field; may be passed multiple times",
    )
    parser.add_argument(
        "--no-default-fields",
        action="store_true",
        help="omit host and cwd fields",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="print the JSON payload instead of sending it",
    )
    return parser


def read_body(args: argparse.Namespace) -> str | None:
    if args.body is not None:
        body = args.body
    elif sys.stdin.isatty():
        body = ""
    else:
        body = sys.stdin.read()

    body = body.strip()
    return body or None


def resolve_webhook_url(args: argparse.Namespace) -> str:
    webhook_url = args.webhook_url or os.environ.get(DEFAULT_WEBHOOK_ENV, "")
    webhook_url = webhook_url.strip()

    if webhook_url:
        return webhook_url

    raise RuntimeError(
        f"missing Discord webhook URL; pass --webhook-url or set {DEFAULT_WEBHOOK_ENV}"
    )


def make_payload(args: argparse.Namespace) -> dict[str, object]:
    fields: list[dict[str, str | bool]] = []

    if not args.no_default_fields:
        fields.extend(
            [
                {"name": "Host", "value": socket.gethostname(), "inline": True},
                {"name": "Cwd", "value": Path.cwd().as_posix(), "inline": True},
            ]
        )

    fields.extend(args.field)

    embed: dict[str, object] = {
        "title": args.title,
        "color": STATUS_COLORS[args.status],
        "footer": {"text": "Local Notification"},
        "timestamp": datetime.now(UTC).isoformat(),
    }

    body = read_body(args)
    if body:
        embed["description"] = body

    if fields:
        embed["fields"] = fields

    if args.url:
        embed["url"] = args.url

    payload: dict[str, object] = {"embeds": [embed]}
    if args.username:
        payload["username"] = args.username

    return payload


def post_webhook(webhook_url: str, payload: dict[str, object]) -> None:
    request = urllib.request.Request(
        webhook_url,
        data=json.dumps(payload).encode("utf-8"),
        headers={
            "accept": "application/json",
            "content-type": "application/json",
            "user-agent": "discord-notify/1.0 curl-compatible",
        },
        method="POST",
    )
    context = ssl.create_default_context(cafile=find_ca_bundle())

    try:
        with urllib.request.urlopen(request, timeout=20, context=context) as response:
            response.read()
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", errors="replace").strip()
        suffix = f": {body}" if body else ""
        raise RuntimeError(f"Discord webhook failed: {exc.code} {exc.reason}{suffix}")
    except urllib.error.URLError as exc:
        raise RuntimeError(f"Discord webhook failed: {exc.reason}") from exc


def find_ca_bundle() -> str | None:
    for env_name in ("SSL_CERT_FILE", "NIX_SSL_CERT_FILE"):
        value = os.environ.get(env_name, "").strip()
        if value and Path(value).is_file():
            return value

    for path in CA_BUNDLE_PATHS:
        if path.is_file():
            return path.as_posix()

    return None


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    payload = make_payload(args)

    if args.dry_run:
        json.dump(payload, sys.stdout, indent=2)
        sys.stdout.write("\n")
        return 0

    try:
        webhook_url = resolve_webhook_url(args)
        post_webhook(webhook_url, payload)
    except RuntimeError as exc:
        print(exc, file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())

