#!/usr/bin/env -S uv --quiet run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///

import argparse
import json
import os
import re
import socket
import ssl
import sys
import urllib.error
import urllib.request
from datetime import UTC, datetime
from pathlib import Path
from urllib.parse import urlparse

DEFAULT_CONFIG_ENV = "DISCORD_NOTIFY_CONFIG"
DEFAULT_CONFIG_PATH = Path("~/.config/discord-notify/channels.json")
CHANNEL_NAME_PATTERN = re.compile(r"^[a-z0-9][a-z0-9_-]{0,31}$")
DISCORD_WEBHOOK_HOSTS = {
    "canary.discord.com",
    "discord.com",
    "discordapp.com",
    "ptb.discord.com",
}
CA_BUNDLE_PATHS = [
    Path("/etc/ssl/certs/ca-certificates.crt"),
    Path("/etc/ssl/certs/ca-bundle.crt"),
]

STATUS_COLORS = {
    "info": 3447003,
    "success": 65280,
    "warning": 16776960,
    "error": 10181038,
}
STATUS_ICONS = {
    "info": "ℹ️",
    "success": "✅",
    "warning": "⚠️",
    "error": "❌",
}
MAX_EMBED_DESCRIPTION_LENGTH = 4000


def parse_field(raw: str, *, inline: bool) -> dict[str, str | bool]:
    name, separator, value = raw.partition("=")
    if not separator or not name.strip() or not value.strip():
        raise argparse.ArgumentTypeError("fields must use NAME=VALUE")

    return {
        "name": name.strip(),
        "value": value.strip(),
        "inline": inline,
    }


def parse_full_width_field(raw: str) -> dict[str, str | bool]:
    return parse_field(raw, inline=False)


def parse_inline_field(raw: str) -> dict[str, str | bool]:
    return parse_field(raw, inline=True)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Send a Discord webhook embed notification."
    )
    parser.add_argument("-t", "--title", help="notification title")
    parser.add_argument(
        "-s",
        "--status",
        choices=sorted(STATUS_COLORS),
        default="info",
        help="notification status/color",
    )
    parser.add_argument(
        "-c",
        "--channel",
        default="default",
        help="configured channel name (default: default)",
    )
    parser.add_argument(
        "--list-channels",
        action="store_true",
        help="list configured channel names and exit",
    )
    parser.add_argument(
        "--webhook-url",
        help=argparse.SUPPRESS,
    )
    parser.add_argument(
        "--body",
        help="notification body; stdin is used when omitted",
    )
    parser.add_argument(
        "--username",
        help="override the webhook username shown in Discord",
    )
    parser.add_argument(
        "--url",
        help="URL Discord should open when the embed title is clicked",
    )
    parser.add_argument(
        "--field",
        action="append",
        default=[],
        type=parse_full_width_field,
        metavar="NAME=VALUE",
        help="extra full-width embed field; may be passed multiple times",
    )
    parser.add_argument(
        "--inline-field",
        action="append",
        default=[],
        type=parse_inline_field,
        metavar="NAME=VALUE",
        help="extra compact inline embed field; may be passed multiple times",
    )
    parser.add_argument(
        "--full-context",
        action="store_true",
        help="include full hostname and working-directory fields",
    )
    parser.add_argument(
        "--no-default-fields",
        action="store_true",
        help=argparse.SUPPRESS,
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="print the JSON payload instead of sending it",
    )
    return parser


def read_body(args: argparse.Namespace) -> str | None:
    if args.body is not None:
        body = args.body
    elif sys.stdin.isatty():
        body = ""
    else:
        body = sys.stdin.read()

    body = body.strip()
    return body or None


def config_path() -> Path:
    configured_path = os.environ.get(DEFAULT_CONFIG_ENV, "").strip()
    return Path(configured_path or DEFAULT_CONFIG_PATH).expanduser()


def load_channels() -> dict[str, str]:
    path = config_path()
    channels: dict[str, str] = {}

    if path.exists():
        try:
            value = json.loads(path.read_text())
        except (OSError, json.JSONDecodeError) as exc:
            raise RuntimeError(f"could not read Discord channel config {path}: {exc}") from exc

        if not isinstance(value, dict):
            raise RuntimeError(f"Discord channel config {path} must contain a JSON object")

        for channel, webhook_url in value.items():
            if not isinstance(channel, str) or not CHANNEL_NAME_PATTERN.fullmatch(channel):
                raise RuntimeError(f"Discord channel config {path} contains an invalid channel name")
            if not isinstance(webhook_url, str):
                raise RuntimeError(f"Discord channel {channel!r} must have a string webhook URL")
            channels[channel] = validate_webhook_url(webhook_url)

    return channels


def validate_webhook_url(webhook_url: str) -> str:
    webhook_url = webhook_url.strip()
    parsed = urlparse(webhook_url)
    if (
        parsed.scheme != "https"
        or parsed.hostname not in DISCORD_WEBHOOK_HOSTS
        or not parsed.path.startswith("/api/webhooks/")
    ):
        raise RuntimeError("webhook URL must be a Discord HTTPS webhook")
    return webhook_url


def resolve_webhook_url(args: argparse.Namespace, channels: dict[str, str]) -> str:
    if args.webhook_url:
        print(
            "warning: --webhook-url is deprecated; configure a named channel instead",
            file=sys.stderr,
        )
        return validate_webhook_url(args.webhook_url)

    webhook_url = channels.get(args.channel)
    if webhook_url is not None:
        return webhook_url

    available = ", ".join(sorted(channels)) or "none"
    raise RuntimeError(f"Discord channel {args.channel!r} is not configured; available: {available}")


def split_body(body: str | None) -> list[str | None]:
    if body is None:
        return [None]

    chunks: list[str | None] = []
    remaining = body
    while len(remaining) > MAX_EMBED_DESCRIPTION_LENGTH:
        split_at = remaining.rfind("\n", 0, MAX_EMBED_DESCRIPTION_LENGTH + 1)
        if split_at <= 0:
            split_at = MAX_EMBED_DESCRIPTION_LENGTH

        chunks.append(remaining[:split_at].rstrip())
        remaining = remaining[split_at:].lstrip("\n")

    if remaining:
        chunks.append(remaining)

    return chunks


def make_payloads(args: argparse.Namespace) -> list[dict[str, object]]:
    fields: list[dict[str, str | bool]] = []
    hostname = socket.gethostname()
    cwd = Path.cwd()

    if args.full_context and not args.no_default_fields:
        fields.extend(
            [
                {"name": "Host", "value": hostname, "inline": True},
                {"name": "Cwd", "value": cwd.as_posix(), "inline": False},
            ]
        )

    fields.extend(args.field)
    fields.extend(args.inline_field)

    body = read_body(args)
    body_chunks = split_body(body)
    payloads: list[dict[str, object]] = []

    for index, body_chunk in enumerate(body_chunks, start=1):
        title = f"{STATUS_ICONS[args.status]} {args.title}"
        if len(body_chunks) > 1:
            title = f"{title} ({index}/{len(body_chunks)})"
        if args.url:
            title = f"{title} ↗"

        embed: dict[str, object] = {
            "title": title,
            "color": STATUS_COLORS[args.status],
            "footer": {"text": f"{hostname} · {cwd.name or cwd.as_posix()}"},
            "timestamp": datetime.now(UTC).isoformat(),
        }

        if body_chunk:
            embed["description"] = body_chunk

        if fields:
            embed["fields"] = fields

        if args.url:
            embed["url"] = args.url

        payload: dict[str, object] = {"embeds": [embed]}
        if args.username:
            payload["username"] = args.username
        payloads.append(payload)

    return payloads


def post_webhook(webhook_url: str, payload: dict[str, object]) -> None:
    request = urllib.request.Request(
        webhook_url,
        data=json.dumps(payload).encode("utf-8"),
        headers={
            "accept": "application/json",
            "content-type": "application/json",
            "user-agent": "discord-notify/1.0 curl-compatible",
        },
        method="POST",
    )
    context = ssl.create_default_context(cafile=find_ca_bundle())

    try:
        with urllib.request.urlopen(request, timeout=20, context=context) as response:
            response.read()
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", errors="replace").strip()
        suffix = f": {body}" if body else ""
        raise RuntimeError(f"Discord webhook failed: {exc.code} {exc.reason}{suffix}")
    except urllib.error.URLError as exc:
        raise RuntimeError(f"Discord webhook failed: {exc.reason}") from exc


def find_ca_bundle() -> str | None:
    for env_name in ("SSL_CERT_FILE", "NIX_SSL_CERT_FILE"):
        value = os.environ.get(env_name, "").strip()
        if value and Path(value).is_file():
            return value

    for path in CA_BUNDLE_PATHS:
        if path.is_file():
            return path.as_posix()

    return None


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()

    try:
        channels = load_channels()
    except RuntimeError as exc:
        print(exc, file=sys.stderr)
        return 1

    if args.list_channels:
        for channel in sorted(channels):
            print(channel)
        return 0

    if not args.title:
        parser.error("the following arguments are required: -t/--title")

    payloads = make_payloads(args)

    if args.dry_run:
        output: object = payloads[0] if len(payloads) == 1 else payloads
        json.dump(output, sys.stdout, indent=2)
        sys.stdout.write("\n")
        return 0

    try:
        webhook_url = resolve_webhook_url(args, channels)
        for payload in payloads:
            post_webhook(webhook_url, payload)
    except RuntimeError as exc:
        print(exc, file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())

