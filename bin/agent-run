#!/usr/bin/env python3
"""Durable batch workers in tmux. No provider credentials or permission bypasses."""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
import uuid
from datetime import datetime, timezone
from pathlib import Path
from typing import Any


def now() -> str:
    return datetime.now(timezone.utc).isoformat()


def save(path: Path, data: dict[str, Any]) -> None:
    temporary = path.with_suffix(".tmp")
    temporary.write_text(json.dumps(data, indent=2) + "\n")
    temporary.replace(path)


def directory(root: Path, run_id: str) -> Path:
    if not re.fullmatch(r"[a-zA-Z0-9_-]+", run_id):
        raise ValueError("invalid run ID")
    return root / run_id


def tmux(root: Path, *args: str) -> subprocess.CompletedProcess[str]:
    socket = "agent-run-" + hashlib.sha256(str(root).encode()).hexdigest()[:12]
    return subprocess.run(
        ["tmux", "-L", socket, *args], capture_output=True, text=True, check=False
    )


def captured_output(folder: Path, provider: str) -> dict[str, Any]:
    captured: dict[str, Any] = {}
    log = folder / "output.log"
    if not log.exists():
        return captured
    for line in log.read_text(errors="replace").splitlines():
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        if not isinstance(event, dict):
            continue
        if isinstance(event.get("model"), str):
            captured["reported_model"] = event["model"]
        if event.get("type") == "thread.started":
            captured["worker_session"] = event.get("thread_id")
        if provider == "claude":
            if event.get("session_id"):
                captured["worker_session"] = event["session_id"]
            if isinstance(event.get("modelUsage"), dict):
                models = sorted(event["modelUsage"])
                captured["reported_models"] = models
                captured["reported_model"] = models[0] if len(models) == 1 else None
            if event.get("type") == "result":
                captured["provider_error"] = bool(event.get("is_error"))
                if isinstance(event.get("result"), str):
                    captured["result_text"] = event["result"]
    return captured


def read_record(
    root: Path, run_id: str, *, launch_locked: bool = False
) -> dict[str, Any]:
    # Readers share the launch lock: no observable running record before launch.
    if not launch_locked:
        with (root / ".start.lock").open("a") as lock:
            fcntl.flock(lock, fcntl.LOCK_SH)
            return read_record(root, run_id, launch_locked=True)
    folder = directory(root, run_id)
    record = json.loads((folder / "run.json").read_text())
    terminal = folder / "exit.json"
    if not terminal.exists() and record["state"] == "running":
        live = tmux(root, "has-session", "-t", record["tmux_session"])
        if live.returncode != 0:
            record["state"] = "interrupted"
    # The worker may have saved completion while has-session was running.
    if terminal.exists():
        record.update(json.loads(terminal.read_text()))
    elif record["state"] == "interrupted":
        captured = captured_output(folder, record["provider"])
        captured.pop("result_text", None)
        record.update(captured)
    report = folder / "result.md"
    record["result_exists"] = report.is_file()
    record["reviewed"] = (folder / "ack.json").exists()
    return record


def provider_command(record: dict[str, Any], folder: Path) -> list[str]:
    provider = record["provider"]
    resume = record.get("resume_session")
    if provider == "command":
        return record["command"]
    if provider == "codex":
        args = [
            "codex",
            "exec",
            "-m",
            record["model"],
            "-c",
            f'model_reasoning_effort="{record["effort"]}"',
            "--json",
            "-o",
            str(folder / "result.md"),
        ]
        if record["access"] == "auto":
            args += ["--approve-for-me"]
        else:
            args += [
                "-c",
                f'sandbox_mode="{record["access"]}"',
                "-c",
                'approval_policy="never"',
            ]
        # Config flags are accepted by exec/resume; never use --last.
        return args + (["resume", resume, "-"] if resume else ["-"])
    args = [
        "claude",
        "-p",
        "--model",
        record["model"],
        "--effort",
        record["effort"],
        "--permission-mode",
        record["access"],
        "--output-format",
        "json",
    ]
    return args + (["--resume", resume] if resume else [])


def worker(root: Path, run_id: str) -> int:
    folder = directory(root, run_id)
    record = json.loads((folder / "run.json").read_text())
    command = provider_command(record, folder)
    if (Path(record["repo"]) / ".envrc").exists():
        command = ["direnv", "exec", record["repo"], *command]
    started = now()
    try:
        with (
            (folder / "prompt.txt").open() as prompt,
            (folder / "output.log").open("w") as log,
        ):
            result = subprocess.run(
                command,
                cwd=record["repo"],
                stdin=prompt,
                stdout=log,
                stderr=subprocess.STDOUT,
                text=True,
                check=False,
            )
        code = result.returncode
    except OSError as error:
        (folder / "output.log").write_text(f"Launch failed: {error}\n")
        code = 127
    captured = captured_output(folder, record["provider"])
    result_text = captured.pop("result_text", None)
    if result_text is not None:
        (folder / "result.md").write_text(result_text)
    provider_error = captured.get("provider_error", False)
    report = folder / "result.md"
    state = "completed" if code == 0 and not provider_error else "failed"
    if (
        state == "completed"
        and record["provider"] != "command"
        and (not report.exists() or not report.stat().st_size)
    ):
        state = "missing-result"
    save(
        folder / "exit.json",
        {
            "state": state,
            "exit_code": code,
            "started": started,
            "finished": now(),
            "worker_session": captured.get("worker_session"),
            "provider_error": provider_error,
            "reported_model": captured.get("reported_model"),
            "reported_models": captured.get("reported_models", []),
        },
    )
    return 0


def start(root: Path, args: argparse.Namespace) -> int:
    with (root / ".start.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        run_id = args.id or uuid.uuid4().hex
        folder = directory(root, run_id)
        if folder.exists():
            raise ValueError(
                f"run {run_id} already exists; inspect status or resume it explicitly"
            )
        previous = (
            read_record(root, args.resume_from, launch_locked=True)
            if args.resume_from
            else None
        )
        if previous:
            if previous["state"] == "running":
                raise ValueError(
                    "previous worker may still be active; resolve it before resuming"
                )
            if not previous.get("worker_session"):
                raise ValueError(
                    "no provider session ID was captured; use a new self-contained handoff"
                )
        repo = previous["repo"] if previous else str(Path(args.repo or ".").resolve())
        if not Path(repo).is_dir():
            raise ValueError(f"repository does not exist: {repo}")
        provider = previous["provider"] if previous else args.provider
        if not provider:
            raise ValueError("--provider is required for a new run")
        access = previous["access"] if previous else args.access
        if provider != "command" and not access:
            access = "auto"
        allowed = {
            "codex": ("auto", "read-only", "workspace-write"),
            "claude": ("auto", "default", "acceptEdits", "plan"),
            "command": (None,),
        }
        if access not in allowed[provider]:
            raise ValueError(f"invalid access for {provider}: {access}")
        model = (
            previous["model"]
            if previous
            else (
                args.model
                or {
                    "codex": "gpt-5.6-sol",
                    "claude": "claude-fable-5-1",
                    "command": None,
                }[provider]
            )
        )
        command = args.command[1:] if args.command[:1] == ["--"] else args.command
        if provider == "command" and not command:
            raise ValueError("command provider requires -- command args...")
        prompt = Path(args.prompt).read_text() if args.prompt else ""
        if provider != "command" and not prompt.strip():
            raise ValueError("--prompt must name a nonempty self-contained prompt file")
        executable = command[0] if provider == "command" else provider
        if not shutil.which(executable):
            raise ValueError(f"executable unavailable: {executable}")
        folder.mkdir(mode=0o700)
        (folder / "prompt.txt").write_text(prompt)
        record = {
            "id": run_id,
            "repo": repo,
            "provider": provider,
            "model": model,
            "effort": previous["effort"] if previous else args.effort,
            "access": access,
            "created": now(),
            "state": "running",
            "tmux_session": "run-" + run_id,
            "exit_code": None,
            "coordinator_session": args.coordinator,
            "worker_session": None,
            "resume_session": previous["worker_session"] if previous else None,
            "parent_run": args.resume_from,
            "command": command,
            "result": str(folder / "result.md"),
            "log": str(folder / "output.log"),
        }
        save(folder / "run.json", record)
        launch = shlex.join(
            [
                sys.executable,
                str(Path(__file__).resolve()),
                "--state-dir",
                str(root),
                "_worker",
                run_id,
            ]
        )
        result = tmux(
            root, "new-session", "-d", "-s", record["tmux_session"], "-c", repo, launch
        )
        if result.returncode:
            save(
                folder / "exit.json",
                {
                    "state": "failed",
                    "exit_code": None,
                    "error": result.stderr,
                    "finished": now(),
                },
            )
            raise ValueError(
                f"tmux launch failed: {result.stderr.strip()} (run {run_id})"
            )
        print(run_id)
    return 0


def main() -> int:
    os.umask(0o077)
    parser = argparse.ArgumentParser(
        description=__doc__,
        epilog="After start, attach wait through your harness. tmux alone sends no notification. Commands inherit configured credentials, never bypass permissions. launch-agent is for interactive panes. Command argv is persisted and shown in status/reconcile; pass secrets through the environment, not argv.",
    )
    parser.add_argument(
        "--state-dir",
        type=Path,
        default=Path(
            os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state"))
        )
        / "agent-runs",
    )
    sub = parser.add_subparsers(dest="operation", required=True)
    launch = sub.add_parser(
        "start",
        help="launch once; print run ID (use --id to prevent accidental duplicates)",
    )
    launch.add_argument("--provider", choices=["codex", "claude", "command"])
    launch.add_argument("--model")
    launch.add_argument(
        "--effort", default="medium", choices=["low", "medium", "high", "xhigh"]
    )
    launch.add_argument(
        "--access",
        help="default auto: provider automatic approval review; codex also read-only/workspace-write; claude also default/acceptEdits/plan",
    )
    launch.add_argument("--repo")
    launch.add_argument(
        "--prompt", help="prompt file, copied into private run directory"
    )
    launch.add_argument("--id")
    launch.add_argument("--coordinator", help="coordinator session ID, when available")
    launch.add_argument(
        "--resume-from",
        help="terminal run (including interrupted) with a captured provider session; preserves model/access/repo",
    )
    launch.add_argument(
        "command",
        nargs=argparse.REMAINDER,
        help="with --provider command, a shell-free argv after --",
    )
    for name in ["status", "wait", "acknowledge", "_worker"]:
        item = sub.add_parser(name)
        item.add_argument("id")
        if name == "acknowledge":
            item.add_argument(
                "--interrupted",
                action="store_true",
                help="acknowledge an interrupted run after reviewing its log, result and possible side effects",
            )
        if name == "wait":
            item.add_argument(
                "--timeout",
                type=float,
                default=60,
                help="seconds; 0 waits indefinitely; timeout exits 124",
            )
    reconcile = sub.add_parser(
        "reconcile",
        help="list unreviewed runs and their current states; never relaunch",
    )
    reconcile.add_argument("--repo", required=True)
    args = parser.parse_args()
    if args.operation == "wait" and args.timeout < 0:
        parser.error("--timeout must be nonnegative")
    root = args.state_dir.expanduser().resolve()
    root.mkdir(parents=True, exist_ok=True, mode=0o700)
    if args.operation == "start":
        return start(root, args)
    if args.operation == "_worker":
        return worker(root, args.id)
    if args.operation == "reconcile":
        repo = str(Path(args.repo).resolve())
        for path in sorted(root.glob("*/run.json")):
            record = read_record(root, path.parent.name)
            if record["repo"] == repo and not record["reviewed"]:
                print(json.dumps(record))
        return 0
    deadline = (
        time.monotonic() + args.timeout
        if args.operation == "wait" and args.timeout
        else None
    )
    while True:
        record = read_record(root, args.id)
        if args.operation != "wait" or record["state"] != "running":
            break
        if deadline is not None and time.monotonic() >= deadline:
            print(json.dumps(record))
            return 124
        time.sleep(0.25)
    if args.operation == "acknowledge":
        if record["state"] == "running" or (
            record["state"] == "interrupted" and not args.interrupted
        ):
            raise ValueError(
                "running work cannot be acknowledged; inspect interrupted work and use --interrupted"
            )
        save(directory(root, args.id) / "ack.json", {"reviewed_at": now()})
        record["reviewed"] = True
    print(json.dumps(record))
    return 0 if args.operation != "wait" or record["state"] == "completed" else 1


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (ValueError, OSError) as error:
        print(f"agent-run: {error}", file=sys.stderr)
        sys.exit(1)
