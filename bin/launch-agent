#!/usr/bin/env bash
# vim: syn=bash ft=bash
set -euo pipefail

usage() {
  cat <<EOF
Usage: launch-agent [options] [-- agent-args...]

Launch an agent in a new tmux pane. Creates the pane in the current window by
default when running inside tmux. Use --target to launch into an explicit tmux
target from either inside or outside tmux.

Prints the new pane ID (e.g., %42) to stdout.

Options:
  -a, --agent <name>    agent to launch: claude or codex (default: claude)
  -d, --dir <path>      working directory (default: \$PWD)
  -t, --target <target> tmux target window/pane (e.g., atlas:1, %31)
      --task-id <id>    sets CLAUDE_CODE_TASK_LIST_ID env var
  -n, --name <name>     pane title for identification
  -w, --window <target> deprecated alias for --target
  -h, --help            show this help

Everything after -- is passed as extra args to the agent command.
When no -- args are provided, claude defaults to --dangerously-skip-permissions.

Examples:
  launch-agent -d /path/to/worktree
  launch-agent -t atlas:1 -d ./project --task-id "abc-123" -n "phase-1"
  launch-agent -a claude -d ./project -- --dangerously-skip-permissions --verbose
  launch-agent -a codex -t atlas:1 -d ./project
  pane=\$(launch-agent -t atlas:1 -d ./worktree --task-id "\$TASK_ID")
EOF
}

error() {
  echo "error: $1" >&2
  exit 1
}

agent="claude"
dir="$PWD"
task_id=""
name=""
target=""
agent_args=()
parsing_agent_args=false

while [[ $# -gt 0 ]]; do
  if [[ "$parsing_agent_args" == true ]]; then
    agent_args+=("$1")
    shift
    continue
  fi
  case $1 in
  -h | --help)
    usage
    exit 0
    ;;
  -a | --agent)
    agent="$2"
    shift 2
    ;;
  -d | --dir)
    dir="$2"
    shift 2
    ;;
  -t | --target)
    target="$2"
    shift 2
    ;;
  --task-id)
    task_id="$2"
    shift 2
    ;;
  -n | --name)
    name="$2"
    shift 2
    ;;
  -w | --window)
    target="$2"
    shift 2
    ;;
  --)
    parsing_agent_args=true
    shift
    ;;
  *)
    echo "error: unexpected argument '$1'" >&2
    usage >&2
    exit 1
    ;;
  esac
done

if [[ -z "${TMUX:-}" && -z "$target" ]]; then
  error "must be running inside tmux or pass --target"
fi

[[ -d "$dir" ]] || error "directory '$dir' does not exist"
dir=$(realpath "$dir")

case "$agent" in
claude) agent_cmd="claude" ;;
codex) agent_cmd="codex" ;;
*) error "unknown agent: '$agent'" ;;
esac

if [[ ${#agent_args[@]} -eq 0 ]]; then
  case "$agent" in
  claude) agent_args=("--dangerously-skip-permissions") ;;
  esac
fi

split_args=(-d -P -F '#{pane_id}' -c "$dir")
if [[ -n "$target" ]]; then
  split_args+=(-t "$target")
fi

pane_id=$(tmux split-window "${split_args[@]}") ||
  error "failed to create tmux pane"

if [[ -n "$name" ]]; then
  tmux select-pane -t "$pane_id" -T "$name"
fi

launch_cmd=""
if [[ -n "$task_id" ]]; then
  launch_cmd="CLAUDE_CODE_TASK_LIST_ID=$(printf '%q' "$task_id") "
fi
launch_cmd+="$(printf '%q' "$agent_cmd")"
for arg in "${agent_args[@]}"; do
  launch_cmd+=" $(printf '%q' "$arg")"
done

tmux send-keys -t "$pane_id" "$launch_cmd" C-m

echo "$pane_id"
