#!/usr/bin/env bash

set -o pipefail

previous_count=

niri msg -j event-stream | while IFS= read -r event; do
  snapshot=$(jq -c '.WorkspacesChanged.workspaces // empty' <<<"$event")
  [ -n "$snapshot" ] || continue

  workspace_count=$(jq 'length' <<<"$snapshot")
  if [ -n "$previous_count" ] && [ "$workspace_count" -eq "$previous_count" ]; then
    continue
  fi
  previous_count=$workspace_count

  agent=$(jq -c '.[] | select(.name == "agent")' <<<"$snapshot")
  [ -n "$agent" ] || continue

  agent_output=$(jq -r '.output' <<<"$agent")
  agent_index=$(jq '.idx' <<<"$agent")
  last_index=$(jq --arg output "$agent_output" '[.[] | select(.output == $output) | .idx] | max' <<<"$snapshot")

  if [ "$agent_index" -ne "$((last_index - 1))" ]; then
    niri msg action move-workspace-to-index 9 --reference agent
  fi
done
