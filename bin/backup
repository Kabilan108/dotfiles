#!/usr/bin/env -S uv --quiet run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [ "typer" ]
# ///

import json
import os
import socket
import sys
import subprocess
import tarfile
import tempfile
from dataclasses import dataclass
from datetime import datetime, timedelta
from pathlib import Path
from typing import TypedDict, cast

import typer

DATE_FORMAT = "%m.%d.%Y"
DEFAULT_CONFIG_PATH = Path.home() / ".config" / "backup" / "config.json"


@dataclass(frozen=True)
class DirectorySpec:
    path: Path
    max_age_days: int | None


@dataclass(order=True, frozen=True)
class BackupRecord:
    date: datetime
    folder: str
    filename: str
    remote_path: str


class HostConfig(TypedDict):
    dirs: list[str]
    target: str
    max_age_days: int


BackupConfig = dict[str, HostConfig]


def load_config(config_path: Path, host: str) -> tuple[list[DirectorySpec], str, int]:
    with config_path.open("r", encoding="utf-8") as fh:
        raw = cast(BackupConfig, json.load(fh))

    host_config = raw.get(host, None)
    if host_config is None:
        available = ", ".join(sorted(raw))
        raise Exception(
            f"no configuration found for host '{host}' (available: {available})"
        )

    try:
        dirs_raw = host_config["dirs"]
        target_raw = host_config["target"]
        default_max_age = host_config["max_age_days"]
    except KeyError as missing:
        raise Exception(
            f"missing required configuration key for host '{host}': {missing.args[0]}"
        ) from missing

    directory_specs: list[DirectorySpec] = []
    for entry in dirs_raw:
        path_str, _, age_str = entry.partition(":")
        if not path_str or not os.path.isabs(path_str):
            raise Exception(f"directory path must be absolute: {entry}")

        max_age_override: int | None = None
        if age_str:
            try:
                max_age_override = int(age_str)
            except ValueError as exc:
                raise Exception(
                    f"invalid max age in '{entry}' (expected integer)"
                ) from exc
            if max_age_override < 0:
                raise Exception(f"max age must be non-negative in '{entry}'")

        directory_specs.append(
            DirectorySpec(
                path=Path(path_str).resolve(), max_age_days=max_age_override
            )
        )

    if not isinstance(default_max_age, int) or default_max_age < 0:
        raise Exception("'max_age_days' must be a non-negative integer")

    return directory_specs, target_raw.rstrip("/"), default_max_age


def run_rclone(
    args: list[str], *, capture_output: bool = False
) -> subprocess.CompletedProcess:
    cmd = ["rclone", *args]
    try:
        result = subprocess.run(cmd, check=True, capture_output=True, text=True)
        if not capture_output:
            if result.stdout:
                print(result.stdout, end="")
            if result.stderr:
                print(result.stderr, end="", file=sys.stderr)
        return result
    except FileNotFoundError as exc:
        raise RuntimeError("rclone executable not found in PATH") from exc
    except subprocess.CalledProcessError as exc:
        stderr = exc.stderr if exc.stderr else ""
        stdout = exc.stdout if exc.stdout else ""
        raise RuntimeError(
            "rclone command failed:\n"
            "<stdout>\n"
            f"{stdout}\n"
            "</stdout>\n"
            "<stderr>\n"
            f"{stderr}\n"
            "</stderr>"
        ) from exc


def collect_backups(remote_base: str, host: str) -> dict[str, list[BackupRecord]]:
    result = run_rclone(
        ["lsf", f"{remote_base}/{host}", "--recursive", "--files-only"],
        capture_output=True,
    )

    backups: dict[str, list[BackupRecord]] = {}

    for line in result.stdout.splitlines():
        line = line.strip()
        if not line:
            continue
        parts = line.split("/")
        if len(parts) < 2:
            continue
        folder, filename = parts[-2], parts[-1]
        if not filename.endswith(".tar.gz"):
            continue
        if not filename.startswith(f"{folder}-"):
            continue
        date_str = filename[len(folder) + 1 : -7]
        try:
            parsed_date = datetime.strptime(date_str, DATE_FORMAT)
        except ValueError:
            continue
        remote_path = f"{remote_base}/{host}/{folder}/{filename}"
        record = BackupRecord(
            date=parsed_date, folder=folder, filename=filename, remote_path=remote_path
        )
        backups.setdefault(folder, []).append(record)

    for folder_records in backups.values():
        folder_records.sort(reverse=True)

    return backups


app = typer.Typer(help="Backup utility powered by rclone")


@app.command()
def push(
    config: str | None = typer.Option(
        None,
        help="Path to configuration file (default: ~/.config/backup/config.json)",
    ),
):
    """Create archives and upload them to the remote"""
    config_path = Path(config).expanduser() if config else DEFAULT_CONFIG_PATH
    host = socket.gethostname().strip()

    try:
        directories, remote_base, _ = load_config(config_path, host)
    except Exception as exc:
        typer.echo(f"config error: {exc}", err=True)
        raise typer.Exit(2)

    for spec in directories:
        if not spec.path.exists():
            typer.echo(f"warning: skipping missing directory {spec.path}", err=True)
            continue
        if not spec.path.is_dir():
            typer.echo(f"warning: skipping non-directory path {spec.path}", err=True)
            continue

        folder_name = spec.path.resolve().name
        date_str = datetime.now().strftime(DATE_FORMAT)
        archive_name = f"{folder_name}-{date_str}.tar.gz"
        remote_path = f"{remote_base}/{host}/{folder_name}/{archive_name}"

        with tempfile.NamedTemporaryFile(suffix=".tar.gz", delete=False) as tmp_file:
            tmp_path = Path(tmp_file.name)

        try:
            with tarfile.open(tmp_path, "w:gz") as archive:
                archive.add(str(spec.path), arcname=folder_name)

            run_rclone(["copyto", tmp_path.as_posix(), remote_path])
            typer.echo(f"uploaded {spec.path} -> {remote_path}")
        finally:
            try:
                tmp_path.unlink()
            except FileNotFoundError:
                pass


@app.command("list")
def list_backups(
    dirs: list[str] | None = typer.Option(
        None,
        "-d",
        "--dir",
        help="Limit listing to specific directories",
    ),
    config: str | None = typer.Option(
        None,
        help="Path to configuration file (default: ~/.config/backup/config.json)",
    ),
):
    """List available backups"""
    config_path = Path(config).expanduser() if config else DEFAULT_CONFIG_PATH
    host = socket.gethostname().strip()

    try:
        _, remote_base, _ = load_config(config_path, host)
    except Exception as exc:
        typer.echo(f"config error: {exc}", err=True)
        raise typer.Exit(2)

    try:
        backups = collect_backups(remote_base, host)
    except RuntimeError as exc:
        typer.echo(str(exc), err=True)
        raise typer.Exit(1)
    if dirs is not None:
        backups = {dir: records for dir, records in backups.items() if dir in dirs}

    if not backups:
        typer.echo("no backups found")
        return

    for folder in sorted(backups):
        typer.echo(f"{folder}:")
        for record in backups[folder]:
            typer.echo(f"  - {record.date.strftime(DATE_FORMAT)}")


@app.command()
def pull(
    name: str = typer.Argument(
        ..., help="Directory name whose backup should be downloaded"
    ),
    date: str | None = typer.Option(
        None,
        "-d",
        "--date",
        help=f"Specific backup date ({DATE_FORMAT})",
    ),
    output: str | None = typer.Option(
        None,
        "-o",
        "--output",
        help="Directory to download into",
    ),
    config: str | None = typer.Option(
        None,
        help="Path to configuration file (default: ~/.config/backup/config.json)",
    ),
):
    """Download a backup from the remote"""
    config_path = Path(config).expanduser() if config else DEFAULT_CONFIG_PATH
    host = socket.gethostname().strip()

    try:
        _, remote_base, _ = load_config(config_path, host)
    except Exception as exc:
        typer.echo(f"config error: {exc}", err=True)
        raise typer.Exit(2)

    backups = collect_backups(remote_base, host)
    records = backups.get(name, [])
    if not records:
        typer.echo(f"no backups found for folder '{name}'", err=True)
        raise typer.Exit(1)

    target_record: BackupRecord | None = None

    if date:
        try:
            requested_date = datetime.strptime(date, DATE_FORMAT)
        except ValueError:
            typer.echo(f"invalid date '{date}', expected {DATE_FORMAT}", err=True)
            raise typer.Exit(1)

        for record in records:
            if record.date == requested_date:
                target_record = record
                break

        if target_record is None:
            typer.echo(f"no backup dated {date} for folder '{name}'", err=True)
            raise typer.Exit(1)
    else:
        target_record = records[0]

    destination_dir = Path(output).expanduser().resolve() if output else Path.cwd()
    destination_dir.mkdir(parents=True, exist_ok=True)
    destination_file = destination_dir / target_record.filename

    run_rclone(["copyto", target_record.remote_path, destination_file.as_posix()])
    typer.echo(f"downloaded to {destination_file}")


@app.command()
def janitor(
    config: str | None = typer.Option(
        None,
        help="Path to configuration file (default: ~/.config/backup/config.json)",
    ),
):
    """Delete backups older than the configured retention period"""
    config_path = Path(config).expanduser() if config else DEFAULT_CONFIG_PATH
    host = socket.gethostname().strip()

    try:
        directories, remote_base, default_max_age = load_config(config_path, host)
    except Exception as exc:
        typer.echo(f"config error: {exc}", err=True)
        raise typer.Exit(2)

    try:
        backups = collect_backups(remote_base, host)
    except RuntimeError as exc:
        typer.echo(str(exc), err=True)
        raise typer.Exit(1)
    now = datetime.now()
    deletions = 0

    for spec in directories:
        folder = spec.path.name or spec.path.resolve().name
        records = backups.get(folder)
        if not records:
            continue
        max_age_days = (
            spec.max_age_days if spec.max_age_days is not None else default_max_age
        )
        if max_age_days <= 0:
            continue
        cutoff = now - timedelta(days=max_age_days)
        old_records = [record for record in records if record.date < cutoff]
        for record in old_records:
            run_rclone(["deletefile", record.remote_path])
            typer.echo(f"deleted {folder}: {record.filename}")
            deletions += 1

    if deletions == 0:
        typer.echo("no old backups to delete")


if __name__ == "__main__":
    app()

