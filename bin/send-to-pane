#!/usr/bin/env bash
# vim: syn=bash ft=bash
set -euo pipefail

usage() {
  cat <<EOF
Usage: send-to-pane [options] [target] [file]

Send text content to a tmux pane safely via load-buffer.
Reads from file or stdin, loads into tmux buffer, and pastes to the target pane.

Arguments:
  target     tmux pane target (e.g., %31, session:window.pane)
  file       content source (default: stdin)

Options:
  -t, --target <target>
               tmux target pane (same as positional target)
  --no-enter   skip sending Enter (C-m) after paste
  -h, --help   show this help
EOF
}

error() {
  echo "error: $1" >&2
  exit 1
}

send_enter=true
target=""
file=""

while [[ $# -gt 0 ]]; do
  case $1 in
  -h | --help)
    usage
    exit 0
    ;;
  --no-enter)
    send_enter=false
    shift
    ;;
  -t | --target)
    target="$2"
    shift 2
    ;;
  *)
    if [[ -z "$target" ]]; then
      target="$1"
    elif [[ -z "$file" ]]; then
      file="$1"
    else
      echo "error: unexpected argument '$1'" >&2
      usage >&2
      exit 1
    fi
    shift
    ;;
  esac
done

if [[ -z "$target" ]]; then
  echo "error: target is required" >&2
  usage >&2
  exit 1
fi

tmux display-message -t "$target" -p '#{pane_id}' >/dev/null 2>&1 ||
  error "target '$target' does not exist"

tmpfile=""
cleanup() { [[ -n "$tmpfile" ]] && rm -f "$tmpfile"; }
trap cleanup EXIT

if [[ -n "$file" ]]; then
  [[ -r "$file" ]] || error "cannot read '$file'"
  [[ -s "$file" ]] || error "file '$file' is empty"
  tmpfile=""
  buf_source="$file"
else
  tmpfile=$(mktemp)
  cat >"$tmpfile"
  [[ -s "$tmpfile" ]] || error "no content to send (stdin was empty)"
  buf_source="$tmpfile"
fi

tmux load-buffer "$buf_source"
tmux paste-buffer -t "$target"

if [[ "$send_enter" == true ]]; then
  tmux send-keys -t "$target" C-m
fi
