#!/usr/bin/env bash
# vim: syn=bash ft=bash
#
# rebuild [--key yk-nfc-deploy|yk-nano-deploy] [--unsigned] [switch|test|boot]:
# build this host from ~/dotfiles and hand the action (default switch) to
# nixos-rebuild.
#
# First it lists the commits since this host's last signed deploy tag
# (deploy/<host>/*) and any uncommitted changes, and asks before building them.
# Where the YubiKey handles live (jacurutu), approving signs the next tag at
# HEAD with the PIN and a touch and pushes it. Elsewhere it builds unsigned once
# you say so. --unsigned prints the same list and builds without asking or
# signing.
#
# Without --key it signs with the key on whichever deploy YubiKey is plugged
# in (deploy-key, installed with `deploy`), and with yk-nfc-deploy when both
# are. When there's a tag to sign and no deploy YubiKey is plugged in, it
# stops before asking.
set -euo pipefail

usage() {
  echo "usage: rebuild [--key yk-nfc-deploy|yk-nano-deploy] [--unsigned] [switch|test|boot]" >&2
  echo "  --key defaults to the deploy key on the plugged-in YubiKey (yk-nfc-deploy if both are)." >&2
  exit 2
}

host_name=$(hostname)
repo=$HOME/dotfiles
key=""
unsigned=false
action=switch

while (($#)); do
  case $1 in
  --key)
    [[ -n ${2:-} ]] || usage
    key=$2
    shift 2
    ;;
  --unsigned)
    unsigned=true
    shift
    ;;
  switch | test | boot)
    action=$1
    shift
    ;;
  *) usage ;;
  esac
done

if [[ -n ${FLEET_HOST_ANSI:-} ]]; then
  printf 'Rebuilding dotfiles flake for \033[%sm%s\033[0m\n' "$FLEET_HOST_ANSI" "$host_name"
else
  printf 'Rebuilding dotfiles flake for %s\n' "$host_name"
fi

show_log() {
  git -C "$repo" --no-pager log --no-decorate --format='  %h %<(16,trunc)%an %s' "$@"
}

# A signed tag also lets that commit's CI publish to the binary cache.
show_ci_changes() {
  local changed file
  changed=$(git -C "$repo" log --format= --name-only "$@" -- .github | sed '/^$/d' | sort -u)
  if [[ -n $changed ]]; then
    echo "These commits change CI, which publishes to the binary cache once the tag is pushed:"
    while IFS= read -r file; do
      echo "  $file"
    done <<<"$changed"
  fi
}

# Returns 0 to build. Each failure returns explicitly: errexit is off inside
# a function called from `if`.
review() {
  local head last last_tag="" last_commit="" dirty answer tag
  head=$(git -C "$repo" rev-parse HEAD) || return 1
  if last=$(deploy-tag -C "$repo" latest "$host_name"); then
    read -r last_tag last_commit <<<"$last"
  fi
  dirty=$(git -C "$repo" status --porcelain --untracked-files=no) || return 1

  if [[ $last_commit == "$head" && -z $dirty ]]; then
    echo "HEAD is $last_tag."
    return 0
  fi
  if [[ $last_commit != "$head" ]]; then
    if [[ -z $last_tag ]]; then
      echo "No signed deploy tag for $host_name yet. The last 20 commits:"
      show_log -20 HEAD
      show_ci_changes -20 HEAD
    elif git -C "$repo" merge-base --is-ancestor "$last_commit" HEAD; then
      echo "Commits since $last_tag:"
      show_log "$last_commit..HEAD"
      show_ci_changes "$last_commit..HEAD"
    else
      echo "HEAD doesn't contain $last_tag (${last_commit:0:12})."
      echo "Commits that drop out:"
      show_log "HEAD..$last_commit"
      echo "Commits that come in:"
      show_log "$last_commit..HEAD"
      show_ci_changes "$last_commit..HEAD"
    fi
  fi
  if [[ -n $dirty ]]; then
    echo "Uncommitted changes, built but not covered by any tag:"
    echo "$dirty"
  fi

  if [[ $unsigned == true ]]; then
    echo "Building unsigned (--unsigned)."
    return 0
  fi
  if [[ $last_commit != "$head" && -z $key ]] && command -v deploy-key >/dev/null; then
    if ! key=$(deploy-key); then
      echo "Plug in a deploy YubiKey, or build with --unsigned."
      return 1
    fi
  fi
  key=${key:-yk-nfc-deploy}
  key_file=$HOME/.ssh/$key
  if [[ $last_commit != "$head" && -e $key_file ]]; then
    read -r -p "Sign deploy/$host_name at ${head:0:12} with $key and build? [y]es, [u]nsigned build, [N]o: " answer
    case $answer in
    [yY]*)
      tag=$(deploy-tag -C "$repo" sign --key "$key_file" --message "rebuild $host_name" "$host_name" "$head") || return 1
      if ! deploy-tag -C "$repo" push --key "$key_file" "$tag"; then
        echo "Couldn't push $tag; building anyway. Push it later with: deploy-tag -C $repo push --key $key_file $tag"
      fi
      return 0
      ;;
    [uU]*) return 0 ;;
    *) return 1 ;;
    esac
  fi
  read -r -p "Build this unsigned? [y/N] " answer
  [[ $answer == [yY]* ]]
}

if ! command -v deploy-tag >/dev/null; then
  echo "deploy-tag isn't installed yet, so this build skips the signed-tag check."
  sudo nixos-rebuild "$action" --flake "$repo#$host_name"
  exit
fi
if ! review; then
  echo "Not building."
  exit 1
fi

# The deploy receiver switches only under this lock (modules/nixos/deploy),
# and rechecks what the host runs after taking it, so a deploy that was
# building when this switch or test finished can't undo it.
sudo flock /run/fleet-switch.lock nixos-rebuild "$action" --flake "$repo#$host_name"
