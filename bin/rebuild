#!/usr/bin/env bash
# vim: syn=bash ft=bash
set -euo pipefail

usage() {
  echo "usage: rebuild [--key yk-nfc-deploy|yk-nano-deploy] [--unsigned] [--no-wait] [switch|test|boot]" >&2
  echo "  --key defaults to the deploy key on the plugged-in YubiKey (yk-nfc-deploy if both are)." >&2
  exit 2
}

host_name=$(hostname)
repo=$HOME/dotfiles
key=""
unsigned=false
wait_for_ci=true
action=switch

while (($#)); do
  case $1 in
  --key)
    [[ -n ${2:-} ]] || usage
    key=$2
    shift 2
    ;;
  --unsigned)
    unsigned=true
    shift
    ;;
  --no-wait)
    wait_for_ci=false
    shift
    ;;
  switch | test | boot)
    action=$1
    shift
    ;;
  *) usage ;;
  esac
done

if [[ -n ${FLEET_HOST_ANSI:-} ]]; then
  printf 'Rebuilding dotfiles flake for \033[%sm%s\033[0m\n' "$FLEET_HOST_ANSI" "$host_name"
else
  printf 'Rebuilding dotfiles flake for %s\n' "$host_name"
fi

show_log() {
  git -C "$repo" --no-pager log --no-decorate --format='  %h %<(16,trunc)%an %s' "$@"
}

show_ci_changes() {
  local changed file
  changed=$(git -C "$repo" log --format= --name-only "$@" -- .github | sed '/^$/d' | sort -u)
  if [[ -n $changed ]]; then
    echo "These commits change CI, which publishes to the binary cache once the tag is pushed:"
    while IFS= read -r file; do
      echo "  $file"
    done <<<"$changed"
  fi
}

signed_tag="" signed_object="" signed_commit=""
pin() {
  local tag=$1 commit=$2 object
  object=$(git -C "$repo" rev-parse --verify --quiet "refs/tags/$tag") || return 1
  deploy-tag -C "$repo" approves "$tag" "$host_name" "$object" "$commit" || return 1
  signed_tag=$tag signed_object=$object signed_commit=$commit
}

review() {
  local head last last_tag="" last_commit="" dirty answer tag approved=false
  head=$(git -C "$repo" rev-parse HEAD) || return 1
  if last=$(deploy-tag -C "$repo" latest "$host_name"); then
    read -r last_tag last_commit <<<"$last"
  fi
  dirty=$(git -C "$repo" status --porcelain --untracked-files=no) || return 1
  if [[ $last_commit == "$head" && $last_tag == deploy/fleet/* ]]; then
    approved=true
  fi

  if [[ $approved == true && -z $dirty ]]; then
    echo "HEAD is $last_tag."
    if [[ $unsigned == false ]]; then
      pin "$last_tag" "$head" || return 1
    fi
    return 0
  fi
  if [[ $last_commit != "$head" ]]; then
    if [[ -z $last_tag ]]; then
      echo "No signed deploy tag for $host_name yet. The last 20 commits:"
      show_log -20 HEAD
      show_ci_changes -20 HEAD
    elif git -C "$repo" merge-base --is-ancestor "$last_commit" HEAD; then
      echo "Commits since $last_tag:"
      show_log "$last_commit..HEAD"
      show_ci_changes "$last_commit..HEAD"
    else
      echo "HEAD doesn't contain $last_tag (${last_commit:0:12})."
      echo "Commits that drop out:"
      show_log "HEAD..$last_commit"
      echo "Commits that come in:"
      show_log "$last_commit..HEAD"
      show_ci_changes "$last_commit..HEAD"
    fi
  elif [[ $approved == false ]]; then
    echo "HEAD has only $last_tag, an old per-host tag, which approves nothing."
  fi
  if [[ -n $dirty ]]; then
    echo "Uncommitted changes, built but not covered by any tag:"
    echo "$dirty"
  fi

  if [[ $unsigned == true ]]; then
    echo "Building unsigned (--unsigned)."
    return 0
  fi
  if [[ $approved == false && -z $key ]] && command -v deploy-key >/dev/null; then
    if ! key=$(deploy-key); then
      echo "Plug in a deploy YubiKey, or build with --unsigned."
      return 1
    fi
  fi
  key=${key:-yk-nfc-deploy}
  key_file=$HOME/.ssh/$key
  if [[ $approved == false && -e $key_file ]]; then
    read -r -p "Sign a deploy tag for $host_name at ${head:0:12} with $key and build? [y]es, [f]leet (every host), [u]nsigned build, [N]o: " answer
    case $answer in
    [yYfF]*)
      local -a hosts=("$host_name")
      if [[ $answer == [fF]* ]]; then
        read -r -a hosts <<<"$(deploy-tag fleet-hosts)" || return 1
        if [[ " ${hosts[*]} " != *" $host_name "* ]]; then
          echo "$host_name isn't a fleet host (${hosts[*]}), so a fleet tag wouldn't approve this build."
          return 1
        fi
      fi
      tag=$(deploy-tag -C "$repo" sign --key "$key_file" --message "rebuild $host_name" "${hosts[@]}" "$head") || return 1
      if ! deploy-tag -C "$repo" push --key "$key_file" "$tag"; then
        echo "Couldn't push $tag; building anyway. Push it later with: deploy-tag -C $repo push --key $key_file $tag"
      elif [[ -z $dirty ]]; then
        pin "$tag" "$head" || return 1
      fi
      return 0
      ;;
    [uU]*) return 0 ;;
    *) return 1 ;;
    esac
  fi
  read -r -p "Build this unsigned? [y/N] " answer
  [[ $answer == [yY]* ]]
}

if ! review; then
  echo "Not building."
  exit 1
fi
if [[ -n $signed_tag && $wait_for_ci == true ]] && command -v deploy-wait >/dev/null &&
  ! deploy-wait -C "$repo" ${key:+--key "$HOME/.ssh/$key"} --commit "$signed_commit" "$signed_tag"; then
  echo "Not building."
  exit 1
fi
if [[ -n $signed_tag ]]; then
  exec deploy-switch -C "$repo" --object "$signed_object" --commit "$signed_commit" \
    "$signed_tag" "$host_name" "$action"
fi

sudo flock /run/fleet-switch.lock nixos-rebuild "$action" --flake "$repo#$host_name"
