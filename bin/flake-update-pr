#!/usr/bin/env python3
"""Weekly flake update: bump the locks in a fresh worktree, build, and open a PR.

Runs on sietch as kabilan (see home/services/flake-update.nix). Every outcome
ends in a Hark notification: a PR that builds, a draft PR marked failing, no
updates, or a job error.
"""

from __future__ import annotations

import argparse
import os
import re
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import traceback
from dataclasses import dataclass
from datetime import datetime
from pathlib import Path

HOSTS = ("sietch", "jacurutu")
BRANCH_PREFIX = "auto/flake-update-"
KEEP_RUNS = 8
# Three builds at most; home/services/flake-update.nix allows 10h for the unit.
BUILD_TIMEOUT = 3 * 3600
BODY_LIMIT = 60_000
SECTION_LIMIT = 12_000
LOG_TAIL = 80
CHANGE_RE = re.compile(r"^• (Updated|Added) input '([^']+)':$")
URL_RE = re.compile(r"^\s+(?:→ )?'([^']*)'(?: \(([^)]*)\))?$")
GITHUB_RE = re.compile(r"^github:([^/]+/[^/]+)/([0-9a-f]{40})$")


@dataclass
class Step:
    ok: bool
    log: Path
    output: str


@dataclass
class Build:
    host: str
    step: Step
    old: str | None
    diff: str | None
    retried: Path | None = None


def run_step(cmd: list[str], log: Path, cwd: Path | None = None, timeout: int | None = None) -> Step:
    """Run a command with stdout and stderr captured to a log file."""
    with log.open("w") as out:
        out.write(f"$ {' '.join(cmd)}\n")
        out.flush()
        try:
            proc = subprocess.run(
                cmd, cwd=cwd, stdout=subprocess.PIPE, stderr=out, text=True, timeout=timeout, check=False
            )
        except subprocess.TimeoutExpired:
            out.write(f"\ntimed out after {timeout}s\n")
            return Step(False, log, "")
        out.write(proc.stdout)
        out.write(f"\nexit {proc.returncode}\n")
    return Step(proc.returncode == 0, log, proc.stdout.strip())


def git(*args: str, cwd: Path) -> str:
    return subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True, check=True).stdout.strip()


def tail(path: Path, lines: int = LOG_TAIL) -> str:
    return "\n".join(path.read_text(errors="replace").splitlines()[-lines:])


def clip(text: str, limit: int = SECTION_LIMIT) -> str:
    if len(text) <= limit:
        return text
    return text[:limit] + f"\n... truncated ({len(text) - limit} more characters, full output in the run logs)"


def fence(text: str) -> str:
    return "````text\n" + text.replace("````", "'```") + "\n````"


def details(summary: str, body: str) -> str:
    return f"<details><summary>{summary}</summary>\n\n{body}\n\n</details>"


@dataclass
class Change:
    name: str
    old: str
    old_date: str
    new: str
    new_date: str

    def cell(self, ref: str, date: str) -> str:
        if not ref:
            return "(new)"
        match = GITHUB_RE.match(ref)
        label = f"{match.group(1)}@{match.group(2)[:9]}" if match else ref
        return f"`{label}` {date}".strip()

    def compare(self) -> str:
        old, new = GITHUB_RE.match(self.old), GITHUB_RE.match(self.new)
        if old and new and old.group(1) == new.group(1):
            return f"[compare](https://github.com/{new.group(1)}/compare/{old.group(2)}...{new.group(2)})"
        return ""


def input_changes(update_log: Path) -> list[Change]:
    changes: list[Change] = []
    lines = update_log.read_text(errors="replace").splitlines()
    for i, line in enumerate(lines):
        header = CHANGE_RE.match(line)
        if not header:
            continue
        urls = []
        for follow in lines[i + 1 : i + 3]:
            url = URL_RE.match(follow)
            if not url:
                break
            urls.append((re.sub(r"\?.*$", "", url.group(1)), url.group(2) or ""))
        if not urls:
            continue
        old, new = urls if header.group(1) == "Updated" and len(urls) == 2 else (("", ""), urls[-1])
        changes.append(Change(header.group(2), old[0], old[1], new[0], new[1]))
    return changes


def changes_table(title: str, changes: list[Change]) -> str:
    if not changes:
        return f"**{title}:** no input changes."
    rows = "\n".join(
        f"| `{c.name}` | {c.cell(c.old, c.old_date)} | {c.cell(c.new, c.new_date)} | {c.compare()} |"
        for c in changes
    )
    return f"**{title}**\n\n| Input | Old | New | |\n| --- | --- | --- | --- |\n{rows}"


def remote_repo(cwd: Path) -> str:
    url = git("remote", "get-url", "origin", cwd=cwd)
    match = re.search(r"github\.com[:/]([^/]+/[^/]+?)(?:\.git)?$", url)
    if not match:
        raise RuntimeError(f"origin is not a GitHub remote: {url}")
    return match.group(1)


def branch_name(repo_dir: Path, now: datetime) -> str:
    branch = BRANCH_PREFIX + now.strftime("%Y-%m-%d")
    taken = subprocess.run(
        ["git", "ls-remote", "--exit-code", "--heads", "origin", branch], cwd=repo_dir, capture_output=True
    )
    return branch if taken.returncode == 2 else f"{branch}-{now.strftime('%H%M%S')}"


def toplevel(flake: Path, host: str) -> str:
    return f"{flake}#nixosConfigurations.{host}.config.system.build.toplevel"


def build_host(worktree: Path, run_dir: Path, state_dir: Path, host: str, old: str | None) -> Build:
    link = state_dir / f"result-{host}-new"
    cmd = ["nix", "build", "--keep-going", "--print-out-paths", "--out-link", str(link), toplevel(worktree, host)]
    step = run_step(cmd, run_dir / f"build-{host}.log", timeout=BUILD_TIMEOUT)
    retried = None
    if not step.ok:
        # Upstream test suites flake; a second try rebuilds only what failed.
        retried = step.log
        step = run_step(cmd, run_dir / f"build-{host}-retry.log", timeout=BUILD_TIMEOUT)
    diff = None
    if step.ok and old:
        diff_step = run_step(
            ["nix", "store", "diff-closures", old, step.output], run_dir / f"diff-{host}.log"
        )
        diff = diff_step.output if diff_step.ok else f"diff-closures failed:\n{tail(diff_step.log)}"
    return Build(host, step, old, diff, retried)


def old_closure(worktree: Path, run_dir: Path, state_dir: Path, host: str) -> tuple[str | None, str]:
    if host == socket.gethostname():
        return os.path.realpath("/run/current-system"), "the running system"
    step = run_step(
        [
            "nix",
            "build",
            "--print-out-paths",
            "--out-link",
            str(state_dir / f"result-{host}-base"),
            toplevel(worktree, host),
        ],
        run_dir / f"build-{host}-base.log",
        timeout=BUILD_TIMEOUT,
    )
    if step.ok:
        return step.output, "the base branch build"
    return None, f"no diff: the base branch build failed (`{step.log}`)"


def error_lines(log: Path) -> str:
    lines = log.read_text(errors="replace").splitlines()
    causes = [line.strip() for line in lines if line.strip().startswith("error:") and line.strip() != "error:"]
    trace = tail(log, 40)
    return "\n".join(causes) + "\n\n" + trace if causes else trace


def verify_command(repo: str, branch: str) -> str:
    return (
        "On jacurutu, from your own `nixos` checkout (not this branch):\n\n"
        "```sh\n"
        "cd ~/dotfiles && git switch nixos && git pull --ff-only\n"
        f"bin/flake-lock-verify {branch}\n"
        "```\n\n"
        "This PR was written on sietch, so this description is not trusted either. "
        "`docs/flake-update.md` on `nixos` has the same command. "
        "Exit 0 means every changed input passed. Exit 2 means only MANUAL inputs are left to check by hand. "
        "Merge with the `gh pr merge ... --match-head-commit` line it prints."
    )


def render_body(
    *,
    ok: bool,
    repo: str,
    branch: str,
    base: str,
    base_sha: str,
    root_changes: list[Change],
    raspi_changes: list[Change],
    builds: list[Build],
    old_notes: dict[str, str],
    tleilax: Step,
    run_dir: Path,
) -> str:
    status = "All builds passed." if ok else "**Build failing.** See the errors below."
    lines = [
        f"Weekly flake update from sietch, based on `{base}` at `{base_sha[:12]}`.",
        "",
        status,
        "",
        "## Before merging",
        "",
        verify_command(repo, branch),
        "",
        "## Input changes",
        "",
        changes_table("flake.lock", root_changes),
        "",
        changes_table("raspi/flake.lock (nixpkgs only)", raspi_changes),
        "",
        "## Build results",
        "",
        "| Target | Result |",
        "| --- | --- |",
    ]
    for build in builds:
        result = f"built `{build.step.output}`" if build.step.ok else "**failed**"
        if build.retried:
            outcome = "passed" if build.step.ok else "failed again"
            result += f" (first attempt failed, retry {outcome}; first log `{build.retried}`)"
        lines.append(f"| {build.host} toplevel | {result} |")
    tleilax_result = f"evaluated `{tleilax.output}`" if tleilax.ok else "**evaluation failed**"
    lines.append(f"| tleilax drvPath (aarch64, eval only) | {tleilax_result} |")
    lines += ["", "## Closure diffs", ""]
    for build in builds:
        if build.diff is not None:
            text = build.diff or "(no changes)"
            lines.append(details(f"{build.host} vs {old_notes[build.host]}", fence(clip(text))))
        elif build.step.ok:
            lines.append(f"{build.host}: {old_notes[build.host]}")
        else:
            lines.append(f"{build.host}: no diff, the build failed.")
        lines.append("")
    failures = [(f"{b.host} build", b.step.log) for b in builds if not b.step.ok]
    if not tleilax.ok:
        failures.append(("tleilax evaluation", tleilax.log))
    if failures:
        lines += ["## Errors", ""]
        for label, log in failures:
            lines += [f"**{label}**", "", fence(clip(error_lines(log), 6000)), ""]
        lines += [
            "A throw from `packages/security-overrides.nix` means nixpkgs caught up and that override can go.",
            "",
        ]
    lines += [
        "## After merging",
        "",
        "Rebuild sietch and jacurutu. tleilax builds its own closure: "
        "`nixos-rebuild switch --flake ~/dotfiles/raspi#tleilax --build-host tleilax-agent "
        "--target-host tleilax-agent --sudo`.",
        "",
        f"Full logs on sietch: `{run_dir}`.",
    ]
    body = "\n".join(lines)
    return clip(body, BODY_LIMIT)


QUIET = False


def notify(message: str, title: str, key: str) -> None:
    if QUIET:
        print(f"notify skipped: {title}: {message}")
        return
    proc = subprocess.run(
        ["harkctl", "notify", message, "--title", title, "--project", "dotfiles", "--idempotency-key", key],
        capture_output=True,
        text=True,
        check=False,
    )
    if proc.returncode != 0:
        print(f"harkctl notify failed (exit {proc.returncode}): {proc.stderr.strip()}", file=sys.stderr)


def supersede(repo: str, base: str, number: str, branch: str, cwd: Path) -> None:
    listing = subprocess.run(
        [
            "gh", "pr", "list", "--repo", repo, "--state", "open", "--author", "@me", "--base", base,
            "--json", "number,headRefName", "--jq", ".[] | [.number, .headRefName] | @tsv",
        ],
        cwd=cwd, capture_output=True, text=True, check=True,
    ).stdout
    for line in listing.splitlines():
        old_number, head = line.split("\t")
        if head.startswith(BRANCH_PREFIX) and head != branch:
            subprocess.run(
                [
                    "gh", "pr", "close", old_number, "--repo", repo, "--delete-branch",
                    "--comment", f"Superseded by #{number}.",
                ],
                cwd=cwd, check=True,
            )


def prune_runs(runs_dir: Path) -> None:
    for old in sorted(p for p in runs_dir.iterdir() if p.is_dir())[:-KEEP_RUNS]:
        shutil.rmtree(old, ignore_errors=True)


def update(args: argparse.Namespace, run_dir: Path, state_dir: Path, now: datetime) -> int:
    repo_dir: Path = args.repo_dir
    repo = remote_repo(repo_dir)
    git("worktree", "prune", cwd=repo_dir)
    git("fetch", "--quiet", "origin", args.base, cwd=repo_dir)
    base_sha = git("rev-parse", f"origin/{args.base}", cwd=repo_dir)
    branch = branch_name(repo_dir, now)
    date = now.strftime("%Y-%m-%d")
    key = f"flake-update-{run_dir.name}"

    scratch = Path(tempfile.mkdtemp(prefix="flake-update-"))
    worktree = scratch / "dotfiles"
    try:
        git("worktree", "add", "--quiet", "--detach", str(worktree), base_sha, cwd=repo_dir)
        old: dict[str, str | None] = {}
        old_notes: dict[str, str] = {}
        for host in HOSTS:
            old[host], old_notes[host] = old_closure(worktree, run_dir, state_dir, host)

        root_update = run_step(["nix", "flake", "update"], run_dir / "update-root.log", cwd=worktree)
        raspi_update = run_step(
            ["nix", "flake", "update", "nixpkgs"], run_dir / "update-raspi.log", cwd=worktree / "raspi"
        )
        if not (root_update.ok and raspi_update.ok):
            failed = root_update if not root_update.ok else raspi_update
            notify(
                f"nix flake update failed, no PR opened. Log on sietch: {failed.log}",
                "Flake update failed",
                key,
            )
            print(tail(failed.log), file=sys.stderr)
            return 1

        if not git("status", "--porcelain", cwd=worktree):
            notify("No flake inputs changed this week. No PR opened.", "Flake update: nothing new", key)
            print("no input changes")
            return 0

        git("add", "flake.lock", "raspi/flake.lock", cwd=worktree)
        git("commit", "--quiet", "-m", f"flake.lock: weekly update {date}", cwd=worktree)
        head = git("rev-parse", "HEAD", cwd=worktree)

        builds = [build_host(worktree, run_dir, state_dir, host, old[host]) for host in HOSTS]
        tleilax = run_step(
            [
                "nix", "eval", "--raw",
                f"{worktree / 'raspi'}#nixosConfigurations.tleilax.config.system.build.toplevel.drvPath",
            ],
            run_dir / "eval-tleilax.log",
        )
        ok = all(b.step.ok for b in builds) and tleilax.ok

        body = render_body(
            ok=ok,
            repo=repo,
            branch=branch,
            base=args.base,
            base_sha=base_sha,
            root_changes=input_changes(root_update.log),
            raspi_changes=input_changes(raspi_update.log),
            builds=builds,
            old_notes=old_notes,
            tleilax=tleilax,
            run_dir=run_dir,
        )
        body_file = run_dir / "pr-body.md"
        body_file.write_text(body)
        title = f"flake.lock: weekly update {date}"
        if not ok:
            title = f"[build failing] {title}"

        if args.no_pr:
            print(f"--no-pr: commit {head}, title {title!r}, body {body_file}")
            return 0 if ok else 1

        git("push", "--quiet", "origin", f"HEAD:refs/heads/{branch}", cwd=worktree)
        create = ["gh", "pr", "create", "--repo", repo, "--base", args.base, "--head", branch,
                  "--title", title, "--body-file", str(body_file)]
        if not ok:
            create.append("--draft")
        url = subprocess.run(create, cwd=worktree, capture_output=True, text=True, check=True).stdout.strip()
        number = url.rstrip("/").rsplit("/", 1)[-1]
        supersede(repo, args.base, number, branch, worktree)

        if ok:
            notify(f"PR #{number} builds. Run flake-lock-verify before merging. {url}", "Flake update ready", key)
        else:
            notify(f"PR #{number} is marked failing. {url}", "Flake update: build failing", key)
        print(url)
        return 0 if ok else 1
    finally:
        subprocess.run(["git", "worktree", "remove", "--force", str(worktree)], cwd=repo_dir, check=False)
        shutil.rmtree(scratch, ignore_errors=True)
        subprocess.run(["git", "worktree", "prune"], cwd=repo_dir, check=False)


class Terminated(Exception):
    pass


def on_terminate(signum: int, _frame: object) -> None:
    raise Terminated(f"stopped by signal {signal.Signals(signum).name}")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--repo-dir", type=Path, default=Path.home() / "dotfiles")
    parser.add_argument("--base", default="nixos", help="branch to update from and open the PR against")
    parser.add_argument("--no-pr", action="store_true", help="build and write the PR body, but push nothing")
    args = parser.parse_args(argv)
    global QUIET
    QUIET = args.no_pr

    now = datetime.now()
    state_dir = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "flake-update"
    runs_dir = state_dir / "runs"
    run_dir = runs_dir / now.strftime("%Y-%m-%d-%H%M%S")
    run_dir.mkdir(parents=True)
    signal.signal(signal.SIGTERM, on_terminate)
    try:
        return update(args, run_dir, state_dir, now)
    except Exception as err:
        traceback.print_exc()
        (run_dir / "error.log").write_text(traceback.format_exc())
        notify(f"Flake update job failed: {err}. Logs on sietch: {run_dir}", "Flake update failed", f"flake-update-{run_dir.name}-error")
        return 1
    finally:
        prune_runs(runs_dir)


if __name__ == "__main__":
    sys.exit(main())
