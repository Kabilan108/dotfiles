class MeetingMinutesError(RuntimeError):
    pass


def now_epoch() -> float:
    return time.time()


def ensure_directories() -> None:
    for path in (STATE_DIR, JOBS_DIR, JOB_LOCKS_DIR, INBOX_DIR, WORK_DIR):
        path.mkdir(parents=True, exist_ok=True)


def atomic_write_text(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{uuid.uuid4().hex}.tmp")
    try:
        temporary.write_text(content)
        temporary.replace(path)
    finally:
        temporary.unlink(missing_ok=True)


def atomic_write_json(path: Path, payload: dict[str, Any]) -> None:
    atomic_write_text(path, json.dumps(payload, indent=2, sort_keys=True) + "\n")


def read_json(path: Path) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as error:
        raise MeetingMinutesError(f"Could not read {path}: {error}") from error
    if not isinstance(value, dict):
        raise MeetingMinutesError(f"Expected a JSON object in {path}")
    return value


def job_path(job_id: str) -> Path:
    if not re.fullmatch(r"[a-f0-9]{32}", job_id):
        raise MeetingMinutesError(f"Invalid meeting job id: {job_id}")
    return JOBS_DIR / f"{job_id}.json"


def job_lock_path(job_id: str) -> Path:
    if not re.fullmatch(r"[a-f0-9]{32}", job_id):
        raise MeetingMinutesError(f"Invalid meeting job id: {job_id}")
    return JOB_LOCKS_DIR / f"{job_id}.lock"


def save_job(job: dict[str, Any]) -> None:
    job["updated_at"] = now_epoch()
    atomic_write_json(job_path(str(job["job_id"])), job)


def update_status(
    job: dict[str, Any],
    *,
    label: str,
    progress: int = 0,
    total: int = 0,
) -> None:
    phase = str(job.get("phase", "idle"))
    payload: dict[str, Any] = {
        "job_id": job.get("job_id", ""),
        "phase": phase,
        "label": label,
        "progress": progress,
        "total": total,
        "note_path": job.get("note_path", ""),
        "error": job.get("error", ""),
        "updated_at": now_epoch(),
    }
    if "diarization" in job:
        payload["diarization"] = job["diarization"]
    if "skipped_transcription_chunks" in job:
        payload["skipped_transcription_chunks"] = job[
            "skipped_transcription_chunks"
        ]
    if phase == "completed":
        payload["visible_until"] = now_epoch() + COMPLETION_VISIBLE_SECONDS
    elif phase == "error":
        payload["visible_until"] = now_epoch() + ERROR_VISIBLE_SECONDS
    atomic_write_json(STATUS_PATH, payload)


def set_phase(
    job: dict[str, Any],
    phase: str,
    label: str,
    *,
    progress: int = 0,
    total: int = 0,
) -> None:
    job["phase"] = phase
    job["error"] = ""
    save_job(job)
    update_status(job, label=label, progress=progress, total=total)


def kick_worker() -> bool:
    result = subprocess.run(
        [
            "systemctl",
            "--user",
            "start",
            "--no-block",
            "meeting-minutes-worker.service",
        ],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    return result.returncode == 0


def enqueue_recording(args: argparse.Namespace) -> dict[str, Any]:
    ensure_directories()
    source = Path(args.recording).expanduser().resolve()
    if not source.is_file():
        raise MeetingMinutesError(f"Recording does not exist: {source}")

    stat = source.stat()
    job_id = uuid.uuid4().hex
    inbox_path = INBOX_DIR / f"{job_id}{source.suffix.lower() or '.mp4'}"
    started_at = float(args.started_at or stat.st_mtime)
    job: dict[str, Any] = {
        "version": 1,
        "job_id": job_id,
        "recording_identity": (
            f"{stat.st_dev}:{stat.st_ino}:{stat.st_size}:{int(started_at)}"
        ),
        "phase": "staging",
        "source_path": str(source),
        "recording_path": str(source),
        "recording_started_at": started_at,
        "recording_duration_seconds": int(args.duration_seconds or 0),
        "created_at": now_epoch(),
        "updated_at": now_epoch(),
        "calendar_enrichment": {
            "status": "pending",
            "mode": "executor-agent-best-effort",
        },
        "notification_attempted": False,
        "error": "",
    }
    with job_lock_path(job_id).open("a+") as job_lock:
        fcntl.flock(job_lock.fileno(), fcntl.LOCK_EX)
        save_job(job)
        update_status(job, label="Staging meeting")

        try:
            shutil.move(str(source), inbox_path)
        except OSError as error:
            job["phase"] = "error"
            job["error"] = f"Could not stage recording: {error}"
            save_job(job)
            update_status(job, label="Meeting failed")
            raise MeetingMinutesError(job["error"]) from error

        job["phase"] = "queued"
        job["recording_path"] = str(inbox_path)
        job["inbox_path"] = str(inbox_path)
        save_job(job)
        update_status(job, label="Minutes queued")
    worker_started = kick_worker()
    return {
        "job_id": job_id,
        "phase": "queued",
        "recording": str(inbox_path),
        "worker_started": worker_started,
    }


def recover_staged_recording(job: dict[str, Any]) -> None:
    if job.get("phase") != "staging":
        return
    source = Path(str(job.get("source_path", "")))
    inbox = INBOX_DIR / f"{job['job_id']}{source.suffix.lower() or '.mp4'}"
    if inbox.is_file():
        job["recording_path"] = str(inbox)
        job["inbox_path"] = str(inbox)
        job["phase"] = "queued"
        save_job(job)
        return
    if source.is_file():
        shutil.move(str(source), inbox)
        job["recording_path"] = str(inbox)
        job["inbox_path"] = str(inbox)
        job["phase"] = "queued"
        save_job(job)
        return
    raise MeetingMinutesError("Staged recording is missing from both source and inbox")


def run_checked(
    command: list[str], *, timeout: int | None = None
) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(
        command,
        check=False,
        capture_output=True,
        text=True,
        timeout=timeout,
    )
    if result.returncode != 0:
        detail = (result.stderr or result.stdout).strip()[-2000:]
        raise MeetingMinutesError(
            f"Command failed ({command[0]}, exit {result.returncode}): {detail}"
        )
    return result


def probe_duration(recording: Path) -> float:
    for entries in ("format=duration", "stream=duration"):
        result = run_checked(
            [
                "ffprobe",
                "-v",
                "error",
                "-select_streams",
                "a:0",
                "-show_entries",
                entries,
                "-of",
                "default=noprint_wrappers=1:nokey=1",
                str(recording),
            ],
            timeout=60,
        )
        try:
            return float(result.stdout.strip().splitlines()[0])
        except (ValueError, IndexError):
            continue
    result = run_checked(
        [
            "ffmpeg",
            "-hide_banner",
            "-i",
            str(recording),
            "-f",
            "null",
            "-",
        ],
        timeout=300,
    )
    match = re.findall(r"time=(\d+):(\d\d):(\d\d(?:\.\d+)?)", result.stderr or "")
    if match:
        hours, minutes, seconds = match[-1]
        return int(hours) * 3600 + int(minutes) * 60 + float(seconds)
    raise MeetingMinutesError("ffprobe returned an invalid duration")


def prepare_chunks(job: dict[str, Any]) -> list[Path]:
    recording = Path(str(job["recording_path"]))
    if not recording.is_file():
        final_video = Path(str(job.get("video_path", "")))
        if final_video.is_file():
            recording = final_video
        else:
            raise MeetingMinutesError(f"Recording is missing: {recording}")

    work = WORK_DIR / str(job["job_id"])
    chunks = work / "chunks"
    marker = work / "chunks.complete"
    for abandoned in work.glob("chunks.*.tmp"):
        shutil.rmtree(abandoned, ignore_errors=True)
    existing = sorted(chunks.glob("*.flac"))
    if marker.is_file() and existing:
        return existing

    staging = work / f"chunks.{uuid.uuid4().hex}.tmp"
    staging.mkdir(parents=True, exist_ok=False)
    try:
        run_checked(
            [
                "ffmpeg",
                "-hide_banner",
                "-loglevel",
                "error",
                "-i",
                str(recording),
                "-map",
                "0:a:0",
                "-ac",
                "1",
                "-ar",
                "16000",
                "-c:a",
                "flac",
                "-f",
                "segment",
                "-segment_time",
                str(CHUNK_SECONDS),
                "-reset_timestamps",
                "1",
                str(staging / "chunk-%04d.flac"),
            ],
            timeout=1800,
        )
        produced = sorted(staging.glob("*.flac"))
        if not produced:
            raise MeetingMinutesError("ffmpeg did not produce any audio chunks")
        if chunks.exists():
            shutil.rmtree(chunks)
        staging.replace(chunks)
        atomic_write_text(marker, f"{len(produced)}\n")
    finally:
        if staging.exists():
            shutil.rmtree(staging)
    return sorted(chunks.glob("*.flac"))


def decode_duration(audio: Path) -> float:
    """Measure audio length by decoding; segment-muxer FLAC headers can lie."""
    result = run_checked(
        [
            "ffmpeg",
            "-hide_banner",
            "-i",
            str(audio),
            "-f",
            "null",
            "-",
        ],
        timeout=300,
    )
    match = re.findall(r"time=(\d+):(\d\d):(\d\d(?:\.\d+)?)", result.stderr or "")
    if not match:
        return 0.0
    hours, minutes, seconds = match[-1]
    return int(hours) * 3600 + int(minutes) * 60 + float(seconds)


def filter_degenerate_tail_chunks(
    job: dict[str, Any], chunks: list[Path]
) -> list[Path]:
    usable = list(chunks)
    if usable:
        chunk = usable[-1]
        duration = decode_duration(chunk)
        if duration < 1.0:
            usable.pop()
            job["skipped_transcription_chunks"] = [
                {
                    "chunk": chunk.name,
                    "duration": round(duration, 3),
                    "reason": "shorter than 1 second",
                }
            ]
            save_job(job)
            update_status(
                job,
                label=(
                    f"Skipping trailing {duration:.3f}s audio chunk {chunk.name}"
                ),
            )
    if not usable:
        raise MeetingMinutesError(
            "No audio chunks of at least 1 second were produced"
        )
    return usable


def valid_transcript_part(path: Path) -> bool:
    if not path.is_file():
        return False
    try:
        payload = read_json(path)
    except MeetingMinutesError:
        return False
    return (
        isinstance(payload.get("text"), str)
        and isinstance(payload.get("segments"), list)
        and isinstance(payload.get("duration"), (int, float))
    )


def normalize_transcript_part(path: Path, chunk: Path) -> None:
    """Add legacy response fields without rebuilding or dropping segment words."""
    payload = read_json(path)
    if isinstance(payload.get("segments"), list) and isinstance(
        payload.get("duration"), (int, float)
    ):
        return
    duration = probe_duration(chunk)
    text = str(payload.get("text") or "").strip()
    raw_segments = payload.get("segments")
    has_timestamped_segments = isinstance(raw_segments, list)
    segments = raw_segments if has_timestamped_segments else []
    if not segments and text:
        segments = [
            {
                "id": 0,
                "start": 0.0,
                "end": round(duration, 3),
                "text": text,
            }
        ]
    payload.update(
        {
            "language": str(payload.get("language") or "en"),
            "duration": round(duration, 3),
            "segments": segments,
        }
    )
    if not has_timestamped_segments:
        payload["timestamp_precision"] = "chunk"
    atomic_write_json(path, payload)


def siren_audio_endpoint(operation: str) -> str:
    transcriptions_suffix = "/v1/audio/transcriptions"
    transcriptions_url = SIREN_URL.rstrip("/")
    if not transcriptions_url.endswith(transcriptions_suffix):
        raise MeetingMinutesError(
            "MEETING_MINUTES_SIREN_URL must end in "
            f"{transcriptions_suffix} to derive the {operation} endpoint"
        )
    base_url = transcriptions_url[: -len(transcriptions_suffix)]
    return f"{base_url}/v1/audio/{operation}"


def valid_diarization(payload: dict[str, Any]) -> bool:
    speakers = payload.get("speakers")
    turns = payload.get("turns")
    if (
        not isinstance(payload.get("duration"), (int, float))
        or not isinstance(payload.get("model"), str)
        or not isinstance(speakers, list)
        or not all(isinstance(speaker, str) for speaker in speakers)
        or not isinstance(turns, list)
    ):
        return False
    if not turns:
        return False
    return all(
        isinstance(turn, dict)
        and isinstance(turn.get("start"), (int, float))
        and isinstance(turn.get("end"), (int, float))
        and isinstance(turn.get("speaker"), str)
        for turn in turns
    )


def valid_diarization_file(path: Path) -> bool:
    if not path.is_file():
        return False
    try:
        return valid_diarization(read_json(path))
    except MeetingMinutesError:
        return False


def prepare_diarization_audio(job: dict[str, Any]) -> Path:
    recording = Path(str(job["recording_path"]))
    if not recording.is_file():
        final_video = Path(str(job.get("video_path", "")))
        if final_video.is_file():
            recording = final_video
        else:
            raise MeetingMinutesError(f"Recording is missing: {recording}")

    work = WORK_DIR / str(job["job_id"])
    destination = work / "diarization.flac"
    if destination.is_file():
        try:
            if destination.stat().st_size > 0 and probe_duration(destination) > 0:
                return destination
        except (MeetingMinutesError, OSError):
            pass
        destination.unlink(missing_ok=True)

    work.mkdir(parents=True, exist_ok=True)
    temporary = destination.with_name(
        f".{destination.stem}.{uuid.uuid4().hex}.tmp.flac"
    )
    try:
        run_checked(
            [
                "ffmpeg",
                "-hide_banner",
                "-loglevel",
                "error",
                "-i",
                str(recording),
                "-map",
                "0:a:0",
                "-ac",
                "1",
                "-ar",
                "16000",
                "-c:a",
                "flac",
                str(temporary),
            ],
            timeout=1800,
        )
        if temporary.stat().st_size <= 0 or probe_duration(temporary) <= 0:
            raise MeetingMinutesError(
                "ffmpeg produced an invalid whole-recording FLAC"
            )
        temporary.replace(destination)
    finally:
        temporary.unlink(missing_ok=True)
    return destination


def diarize_recording(job: dict[str, Any]) -> dict[str, Any]:
    work = WORK_DIR / str(job["job_id"])
    destination = work / "diarization.json"
    if valid_diarization_file(destination):
        return read_json(destination)
    destination.unlink(missing_ok=True)

    audio = prepare_diarization_audio(job)
    endpoint = siren_audio_endpoint("diarize")
    temporary = destination.with_name(f".{destination.name}.{uuid.uuid4().hex}.tmp")
    script = (
        "curl --fail-with-body --silent --show-error "
        '--max-time 1800 --output "$2" '
        '-H "Authorization: Bearer ${SIREN_API_KEY}" '
        '-F "file=@$1" "$3"'
    )
    try:
        run_checked(
            [
                "direnv",
                "exec",
                str(DOTFILES_ROOT),
                "bash",
                "-lc",
                script,
                "meeting-minutes-siren-diarize",
                str(audio),
                str(temporary),
                endpoint,
            ],
            timeout=1900,
        )
        payload = read_json(temporary)
        if not valid_diarization(payload):
            raise MeetingMinutesError("Siren returned invalid diarization JSON")
        temporary.replace(destination)
        return payload
    finally:
        temporary.unlink(missing_ok=True)


def transcribe_chunk(chunk: Path, destination: Path) -> None:
    destination.parent.mkdir(parents=True, exist_ok=True)
    temporary = destination.with_name(f".{destination.name}.{uuid.uuid4().hex}.tmp")
    script = (
        "curl --fail-with-body --silent --show-error --retry 2 "
        '--retry-delay 2 --max-time 900 --output "$2" '
        '-H "Authorization: Bearer ${SIREN_API_KEY}" '
        '-F "file=@$1" -F "model=$4" -F "response_format=verbose_json" '
        '-F "timestamp_granularities[]=word" "$3"'
    )
    try:
        run_checked(
            [
                "direnv",
                "exec",
                str(DOTFILES_ROOT),
                "bash",
                "-lc",
                script,
                "meeting-minutes-siren",
                str(chunk),
                str(temporary),
                SIREN_URL,
                SIREN_MODEL,
            ],
            timeout=1000,
        )
        normalize_transcript_part(temporary, chunk)
        if not valid_transcript_part(temporary):
            raise MeetingMinutesError(
                f"Siren returned invalid verbose JSON for {chunk.name}"
            )
        temporary.replace(destination)
    finally:
        temporary.unlink(missing_ok=True)


def collect_transcript_words(job: dict[str, Any], chunks: int) -> list[dict[str, Any]]:
    parts_dir = WORK_DIR / str(job["job_id"]) / "transcript-parts"
    words: list[dict[str, Any]] = []
    for index in range(chunks):
        part = read_json(parts_dir / f"{index:04d}.json")
        offset = index * CHUNK_SECONDS
        for raw_segment in part.get("segments", []):
            if not isinstance(raw_segment, dict):
                continue
            raw_words = raw_segment.get("words")
            if not isinstance(raw_words, list):
                continue
            for raw_word in raw_words:
                if not isinstance(raw_word, dict):
                    continue
                word = str(raw_word.get("word") or "")
                if not word.strip():
                    continue
                try:
                    start = float(raw_word["start"]) + offset
                    end = float(raw_word["end"]) + offset
                except (KeyError, TypeError, ValueError) as error:
                    raise MeetingMinutesError(
                        "Siren returned a word with invalid timestamps"
                    ) from error
                words.append(
                    {
                        "start": round(start, 3),
                        "end": round(end, 3),
                        "word": word,
                    }
                )
    if not words:
        raise MeetingMinutesError(
            "Transcription parts did not contain word timestamps"
        )
    return words


def valid_alignment(payload: dict[str, Any]) -> bool:
    speakers = payload.get("speakers")
    segments = payload.get("segments")
    if (
        not isinstance(speakers, list)
        or not all(isinstance(speaker, str) for speaker in speakers)
        or not isinstance(segments, list)
        or not segments
    ):
        return False
    return all(
        isinstance(segment, dict)
        and isinstance(segment.get("id"), int)
        and isinstance(segment.get("start"), (int, float))
        and isinstance(segment.get("end"), (int, float))
        and isinstance(segment.get("speaker"), str)
        and isinstance(segment.get("text"), str)
        for segment in segments
    )


def valid_alignment_file(path: Path) -> bool:
    if not path.is_file():
        return False
    try:
        return valid_alignment(read_json(path))
    except MeetingMinutesError:
        return False


def align_transcript(
    job: dict[str, Any],
    transcript_path: Path,
    diarization: dict[str, Any],
) -> Path:
    work = WORK_DIR / str(job["job_id"])
    alignment_path = work / "alignment.json"
    if valid_alignment_file(alignment_path):
        alignment = read_json(alignment_path)
    else:
        alignment_path.unlink(missing_ok=True)
        transcript = read_json(transcript_path)
        chunks = int(transcript.get("chunks") or 0)
        request_path = work / "alignment-request.json"
        atomic_write_json(
            request_path,
            {
                "words": collect_transcript_words(job, chunks),
                "turns": diarization["turns"],
            },
        )
        endpoint = siren_audio_endpoint("align")
        temporary = alignment_path.with_name(
            f".{alignment_path.name}.{uuid.uuid4().hex}.tmp"
        )
        script = (
            "curl --fail-with-body --silent --show-error --retry 2 "
            '--retry-delay 2 --max-time 1800 --output "$2" '
            '-H "Authorization: Bearer ${SIREN_API_KEY}" '
            '-H "Content-Type: application/json" '
            '--data-binary "@$1" "$3"'
        )
        try:
            run_checked(
                [
                    "direnv",
                    "exec",
                    str(DOTFILES_ROOT),
                    "bash",
                    "-lc",
                    script,
                    "meeting-minutes-siren-align",
                    str(request_path),
                    str(temporary),
                    endpoint,
                ],
                timeout=1900,
            )
            alignment = read_json(temporary)
            if not valid_alignment(alignment):
                raise MeetingMinutesError("Siren returned invalid alignment JSON")
            temporary.replace(alignment_path)
        finally:
            temporary.unlink(missing_ok=True)

    transcript = read_json(transcript_path)
    transcript["speakers"] = alignment["speakers"]
    transcript["segments"] = [
        {
            "id": segment["id"],
            "start": segment["start"],
            "end": segment["end"],
            "speaker": segment["speaker"],
            "text": segment["text"],
        }
        for segment in alignment["segments"]
    ]
    atomic_write_json(transcript_path, transcript)
    return transcript_path


def transcribe_chunks(job: dict[str, Any], chunks: list[Path]) -> Path:
    work = WORK_DIR / str(job["job_id"])
    parts_dir = work / "transcript-parts"
    parts_dir.mkdir(parents=True, exist_ok=True)
    total = len(chunks)
    for index, chunk in enumerate(chunks):
        part = parts_dir / f"{index:04d}.json"
        if not valid_transcript_part(part):
            set_phase(
                job,
                "transcribing",
                f"Transcribing {index + 1}/{total}",
                progress=index,
                total=total,
            )
            transcribe_chunk(chunk, part)
        update_status(
            job,
            label=f"Transcribing {index + 1}/{total}",
            progress=index + 1,
            total=total,
        )

    segments: list[dict[str, Any]] = []
    texts: list[str] = []
    language = "en"
    segment_id = 0
    for index in range(total):
        part = read_json(parts_dir / f"{index:04d}.json")
        language = str(part.get("language") or language)
        text = str(part.get("text") or "").strip()
        if text:
            texts.append(text)
        offset = index * CHUNK_SECONDS
        for raw_segment in part.get("segments", []):
            if not isinstance(raw_segment, dict):
                continue
            segment_text = str(raw_segment.get("text") or "").strip()
            if not segment_text:
                continue
            segments.append(
                {
                    "id": segment_id,
                    "start": round(float(raw_segment.get("start", 0.0)) + offset, 3),
                    "end": round(float(raw_segment.get("end", 0.0)) + offset, 3),
                    "text": segment_text,
                }
            )
            segment_id += 1

    recording = Path(str(job["recording_path"]))
    duration = float(job.get("recording_duration_seconds") or 0)
    if duration <= 0:
        duration = probe_duration(recording)
        job["recording_duration_seconds"] = round(duration, 3)
        save_job(job)
    transcript = {
        "version": 1,
        "job_id": job["job_id"],
        "recording_identity": job["recording_identity"],
        "recording_started_at": datetime.fromtimestamp(
            float(job["recording_started_at"])
        )
        .astimezone()
        .isoformat(),
        "model": SIREN_MODEL,
        "language": language,
        "duration": round(duration, 3),
        "chunk_seconds": CHUNK_SECONDS,
        "chunks": total,
        "text": " ".join(texts),
        "segments": segments,
    }
    transcript_path = work / "transcript.json"
    atomic_write_json(transcript_path, transcript)
    job["transcript_work_path"] = str(transcript_path)
    save_job(job)
    return transcript_path


def read_optional(path: Path) -> str:
    try:
        return path.read_text()
    except OSError:
        return ""


def validate_calendar_output(payload: dict[str, Any]) -> dict[str, Any]:
    status = str(payload.get("status") or "").strip().lower()
    if status not in {"available", "unavailable"}:
        raise MeetingMinutesError(f"Calendar agent returned invalid status: {status}")
    raw_candidates = payload.get("candidates")
    if not isinstance(raw_candidates, list):
        raise MeetingMinutesError("Calendar agent returned invalid candidates")
    candidates = []
    for raw in raw_candidates:
        if not isinstance(raw, dict):
            continue
        title = " ".join(str(raw.get("title") or "").split())
        if not title:
            continue
        attendees = raw.get("attendees")
        candidates.append(
            {
                "title": title,
                "start": str(raw.get("start") or ""),
                "end": str(raw.get("end") or ""),
                "attendees": [
                    " ".join(str(name).split())
                    for name in attendees
                    if str(name).strip()
                ]
                if isinstance(attendees, list)
                else [],
                "calendar": " ".join(str(raw.get("calendar") or "").split()),
            }
        )
    return {"status": status, "candidates": candidates}


def calendar_prompt(job: dict[str, Any]) -> str:
    start = datetime.fromtimestamp(float(job["recording_started_at"])).astimezone()
    duration = max(float(job.get("recording_duration_seconds") or 0), 60.0)
    end = start + timedelta(seconds=duration)
    return f"""Use the executor-access-google skill to read Google Calendar and return only the JSON object required by the supplied schema. Do not use Gmail, Slack, or any mutation.

Find every calendar event overlapping this America/New_York interval (inclusive start, exclusive end):
- start: {start.isoformat()}
- end: {end.isoformat()}

Follow the skill contract completely: resolve and describe calendar.calendarList.list and calendar.events.list, paginate every selected calendar and every event page, use singleEvents and startTime ordering, and report unavailable if Calendar access cannot be completed. Include timed events and relevant overlapping multi-day events. For each candidate return its title, start, end, non-declined attendee names, and calendar — the human-readable summary/name of the calendar the event came from (not its id), or an empty string if unavailable. Return status available even when there are zero candidates.
"""


def run_codex_agent(
    *,
    prompt: str,
    schema_path: Path,
    output_path: Path,
    log_prefix: Path,
    executor_enabled: bool,
) -> subprocess.CompletedProcess[str]:
    command = [
        "codex",
        "exec",
        "--skip-git-repo-check",
        "--json",
        "--model",
        CODEX_MODEL,
        "--config",
        f'model_reasoning_effort="{CODEX_REASONING_EFFORT}"',
        "--config",
        f'service_tier="{CODEX_SERVICE_TIER}"',
        "--sandbox",
        "read-only",
    ]
    for server in ("deepwiki", "node_repl"):
        command.extend(["--config", f"mcp_servers.{server}.enabled=false"])
    if executor_enabled:
        for tool in ("skills", "execute", "resume"):
            command.extend(
                [
                    "--config",
                    f'mcp_servers.executor.tools.{tool}.approval_mode="approve"',
                ]
            )
    else:
        command.extend(["--config", "mcp_servers.executor.enabled=false"])
    command.extend(
        [
            "--cd",
            str(VAULT_ROOT),
            "--output-schema",
            str(schema_path),
            "--output-last-message",
            str(output_path),
            "-",
        ]
    )
    result = subprocess.run(
        command,
        input=prompt,
        check=False,
        capture_output=True,
        text=True,
        timeout=1800,
    )
    atomic_write_text(log_prefix.with_suffix(".stdout.log"), result.stdout)
    atomic_write_text(log_prefix.with_suffix(".stderr.log"), result.stderr)
    return result


def codex_thread_id(stdout: str) -> str | None:
    for line in stdout.splitlines():
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        if event.get("type") == "thread.started":
            thread_id = str(event.get("thread_id") or "").strip()
            if thread_id:
                return thread_id
    return None


def resume_codex_agent(
    *,
    session_id: str,
    prompt: str,
    images: list[Path],
    schema_path: Path,
    output_path: Path,
    log_prefix: Path,
) -> subprocess.CompletedProcess[str]:
    command = [
        "codex",
        "exec",
        "resume",
        "--skip-git-repo-check",
        "--json",
        "--model",
        CODEX_MODEL,
        "--config",
        f'model_reasoning_effort="{CODEX_REASONING_EFFORT}"',
        "--config",
        f'service_tier="{CODEX_SERVICE_TIER}"',
    ]
    for server in ("deepwiki", "node_repl", "executor"):
        command.extend(["--config", f"mcp_servers.{server}.enabled=false"])
    for image in images:
        command.extend(["--image", str(image)])
    command.extend(
        [
            "--output-schema",
            str(schema_path),
            "--output-last-message",
            str(output_path),
            session_id,
            "-",
        ]
    )
    result = subprocess.run(
        command,
        input=prompt,
        check=False,
        capture_output=True,
        text=True,
        timeout=1800,
    )
    atomic_write_text(log_prefix.with_suffix(".stdout.log"), result.stdout)
    atomic_write_text(log_prefix.with_suffix(".stderr.log"), result.stderr)
    return result


def lookup_calendar(job: dict[str, Any], work: Path) -> dict[str, Any]:
    schema_path = work / "calendar-schema.json"
    output_path = work / "calendar.json"
    atomic_write_json(schema_path, CALENDAR_SCHEMA)
    if output_path.is_file():
        try:
            return validate_calendar_output(read_json(output_path))
        except MeetingMinutesError:
            output_path.unlink(missing_ok=True)

    try:
        result = run_codex_agent(
            prompt=calendar_prompt(job),
            schema_path=schema_path,
            output_path=output_path,
            log_prefix=work / "calendar-codex",
            executor_enabled=True,
        )
        if result.returncode != 0:
            return {"status": "unavailable", "candidates": []}
        output = validate_calendar_output(read_json(output_path))
        atomic_write_json(output_path, output)
        return output
    except (MeetingMinutesError, OSError, subprocess.SubprocessError):
        return {"status": "unavailable", "candidates": []}


def people_registry_path(context: str) -> Path:
    return VAULT_ROOT / f"04-projects/{context}/people.md"


def all_people_rosters() -> str:
    """Every project's people.md, so attendee spellings resolve regardless of context."""
    sections: list[str] = []
    for context in PROJECT_CONTEXTS:
        text = read_optional(people_registry_path(context)).strip()
        if text:
            sections.append(f"### {context}\n{text}")
    return "\n\n".join(sections) or "(no rosters on file)"


def speaker_tagged_segments(
    transcript: dict[str, Any],
) -> list[dict[str, Any]] | None:
    segments = transcript.get("segments")
    if not isinstance(segments, list) or not segments:
        return None
    if not all(
        isinstance(segment, dict)
        and isinstance(segment.get("speaker"), str)
        and segment["speaker"].strip()
        for segment in segments
    ):
        return None
    return segments


def render_transcript_for_prompt(transcript: dict[str, Any]) -> str:
    segments = speaker_tagged_segments(transcript)
    if segments is None:
        return json.dumps(transcript, ensure_ascii=False)

    turns: list[tuple[str, float, list[str]]] = []
    for segment in segments:
        speaker = str(segment["speaker"]).strip()
        text = str(segment.get("text") or "").strip()
        if not text:
            continue
        start = float(segment.get("start") or 0.0)
        if turns and turns[-1][0] == speaker:
            turns[-1][2].append(text)
        else:
            turns.append((speaker, start, [text]))

    def timestamp(seconds: float) -> str:
        minutes, secs = divmod(int(seconds), 60)
        hours, minutes = divmod(minutes, 60)
        if hours:
            return f"{hours}:{minutes:02d}:{secs:02d}"
        return f"{minutes}:{secs:02d}"
    return "\n".join(
        f"[{timestamp(start)}] {speaker}: {' '.join(texts)}"
        for speaker, start, texts in turns
    )


def codex_prompt(transcript: dict[str, Any], calendar: dict[str, Any]) -> str:
    manifest = read_optional(VAULT_ROOT / "04-projects/manifest.md")
    people = all_people_rosters()
    rendered_transcript = render_transcript_for_prompt(transcript)
    if speaker_tagged_segments(transcript) is not None:
        transcript_heading = (
            "The transcript below is speaker-labeled with anonymous "
            "SPEAKER_NN labels from audio diarization. Map each label to an "
            "attendee name wherever the content and turn-taking make the "
            "identity unambiguous (self-introductions, being addressed by "
            "name, who owns which work); otherwise keep the raw label. Use "
            "the mapping to sharpen attribution of decisions, findings, and "
            "follow-up ownership - it does not need to appear as per-line "
            "bylines in the note. Diarization can split one person across "
            "two labels or briefly mislabel cross-talk, so weigh content "
            "over labels when they conflict.\n\nSpeaker-tagged transcript:"
        )
    else:
        transcript_heading = "Timestamped transcript JSON:"
    return f"""You are the Meeting Minutes Agent. Convert the supplied timestamped transcript into concise structured meeting minutes for Tony's Coppermind vault.

Tony (Tony Kabilan Okeke) is the vault owner and is a participant in these meetings, never a third party to describe.

Return only the JSON object required by the supplied schema. Use a short human title and a filesystem-safe semantic slug without a date or context prefix.

Write a `summary`: a tight two-to-three-sentence abstract of what actually happened — the problem worked on, the key finding or outcome, and the immediate next step. It leads the note and is also stored in frontmatter for agents scanning at a glance, so make it self-contained and specific, name the concrete subject, and skip filler openers like "the team discussed". Keep it to a single paragraph with no line breaks.

Choose exactly one context from moberg, xploit, personal, or tooling. When a calendar candidate is matched, the name of the calendar it came from is strong evidence for the context (an event on a "Moberg" calendar is a moberg meeting); otherwise infer from attendees and transcript subject matter.

`project` is a routing key from the project manifest below, NOT a meeting title: either the bare context (`moberg`) or `<context>/<subproject>` where the subproject comes from the manifest's tag taxonomy (for example `moberg/eboost`, `moberg/regulatory`, `moberg/qeeg`). Choose the most specific subproject the transcript supports, and fall back to the bare context when no subproject clearly applies. The descriptive name of the meeting belongs in `title`. List only attendees supported by the transcript or by a confidently matched calendar event; exclude declined invitees. Notes should capture material technical or operational context, and decisions only explicit conclusions.

Preserve concrete specifics verbatim instead of paraphrasing them away: exact file names and paths, function/class/variable names, line numbers, error messages, config keys, flag names, numeric thresholds, versions, and other identifiers. These are precisely the details that cannot be reconstructed later, so favor keeping one precise term over a smoother sentence. When a specific was clearly spoken but garbled by transcription (for example "region 550" for "line 550", or a mangled symbol name), preserve it and mark it approximate rather than dropping it. Do not invent identifiers that were not stated. Do not include Markdown bullet prefixes in array items.

Each follow_up needs an owner and a concrete action. Set owner to "Tony" only when Tony himself committed to the action or it is unambiguously his to do; use the responsible person's name when someone else owns it; use "team" when a group owns it and no individual was named. Do not attribute an action to Tony merely because it was discussed in his presence or because no owner was stated — an unowned item is "team". Record only actions someone actually committed to, not every idea raised.

Use the timestamped transcript to identify optional screenshot candidates. The bar is information that is durable and hard to recover from prose alone: on-screen code, a stack trace or error dialog, an architecture drawing or diagram, a configuration, or a shared document whose specific content — not merely its existence — matters. Screen-sharing by itself is never a reason to capture; a screenshot earns its place only when the visible artifact carries specifics the notes cannot fully state. Many meetings warrant zero screenshots, and returning none is the correct and common answer — strongly preferred over filling the limit. This is a judgment call about information value, not a per-meeting expectation to satisfy.

Set visual_mode to none when no screenshot would materially improve the note, ordinary for a typical meeting, or visual_review when the meeting substantially works through code, architecture, diagrams, implementation details, errors, or changing UI states over an extended stretch. Candidate timestamps must point to moments when the speakers are discussing visible content — especially deictic moments ("right here", "this line", "that function", "this is where it breaks") where the durable detail lives on the screen rather than in the words, since those are exactly the specifics the audio transcript loses. Reject talking heads, generic screen-sharing with no specific artifact, and visuals that would merely repeat the prose. Order candidates from most to least valuable. Return at most 3 candidates for an ordinary meeting and at most 8 for a visual_review. Every candidate — including the first — must capture a technical artifact or state that is materially distinct from every other candidate. Several views of the same document, spreadsheet, dashboard, or screen are ONE candidate, not several: pick the single most informative moment. Prefer returning fewer candidates over filling the limit. note_index is the zero-based index of the note bullet the image would support. A later visual pass will inspect the actual frames, transcribe the durable on-screen specifics into the caption, and may reject every candidate.

Calendar candidates were gathered separately without exposing the transcript to tools. Use a candidate only when its timing, title, or attendees plausibly fit the transcript.

Set calendar_status to unavailable when candidate retrieval was unavailable, matched when one candidate fits, or no_match otherwise. Set calendar_event to the matched title or an empty string. Calendar may inform the title, context, project, and attendee spellings, but transcript evidence remains authoritative for substantive notes.

Project manifest (the source of valid `project` routing keys):
{manifest}

Known people (by project; use for attendee name spellings):
{people}

Calendar candidate JSON:
{json.dumps(calendar, ensure_ascii=False)}

{transcript_heading}
{rendered_transcript}
"""


def normalize_project(raw: Any, context: str) -> str:
    """`project` is a routing key (`moberg` or `moberg/eboost`), never a title.
    Anything off-taxonomy degrades to the bare context rather than corrupting routing."""
    value = " ".join(str(raw or "").split()).strip().lower()
    if not value:
        return context
    head, separator, tail = value.partition("/")
    if head != context:
        return context
    if not separator:
        return context
    subproject = re.sub(r"[^a-z0-9]+", "-", tail).strip("-")
    return f"{context}/{subproject}" if subproject else context


def validate_agent_output(payload: dict[str, Any]) -> dict[str, Any]:
    context = str(payload.get("context") or "").strip().lower()
    if context not in PROJECT_CONTEXTS:
        raise MeetingMinutesError(f"Meeting agent returned invalid context: {context}")
    title = " ".join(str(payload.get("title") or "").split())
    if not title:
        raise MeetingMinutesError("Meeting agent returned an empty title")
    summary = " ".join(str(payload.get("summary") or "").split())
    calendar_status = str(payload.get("calendar_status") or "").strip().lower()
    if calendar_status not in {"matched", "no_match", "unavailable"}:
        raise MeetingMinutesError(
            f"Meeting agent returned invalid calendar status: {calendar_status}"
        )

    def strings(name: str) -> list[str]:
        value = payload.get(name)
        if not isinstance(value, list):
            raise MeetingMinutesError(f"Meeting agent returned invalid {name}")
        return [" ".join(str(item).split()) for item in value if str(item).strip()]

    notes = strings("notes")

    raw_follow_ups = payload.get("follow_ups")
    if not isinstance(raw_follow_ups, list):
        raise MeetingMinutesError("Meeting agent returned invalid follow_ups")
    follow_ups: list[dict[str, str]] = []
    for raw in raw_follow_ups:
        if not isinstance(raw, dict):
            continue
        action = " ".join(str(raw.get("action") or "").split())
        owner = " ".join(str(raw.get("owner") or "").split())
        if action:
            follow_ups.append({"owner": owner or "team", "action": action})

    visual_mode = str(payload.get("visual_mode") or "").strip().lower()
    if visual_mode not in {"none", "ordinary", "visual_review"}:
        raise MeetingMinutesError(
            f"Meeting agent returned invalid visual mode: {visual_mode}"
        )
    raw_candidates = payload.get("visual_candidates")
    if not isinstance(raw_candidates, list):
        raise MeetingMinutesError("Meeting agent returned invalid visual candidates")
    limit = (
        VISUAL_REVIEW_SCREENSHOT_LIMIT
        if visual_mode == "visual_review"
        else ORDINARY_SCREENSHOT_LIMIT
    )
    candidates: list[dict[str, Any]] = []
    for raw in raw_candidates[:limit]:
        if not isinstance(raw, dict):
            continue
        try:
            timestamp = float(raw.get("timestamp_seconds"))
            note_index = int(raw.get("note_index"))
        except (TypeError, ValueError):
            continue
        reason = " ".join(str(raw.get("reason") or "").split())
        if timestamp < 0 or note_index < 0 or note_index >= len(notes) or not reason:
            continue
        candidates.append(
            {
                "timestamp_seconds": round(timestamp, 3),
                "note_index": note_index,
                "reason": reason,
            }
        )
    if visual_mode == "none":
        candidates = []

    return {
        "title": title,
        "summary": summary,
        "slug": slugify(str(payload.get("slug") or title)),
        "context": context,
        "project": normalize_project(payload.get("project"), context),
        "attendees": strings("attendees"),
        "notes": notes,
        "decisions": strings("decisions"),
        "follow_ups": follow_ups,
        "calendar_status": calendar_status,
        "calendar_event": " ".join(str(payload.get("calendar_event") or "").split()),
        "visual_mode": visual_mode,
        "visual_candidates": candidates,
    }


def generate_minutes(job: dict[str, Any], transcript_path: Path) -> dict[str, Any]:
    work = WORK_DIR / str(job["job_id"])
    schema_path = work / "minutes-schema.json"
    output_path = work / "minutes.json"
    atomic_write_json(schema_path, OUTPUT_SCHEMA)
    if output_path.is_file():
        try:
            output = validate_agent_output(read_json(output_path))
            if job.get("codex_session"):
                return output
        except MeetingMinutesError:
            pass
        output_path.unlink(missing_ok=True)

    set_phase(job, "generating", "Generating meeting note")
    transcript = read_json(transcript_path)
    calendar = lookup_calendar(job, work)
    result = run_codex_agent(
        prompt=codex_prompt(transcript, calendar),
        schema_path=schema_path,
        output_path=output_path,
        log_prefix=work / "minutes-codex",
        executor_enabled=False,
    )
    if result.returncode != 0:
        detail = (result.stderr or result.stdout).strip()[-4000:]
        raise MeetingMinutesError(
            f"Codex minutes generation failed (exit {result.returncode}): {detail}"
        )
    thread_id = codex_thread_id(result.stdout)
    if not thread_id:
        raise MeetingMinutesError("Codex minutes generation returned no thread id")
    job["codex_session"] = f"jacurutu:{thread_id}"
    save_job(job)
    output = validate_agent_output(read_json(output_path))
    atomic_write_json(output_path, output)
    return output


def extract_screenshot_frames(
    job: dict[str, Any], candidates: list[dict[str, Any]]
) -> list[dict[str, Any]]:
    recording = Path(str(job["recording_path"]))
    if not recording.is_file():
        raise MeetingMinutesError(f"Recording is missing: {recording}")
    duration = float(job.get("recording_duration_seconds") or 0)
    if duration <= 0:
        duration = probe_duration(recording)
    frame_dir = WORK_DIR / str(job["job_id"]) / "screenshot-frames"
    frame_dir.mkdir(parents=True, exist_ok=True)
    extracted: list[dict[str, Any]] = []
    for candidate_index, candidate in enumerate(candidates):
        frames: list[dict[str, Any]] = []
        seen_timestamps: set[float] = set()
        for offset in SCREENSHOT_OFFSETS_SECONDS:
            timestamp = min(
                max(float(candidate["timestamp_seconds"]) + offset, 0.0),
                max(duration - 0.05, 0.0),
            )
            timestamp = round(timestamp, 3)
            if timestamp in seen_timestamps:
                continue
            seen_timestamps.add(timestamp)
            frame_index = len(frames)
            path = frame_dir / (
                f"candidate-{candidate_index:02d}-frame-{frame_index}-{timestamp:.3f}.png"
            )
            if not path.is_file() or path.stat().st_size == 0:
                temporary = path.with_name(f".{path.stem}.{uuid.uuid4().hex}.tmp.png")
                try:
                    run_checked(
                        [
                            "ffmpeg",
                            "-hide_banner",
                            "-loglevel",
                            "error",
                            "-y",
                            "-ss",
                            f"{timestamp:.3f}",
                            "-i",
                            str(recording),
                            "-frames:v",
                            "1",
                            "-vf",
                            "scale=1920:-2:force_original_aspect_ratio=decrease",
                            "-compression_level",
                            "3",
                            str(temporary),
                        ],
                        timeout=180,
                    )
                    temporary.replace(path)
                finally:
                    temporary.unlink(missing_ok=True)
            frames.append({"path": path, "timestamp_seconds": timestamp})
        extracted.append({**candidate, "frames": frames})
    return extracted


def screenshot_review_prompt(
    minutes: dict[str, Any], candidates: list[dict[str, Any]]
) -> str:
    candidate_summary = []
    for index, candidate in enumerate(candidates):
        candidate_summary.append(
            {
                "candidate_index": index,
                "note_index": candidate["note_index"],
                "note": minutes["notes"][candidate["note_index"]],
                "reason": candidate["reason"],
                "frames": [
                    {
                        "frame_index": frame_index,
                        "filename": frame["path"].name,
                        "timestamp_seconds": frame["timestamp_seconds"],
                    }
                    for frame_index, frame in enumerate(candidate["frames"])
                ],
            }
        )
    limit = (
        VISUAL_REVIEW_SCREENSHOT_LIMIT
        if minutes["visual_mode"] == "visual_review"
        else ORDINARY_SCREENSHOT_LIMIT
    )
    return f"""Continue reviewing the same meeting. The attached images are transcript-guided frame candidates from the recording. Return only the JSON object required by the supplied schema.

Select at most one frame for a candidate, and reject the candidate by omitting it when the frames do not materially improve the associated note. Keep only legible code, architecture, diagrams, errors, meaningful UI states, or other distinct technical artifacts. Reject talking heads, blank or transitional screens, generic application chrome, duplicated content, and visuals whose useful information is already fully conveyed by the note. Prefer the clearest, most complete frame.

Captions must be short and factual and must never claim details that are not visible. When the chosen frame shows code, an error, a stack trace, or a configuration/document, transcribe the durable specifics into the caption verbatim — file paths, function/class/variable names, line numbers, exact error text, and key values — because those exact tokens are the reason the screenshot is worth keeping. Keep the caption terse, but do not paraphrase a precise identifier into a vaguer word (write the actual `path/to/file.py:550` or symbol name, not "the reload function"). Transcribe only what is legibly on screen; never guess at text you cannot read.

This meeting is classified as {minutes["visual_mode"]}. Select no more than {limit} screenshots. Every selection — including the first — must show a technical artifact or state that is materially distinct from every other selection: if two candidates show the same document, spreadsheet, dashboard, or screen (even scrolled to different rows, or at different moments), keep only the single most informative one and reject the rest. It is valid and preferred to return an empty selection when none are useful; never fill the limit for its own sake.

Candidate and attachment mapping:
{json.dumps(candidate_summary, ensure_ascii=False, indent=2)}
"""


def validate_screenshot_review(
    payload: dict[str, Any], candidates: list[dict[str, Any]], limit: int
) -> list[dict[str, Any]]:
    raw_selections = payload.get("selections")
    if not isinstance(raw_selections, list):
        raise MeetingMinutesError("Screenshot reviewer returned invalid selections")
    selections: list[dict[str, Any]] = []
    seen_candidates: set[int] = set()
    for raw in raw_selections:
        if not isinstance(raw, dict):
            continue
        try:
            candidate_index = int(raw.get("candidate_index"))
            frame_index = int(raw.get("frame_index"))
        except (TypeError, ValueError):
            continue
        caption = " ".join(str(raw.get("caption") or "").split())
        if (
            candidate_index in seen_candidates
            or candidate_index < 0
            or candidate_index >= len(candidates)
            or frame_index < 0
            or frame_index >= len(candidates[candidate_index]["frames"])
            or not caption
        ):
            continue
        seen_candidates.add(candidate_index)
        candidate = candidates[candidate_index]
        frame = candidate["frames"][frame_index]
        selections.append(
            {
                "candidate_index": candidate_index,
                "frame_index": frame_index,
                "note_index": candidate["note_index"],
                "timestamp_seconds": frame["timestamp_seconds"],
                "caption": caption,
                "source_path": str(frame["path"]),
            }
        )
        if len(selections) == limit:
            break
    return selections


def enrich_screenshots(
    job: dict[str, Any], minutes: dict[str, Any]
) -> list[dict[str, Any]]:
    candidates = minutes["visual_candidates"]
    if not candidates:
        job["screenshot_enrichment"] = {
            "status": "not_applicable",
            "visual_mode": minutes["visual_mode"],
            "candidates": 0,
            "selected": 0,
        }
        save_job(job)
        return []

    set_phase(job, "enriching", "Selecting meeting screenshots")
    try:
        work = WORK_DIR / str(job["job_id"])
        schema_path = work / "screenshot-review-schema.json"
        output_path = work / "screenshot-review.json"
        atomic_write_json(schema_path, SCREENSHOT_REVIEW_SCHEMA)
        extracted = extract_screenshot_frames(job, candidates)
        limit = (
            VISUAL_REVIEW_SCREENSHOT_LIMIT
            if minutes["visual_mode"] == "visual_review"
            else ORDINARY_SCREENSHOT_LIMIT
        )
        if output_path.is_file():
            selections = validate_screenshot_review(
                read_json(output_path), extracted, limit
            )
        else:
            qualified_session = str(job.get("codex_session") or "")
            machine, separator, session_id = qualified_session.partition(":")
            if machine != "jacurutu" or not separator or not session_id:
                raise MeetingMinutesError(
                    f"Invalid Codex session reference: {qualified_session}"
                )
            images = [
                frame["path"]
                for candidate in extracted
                for frame in candidate["frames"]
            ]
            result = resume_codex_agent(
                session_id=session_id,
                prompt=screenshot_review_prompt(minutes, extracted),
                images=images,
                schema_path=schema_path,
                output_path=output_path,
                log_prefix=work / "screenshot-codex",
            )
            if result.returncode != 0:
                detail = (result.stderr or result.stdout).strip()[-4000:]
                raise MeetingMinutesError(
                    f"Codex screenshot review failed (exit {result.returncode}): {detail}"
                )
            selections = validate_screenshot_review(
                read_json(output_path), extracted, limit
            )
        job["screenshot_enrichment"] = {
            "status": "completed",
            "visual_mode": minutes["visual_mode"],
            "candidates": len(candidates),
            "selected": len(selections),
        }
        save_job(job)
        return selections
    except (MeetingMinutesError, OSError, subprocess.SubprocessError) as error:
        job["screenshot_enrichment"] = {
            "status": "failed",
            "visual_mode": minutes["visual_mode"],
            "candidates": len(candidates),
            "selected": 0,
            "error": str(error)[:2000],
        }
        save_job(job)
        return []


def slugify(value: str) -> str:
    value = value.lower().strip()
    value = re.sub(r"[^a-z0-9]+", "-", value)
    return value.strip("-")[:72] or "meeting"


def yaml_scalar(value: str) -> str:
    return json.dumps(value, ensure_ascii=False)


def known_people() -> set[str]:
    """Names on ANY project roster — known anywhere means never re-proposed."""
    names: set[str] = set()
    for context in PROJECT_CONTEXTS:
        text = read_optional(people_registry_path(context))
        for match in re.finditer(r"^- \*\*(.+?)\*\*", text, flags=re.MULTILINE):
            for name in match.group(1).split("/"):
                names.add(name.strip().casefold())
    return names


def propose_unknown_people(job: dict[str, Any], minutes: dict[str, Any]) -> None:
    context = str(minutes["context"])
    # A roster file is the opt-in signal that Tony tracks people for this project.
    # Without one, stay silent instead of proposing every attendee.
    if not people_registry_path(context).is_file():
        return
    attendees = [str(name) for name in minutes["attendees"]]
    known = known_people()
    target = f"04-projects/{context}/people.md"
    proposals = VAULT_ROOT / "04-projects/_pipeline/proposals"
    for attendee in attendees:
        if attendee.casefold() in VAULT_OWNER_ALIASES or attendee.casefold() in known:
            continue
        path = proposals / f"meeting-person-{minutes['context']}-{slugify(attendee)}.md"
        if path.exists():
            continue
        content = (
            "---\n"
            "type: people-addition\n"
            f"target: {yaml_scalar(target)}\n"
            f"meeting_job: {yaml_scalar(str(job['job_id']))}\n"
            "status: proposed\n"
            "---\n"
            f"# Proposed person: {attendee}\n\n"
            f"Identified as an attendee in [[meetings/{job['canonical_stem']}|{minutes['title']}]]. "
            "Role and relationship need Tony's confirmation.\n"
        )
        atomic_write_text(path, content)


def publish_screenshots(
    job: dict[str, Any], stem: str, screenshots: list[dict[str, Any]]
) -> list[dict[str, Any]]:
    published: list[dict[str, Any]] = []
    publication_errors: list[str] = []
    try:
        ASSETS_DIR.mkdir(parents=True, exist_ok=True)
    except OSError as error:
        publication_errors.append(str(error))
        screenshots = []
    for index, screenshot in enumerate(screenshots, start=1):
        source = Path(str(screenshot["source_path"]))
        if not source.is_file():
            publication_errors.append(f"Selected frame is missing: {source}")
            continue
        asset_name = f"{stem}-{index:02d}.png"
        destination = ASSETS_DIR / asset_name
        try:
            if not destination.is_file():
                temporary = destination.with_name(
                    f".{destination.name}.{uuid.uuid4().hex}.tmp"
                )
                try:
                    shutil.copy2(source, temporary)
                    temporary.replace(destination)
                finally:
                    temporary.unlink(missing_ok=True)
        except OSError as error:
            publication_errors.append(f"{asset_name}: {error}")
            continue
        published.append(
            {
                "asset_name": asset_name,
                "asset_path": str(destination),
                "note_index": screenshot["note_index"],
                "timestamp_seconds": screenshot["timestamp_seconds"],
                "caption": screenshot["caption"],
            }
        )
    job["screenshots"] = published
    enrichment = job.get("screenshot_enrichment")
    if isinstance(enrichment, dict):
        enrichment["published"] = len(published)
        if publication_errors:
            enrichment["publication_errors"] = publication_errors
    save_job(job)
    return published


def format_timestamp(seconds: float) -> str:
    total = max(int(round(seconds)), 0)
    hours, remainder = divmod(total, 3600)
    minutes, seconds = divmod(remainder, 60)
    return f"{hours:02d}:{minutes:02d}:{seconds:02d}"


def render_note(
    job: dict[str, Any],
    minutes: dict[str, Any],
    video_path: Path,
    screenshots: list[dict[str, Any]],
) -> str:
    attendees = minutes["attendees"]
    attendee_yaml = "attendees: []\n"
    if attendees:
        attendee_yaml = "attendees:\n" + "".join(
            f"  - {yaml_scalar(str(attendee))}\n" for attendee in attendees
        )

    def bullets(items: list[str]) -> str:
        if not items:
            return "- None\n"
        return "".join(f"- {item}\n" for item in items)

    def follow_up_bullets(items: list[dict[str, str]]) -> str:
        """Only Tony's own follow-ups become checkboxes; the rest are recorded
        as plain bullets so they stay out of his task queries."""
        if not items:
            return "- None\n"
        rendered: list[str] = []
        for item in items:
            owner = item["owner"]
            if owner.casefold() in VAULT_OWNER_ALIASES:
                rendered.append(f"- [ ] {item['action']}\n")
            else:
                rendered.append(f"- **{owner}** — {item['action']}\n")
        return "".join(rendered)

    def note_bullets(items: list[str]) -> str:
        if not items:
            return "- None\n"
        by_note: dict[int, list[dict[str, Any]]] = {}
        for screenshot in screenshots:
            by_note.setdefault(int(screenshot["note_index"]), []).append(screenshot)
        rendered: list[str] = []
        for note_index, item in enumerate(items):
            rendered.append(f"- {item}\n")
            for screenshot in by_note.get(note_index, []):
                timestamp = format_timestamp(float(screenshot["timestamp_seconds"]))
                rendered.append(
                    f"\n  ![[{screenshot['asset_name']}]]\n"
                    f"  _{screenshot['caption']} ({timestamp})_\n"
                )
        return "".join(rendered)

    meeting_date = datetime.fromtimestamp(float(job["recording_started_at"])).date()
    summary = str(minutes["summary"])
    summary_block = f"## summary\n\n{summary}\n\n" if summary else ""
    return (
        "---\n"
        f"date: {meeting_date.isoformat()}\n"
        f"project: {yaml_scalar(str(minutes['project']))}\n"
        f"{attendee_yaml}"
        f"summary: {yaml_scalar(summary)}\n"
        "source: pipeline\n"
        f"recording: {yaml_scalar(str(video_path))}\n"
        f"pipeline_job: {yaml_scalar(str(job['job_id']))}\n"
        f"recording_identity: {yaml_scalar(str(job['recording_identity']))}\n"
        f"codex_session: {yaml_scalar(str(job['codex_session']))}\n"
        "---\n"
        f"# {minutes['title']}\n\n"
        f"{summary_block}"
        "## notes\n\n"
        f"{note_bullets(minutes['notes'])}\n"
        "## decisions\n\n"
        f"{bullets(minutes['decisions'])}\n"
        "## follow-ups\n\n"
        f"{follow_up_bullets(minutes['follow_ups'])}"
    )


def choose_canonical_stem(job: dict[str, Any], minutes: dict[str, Any]) -> str:
    existing = str(job.get("canonical_stem") or "")
    if existing:
        return existing
    meeting_date = datetime.fromtimestamp(float(job["recording_started_at"])).date()
    base = f"{meeting_date.isoformat()}-{minutes['context']}-{minutes['slug']}"
    candidate = base
    note_dir = VAULT_ROOT / "01-logs/meetings"
    for index in range(1000):
        note_path = note_dir / f"{candidate}.md"
        video_path = MEDIA_ROOT / f"{candidate}.mp4"
        asset_exists = any(ASSETS_DIR.glob(f"{candidate}-*.png"))
        if not note_path.exists() and not video_path.exists() and not asset_exists:
            break
        if note_path.exists() and f'pipeline_job: "{job["job_id"]}"' in read_optional(
            note_path
        ):
            break
        candidate = (
            f"{base}-{str(job['job_id'])[:8]}" if index == 0 else f"{base}-{index + 1}"
        )
    else:
        raise MeetingMinutesError("Could not choose an unused canonical meeting stem")
    job["canonical_stem"] = candidate
    save_job(job)
    return candidate


def append_weekly_backlink(job: dict[str, Any], minutes: dict[str, Any]) -> None:
    meeting_time = datetime.fromtimestamp(float(job["recording_started_at"]))
    iso_year, iso_week, _ = meeting_time.isocalendar()
    weekly_path = VAULT_ROOT / "01-logs" / f"{iso_year}-w{iso_week:02d}.md"
    if not weekly_path.is_file():
        raise MeetingMinutesError(f"Weekly log does not exist: {weekly_path}")
    text = weekly_path.read_text()
    link = f"[[meetings/{job['canonical_stem']}|{minutes['title']}]]"
    if link in text:
        return
    heading = meeting_time.strftime("### %a, %b %-d")
    match = re.search(rf"^{re.escape(heading)}\s*$", text, flags=re.MULTILINE)
    if match is None:
        raise MeetingMinutesError(f"Daily log heading is missing: {heading}")
    next_heading = re.search(r"^### ", text[match.end() :], flags=re.MULTILINE)
    insert_at = match.end() + (
        next_heading.start() if next_heading else len(text[match.end() :])
    )
    before = text[:insert_at].rstrip()
    after = text[insert_at:].lstrip("\n")
    updated = f"{before}\n\n- Meeting notes: {link}\n"
    if after:
        updated += f"\n{after}"
    atomic_write_text(weekly_path, updated)


def finalize_artifacts(
    job: dict[str, Any],
    minutes: dict[str, Any],
    transcript_path: Path,
    screenshots: list[dict[str, Any]],
) -> None:
    set_phase(job, "writing", "Writing meeting note")
    stem = choose_canonical_stem(job, minutes)
    note_path = VAULT_ROOT / "01-logs/meetings" / f"{stem}.md"
    video_path = MEDIA_ROOT / f"{stem}.mp4"
    final_transcript = MEDIA_ROOT / f"{stem}.json"
    published_screenshots = publish_screenshots(job, stem, screenshots)

    current_video = Path(str(job.get("recording_path", "")))
    if not video_path.is_file():
        if not current_video.is_file():
            raise MeetingMinutesError(f"Recording is missing: {current_video}")
        current_video.replace(video_path)
    job["recording_path"] = str(video_path)
    job["video_path"] = str(video_path)
    save_job(job)

    if not final_transcript.is_file():
        temporary = final_transcript.with_name(
            f".{final_transcript.name}.{uuid.uuid4().hex}.tmp"
        )
        try:
            shutil.copy2(transcript_path, temporary)
            temporary.replace(final_transcript)
        finally:
            temporary.unlink(missing_ok=True)

    atomic_write_text(
        note_path, render_note(job, minutes, video_path, published_screenshots)
    )
    job["note_path"] = str(note_path)
    job["transcript_path"] = str(final_transcript)
    save_job(job)
    propose_unknown_people(job, minutes)
    append_weekly_backlink(job, minutes)


def notify_job(job: dict[str, Any], *, success: bool) -> None:
    if job.get("notification_attempted"):
        return
    job["notification_attempted"] = True
    save_job(job)
    if success:
        title = "Meeting minutes ready"
        severity = "success"
        body = f"{job.get('title', 'Meeting')} — {job.get('note_path', '')}"
    else:
        title = "Meeting minutes failed"
        severity = "error"
        body = str(job.get("error") or "Unknown meeting pipeline error")[:1000]
    try:
        result = subprocess.run(
            [
                "discord-notify",
                "-t",
                title,
                "-s",
                severity,
                "--body",
                body,
            ],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
        )
        job["notification_sent"] = result.returncode == 0
        if result.returncode != 0:
            job["notification_error"] = result.stderr.strip()[-1000:]
    except OSError as error:
        job["notification_sent"] = False
        job["notification_error"] = str(error)
    save_job(job)


def process_job(job: dict[str, Any]) -> None:
    with job_lock_path(str(job["job_id"])).open("a+") as job_lock:
        fcntl.flock(job_lock.fileno(), fcntl.LOCK_EX)
        job = read_json(job_path(str(job["job_id"])))
        if job.get("phase") in {"completed", "error"}:
            return
        try:
            recover_staged_recording(job)
            set_phase(job, "preparing", "Preparing meeting audio")
            chunks = prepare_chunks(job)
            chunks = filter_degenerate_tail_chunks(job, chunks)
            diarization: dict[str, Any] | None = None
            if DIARIZATION_ENABLED:
                set_phase(job, "diarizing", "Identifying meeting speakers")
                try:
                    diarization = diarize_recording(job)
                    job["diarization"] = {
                        "status": "ready",
                        "speakers": diarization["speakers"],
                    }
                    save_job(job)
                except (
                    MeetingMinutesError,
                    OSError,
                    subprocess.SubprocessError,
                ) as error:
                    job["diarization"] = {
                        "status": "failed",
                        "stage": "diarize",
                        "error": str(error)[-2000:],
                    }
                    save_job(job)
                    update_status(
                        job,
                        label="Speaker diarization unavailable; continuing",
                    )
            else:
                job["diarization"] = {
                    "status": "disabled",
                    "reason": "MEETING_MINUTES_DIARIZE=0",
                }
                save_job(job)
            transcript_path = transcribe_chunks(job, chunks)
            if diarization is not None:
                set_phase(job, "aligning", "Aligning transcript speakers")
                try:
                    transcript_path = align_transcript(
                        job,
                        transcript_path,
                        diarization,
                    )
                    job["diarization"] = {
                        "status": "completed",
                        "speakers": read_json(transcript_path)["speakers"],
                    }
                    save_job(job)
                except (
                    MeetingMinutesError,
                    OSError,
                    subprocess.SubprocessError,
                ) as error:
                    job["diarization"] = {
                        "status": "failed",
                        "stage": "align",
                        "error": str(error)[-2000:],
                    }
                    save_job(job)
                    update_status(
                        job,
                        label="Speaker alignment unavailable; continuing",
                    )
            minutes = generate_minutes(job, transcript_path)
            job["title"] = minutes["title"]
            job["calendar_enrichment"] = {
                "status": minutes["calendar_status"],
                "event": minutes["calendar_event"],
                "mode": "executor-agent-best-effort",
            }
            save_job(job)
            screenshots = enrich_screenshots(job, minutes)
            finalize_artifacts(job, minutes, transcript_path, screenshots)
            job["phase"] = "completed"
            job["completed_at"] = now_epoch()
            save_job(job)
            update_status(job, label="Meeting note ready")
            notify_job(job, success=True)
            shutil.rmtree(WORK_DIR / str(job["job_id"]), ignore_errors=True)
        except (
            MeetingMinutesError,
            OSError,
            subprocess.SubprocessError,
        ) as error:
            job["phase"] = "error"
            job["error"] = str(error)
            save_job(job)
            update_status(job, label="Meeting failed")
            notify_job(job, success=False)


def work_queue() -> int:
    ensure_directories()
    with LOCK_PATH.open("a+") as lock:
        try:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 0
        while True:
            pending = []
            for path in sorted(JOBS_DIR.glob("*.json")):
                try:
                    job = read_json(path)
                except MeetingMinutesError:
                    continue
                if job.get("phase") not in {"completed", "error"}:
                    pending.append(job)
            if not pending:
                break
            for job in sorted(
                pending, key=lambda item: float(item.get("created_at", 0))
            ):
                process_job(job)
    return 0


def retry_job(job_id: str) -> dict[str, Any]:
    job = read_json(job_path(job_id))
    if job.get("phase") != "error":
        raise MeetingMinutesError("Only failed jobs can be retried")
    job["phase"] = "queued"
    job["error"] = ""
    job["notification_attempted"] = False
    job.pop("notification_sent", None)
    job.pop("notification_error", None)
    save_job(job)
    update_status(job, label="Minutes queued")
    kick_worker()
    return job


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(prog="meeting-minutes")
    commands = root.add_subparsers(dest="command", required=True)
    enqueue = commands.add_parser("enqueue")
    enqueue.add_argument("--recording", required=True)
    enqueue.add_argument("--started-at", type=float)
    enqueue.add_argument("--duration-seconds", type=int, default=0)
    commands.add_parser("work")
    retry = commands.add_parser("retry")
    retry.add_argument("job_id")
    commands.add_parser("status")
    return root


def main() -> int:
    args = parser().parse_args()
    try:
        if args.command == "enqueue":
            print(json.dumps(enqueue_recording(args), separators=(",", ":")))
        elif args.command == "work":
            return work_queue()
        elif args.command == "retry":
            print(json.dumps(retry_job(args.job_id), separators=(",", ":")))
        elif args.command == "status":
            print(
                STATUS_PATH.read_text().strip()
                if STATUS_PATH.is_file()
                else '{"phase":"idle"}'
            )
    except (MeetingMinutesError, OSError, subprocess.SubprocessError) as error:
        print(json.dumps({"phase": "error", "error": str(error)}), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
