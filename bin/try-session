#!/usr/bin/env bash

LOG_FILE=/dev/null
log() { echo "[$(date '+%H:%M:%S')] $*" >> "$LOG_FILE"; }

log "=== try-session started ==="
log "args: $*"

config="${XDG_CONFIG_HOME:-$HOME/.config}/try-session.env"
# shellcheck source=/dev/null
if ! . "$config" || [[ -z "${TRY_BIN:-}" || -z "${TRY_PATH:-}" ]]; then
  echo "try-session: $config must set TRY_BIN and TRY_PATH" >&2
  exit 1
fi

try_bin=$TRY_BIN
try_path="${TRY_PATH/#\~/$HOME}"

log "try_bin: $try_bin"
log "try_path: $try_path"

log "Calling: $try_bin exec --path $try_path $*"
output=$("$try_bin" exec --path "$try_path" "$@" 2>/dev/tty)
exit_code=$?
log "exit_code: $exit_code"
log "output: $output"

if (( exit_code != 0 )) || [[ -z "$output" ]]; then
  log "No selection returned"
  exit 0
fi

eval "$output" 2>/dev/null || exit 0
selected=$PWD
log "selected: $selected"

if [[ -z "$selected" || ! -d "$selected" ]]; then
  log "ERROR: selected is empty or not a directory"
  exit 0
fi

selected_name=$(basename "$selected" | tr . _)
log "selected_name: $selected_name"

if ! tmux has-session -t="$selected_name" 2>/dev/null; then
  log "Creating new session: $selected_name in $selected"
  tmux new-session -ds "$selected_name" -c "$selected"
else
  log "Session already exists: $selected_name"
fi

if [[ -z $TMUX ]]; then
  log "Attaching to session (not in tmux)"
  tmux attach-session -t "$selected_name"
else
  log "Switching client to session"
  tmux switch-client -t "$selected_name"
fi

log "=== try-session finished ==="
