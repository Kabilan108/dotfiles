#!/usr/bin/env bash

set -euo pipefail

direction=${1:-}
pane_id=${HERDR_ACTIVE_PANE_ID:-${HERDR_PANE_ID:-}}

case "$direction" in
  left) key=h ;;
  down) key=j ;;
  up) key=k ;;
  right) key=l ;;
  *)
    echo "usage: herdr-navigate {left|down|up|right}" >&2
    exit 2
    ;;
esac

if [[ -z "$pane_id" ]]; then
  echo "herdr-navigate: no active Herdr pane" >&2
  exit 1
fi

# Herdr's process-info schema includes the foreground process and its command.
# Inspect all string fields so this remains compatible with minor schema changes.
if herdr pane process-info --pane "$pane_id" \
  | jq -e '.. | strings | select(test("(^|/)(n?vim|vimdiff)([[:space:]]|$)"; "i"))' \
    >/dev/null; then
  herdr pane send-keys "$pane_id" "ctrl+$key"
else
  herdr pane focus --pane "$pane_id" --direction "$direction"
fi
