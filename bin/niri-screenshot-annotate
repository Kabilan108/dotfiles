#!/usr/bin/env bash
set -euo pipefail

screenshot_dir="$HOME/media/screenshots"
mkdir -p "$screenshot_dir"

send_notification() {
  env -u LD_LIBRARY_PATH -u APPDIR -u APPIMAGE notify-send "$@"
}

latest_screenshot() {
  find "$screenshot_dir" -maxdepth 1 -type f -name '*.png' -printf '%T@ %p\n' \
    | sort -nr \
    | head -n 1 \
    | cut -d' ' -f2-
}

latest_screenshot_after() {
  local marker="$1"

  find "$screenshot_dir" -maxdepth 1 -type f -name '*.png' -newer "$marker" -printf '%T@ %p\n' \
    | sort -nr \
    | head -n 1 \
    | cut -d' ' -f2-
}

annotate_file() {
  local input="$1"
  local base="${input%.png}"
  local output="$base.annotated.png"

  exec satty \
    --filename "$input" \
    --output-filename "$output" \
    --copy-command wl-copy \
    --actions-on-enter save-to-file \
    --actions-on-enter save-to-clipboard \
    --actions-on-right-click save-to-clipboard \
    --actions-on-escape exit \
    --early-exit \
    --resize smart \
    --floating-hack \
    --initial-tool arrow
}

if [[ "${1:-}" == "latest" ]]; then
  latest="$(latest_screenshot)"
  if [[ -z "$latest" ]]; then
    send_notification "Screenshot annotation" "No screenshots found in $screenshot_dir"
    exit 1
  fi
  annotate_file "$latest"
fi

marker="$(mktemp --tmpdir niri-screenshot-annotate.XXXXXX)"
touch "$marker"
trap 'rm -f "$marker"' EXIT

niri msg action screenshot

for _ in {1..600}; do
  latest="$(latest_screenshot_after "$marker")"
  if [[ -n "$latest" ]]; then
    annotate_file "$latest"
  fi
  sleep 0.1
done

send_notification "Screenshot annotation" "Timed out waiting for a new screenshot"
exit 1
