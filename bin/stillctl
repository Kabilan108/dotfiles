#!/usr/bin/env bash
set -euo pipefail

config="${STILLSUIT_CONFIG:-stillsuit}"

usage() {
  cat <<USAGE
Usage: stillctl <command> [args]

Commands:
  start                 Start qs -c ${config} in the background
  stop                  Stop the running ${config} shell
  reload                Restart the ${config} shell
  status                Print ${config} shell state as JSON
  instances             List running Quickshell instances
  logs [lines]          Print recent ${config} logs
  logs -f               Follow ${config} logs
  ipc <target> <method> [args...]
  panel <name> [toggle|open|close]
  bar [on|off|toggle]
  dnd [on|off|toggle]   Read or change notification DND state
  notifications         Toggle notification center
  gallery [open|close]  Toggle or set the Stillsuit dev gallery
USAGE
}

require_args() {
  local expected="$1"
  local actual="$2"
  if (( actual < expected )); then
    usage
    exit 2
  fi
}

start_shell() {
  qs -c "$config" --no-duplicate --daemonize
}

stop_shell() {
  qs kill -c "$config" --any-display >/dev/null 2>&1 || true
}

case "${1:-}" in
start)
  start_shell
  ;;
stop)
  stop_shell
  ;;
reload | restart)
  stop_shell
  sleep 0.2
  start_shell
  ;;
status)
  exec qs -c "$config" ipc call shell status
  ;;
instances)
  qs list --all
  ;;
logs)
  case "${2:-}" in
  -f | --follow)
    exec qs log -c "$config" --follow
    ;;
  "")
    exec qs log -c "$config" --tail 120
    ;;
  *)
    exec qs log -c "$config" --tail "$2"
    ;;
  esac
  ;;
ipc)
  shift
  require_args 2 "$#"
  exec qs -c "$config" ipc call "$@"
  ;;
panel)
  require_args 2 "$#"
  panel="${2:-}"
  action="${3:-toggle}"
  case "$action" in
  open | close | toggle | on | off)
    exec qs -c "$config" ipc call shell panel "$panel" "$action"
    ;;
  *)
    usage
    exit 2
    ;;
  esac
  ;;
bar)
  exec qs -c "$config" ipc call shell bar "${2:-toggle}"
  ;;
dnd)
  case "${2:-}" in
  "")
    exec qs -c "$config" ipc call notifications dndState
    ;;
  toggle)
    exec qs -c "$config" ipc call notifications toggleDnd
    ;;
  on | off)
    exec qs -c "$config" ipc call notifications setDnd "$2"
    ;;
  *)
    usage
    exit 2
    ;;
  esac
  ;;
notifications)
  exec qs -c "$config" ipc call shell panel notifications toggle
  ;;
gallery)
  case "${2:-toggle}" in
  open)
    exec qs -c "$config" ipc call gallery open
    ;;
  close)
    exec qs -c "$config" ipc call gallery close
    ;;
  toggle)
    exec qs -c "$config" ipc call gallery toggle
    ;;
  *)
    usage
    exit 2
    ;;
  esac
  ;;
"" | -h | --help | help)
  usage
  ;;
*)
  usage
  exit 2
  ;;
esac
