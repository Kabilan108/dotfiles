#!/usr/bin/env bash
# vim: syn=bash ft=bash

set -euo pipefail

usage() {
    cat <<EOF
Usage: crawl [OPTIONS] URL [URL ...]

Fetches webpage contents using the Exa Contents API.

Required:
  URL                One or more URLs to crawl. Each must be a valid http(s) URL.

Options:
  --json, -j         Output full JSON response from the API (default: print only the extracted context text).
  --help, -h         Show this help message and exit.

Environment:
  EXA_API_KEY        Your Exa API key must be set in the environment.

Examples:
  # Fetch context text from a single URL
  crawl https://tesla.com

  # Fetch context text from multiple URLs
  crawl https://tesla.com https://openai.com

  # Output full JSON for a single URL
  crawl --json https://tesla.com

  # Show this help message
  crawl --help
EOF
}

if [ -z "$EXA_API_KEY" ]; then
    echo "Error: EXA_API_KEY environment variable is not set" >&2
    exit 1
fi

json_output=0
urls=""

while [ $# -gt 0 ]; do
    case "$1" in
        --json|-j)
            json_output=1
            shift
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        -*)
            echo "Error: Unknown option $1" >&2
            usage
            exit 1
            ;;
        *)
            if [ -z "$urls" ]; then
                urls="\"$1\""
            else
                urls="$urls, \"$1\""
            fi
            shift
            ;;
    esac
done

if [ -z "$urls" ]; then
    usage >&2
    exit 2
fi

json_data="{
    \"text\": true,
    \"ids\": [$urls],
    \"context\": true
}"

if [ "$json_output" = "1" ]; then
    if ! curl -s -X POST https://api.exa.ai/contents \
        --header "content-type: application/json" \
        --header "x-api-key: $EXA_API_KEY" \
        --data "$json_data"; then
        echo "Error: Failed to fetch data from API" >&2
        exit 1
    fi
else
    if ! curl -s -X POST https://api.exa.ai/contents \
        --header "content-type: application/json" \
        --header "x-api-key: $EXA_API_KEY" \
        --data "$json_data" | jq -r '.context'; then
        echo "Error: Failed to fetch data from API" >&2
        exit 1
    fi
fi
