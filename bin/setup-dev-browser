#!/usr/bin/env bash
# vim: syn=bash ft=bash
set -euo pipefail

REPO_URL="git@github.com:kabilan108/dev-browser.git"
REPO_DIR="$HOME/repos/dev-browser"
SKILL_DIR="$REPO_DIR/skills/dev-browser"
LINK_PATH="$HOME/dotfiles/agents/skills/dev-browser"

# symlink exists and points to a valid target
if [[ -L "$LINK_PATH" && -d "$LINK_PATH" ]]; then
  echo "already set up: $LINK_PATH -> $(readlink "$LINK_PATH")"
  exit 0
fi

# stale symlink
if [[ -L "$LINK_PATH" ]]; then
  echo "removing broken symlink: $LINK_PATH"
  rm "$LINK_PATH"
fi

# clone if needed
if [[ ! -d "$REPO_DIR" ]]; then
  echo "cloning $REPO_URL -> $REPO_DIR"
  mkdir -p "$(dirname "$REPO_DIR")"
  git clone "$REPO_URL" "$REPO_DIR"
fi

if [[ ! -d "$SKILL_DIR" ]]; then
  echo "error: skill dir not found: $SKILL_DIR" >&2
  exit 1
fi

ln -s "$SKILL_DIR" "$LINK_PATH"
echo "linked: $LINK_PATH -> $SKILL_DIR"
