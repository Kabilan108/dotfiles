#!/usr/bin/env bash
# vim: syn=bash ft=bash

usage() {
  echo "Usage: $(basename $0) [mute|mute-mic|[+-]<1-99>]"
  echo "  mute: Toggle mute for the default sink"
  echo "  mute-mic: Toggle mute for the default source"
  echo "  [+-]<1-99>: Increase or decrease volume by 1-99%"
  exit 1
}

if [ $# -ne 1 ]; then
  usage
fi

case "$1" in
mute)
  pactl set-sink-mute @DEFAULT_SINK@ toggle
  ;;
mute-mic)
  pactl set-source-mute @DEFAULT_SOURCE@ toggle
  ;;
[+-][1-9] | [+-][1-9][0-9])
  delta="${1%%%}"
  current="$(
    pactl get-sink-volume @DEFAULT_SINK@ \
      | awk 'NR==1 { for (i = 1; i <= NF; i++) if ($i ~ /%/) { gsub("%", "", $i); print $i; exit } }'
  )"
  current="${current:-0}"

  if [[ "$delta" == +* ]]; then
    target=$((current + ${delta#+}))
  else
    target=$((current - ${delta#-}))
  fi

  if (( target < 0 )); then
    target=0
  elif (( target > 100 )); then
    target=100
  fi

  pactl set-sink-volume @DEFAULT_SINK@ "${target}%"
  ;;
*)
  usage
  ;;
esac
