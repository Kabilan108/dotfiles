#!/usr/bin/env python3
"""Exercise the installed headless browser without shared profiles or accounts."""

import argparse
import json
import os
import shutil
import subprocess
import tempfile
import uuid
from pathlib import Path


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--output', type=Path, help='New directory for evidence; defaults to /tmp')
    args = parser.parse_args()
    for command in ('agent-browser', 'ffmpeg', 'ffprobe'):
        if shutil.which(command) is None:
            parser.error(f'{command} is not on PATH')

    if args.output:
        output = args.output.resolve()
        output.mkdir(parents=True, exist_ok=False)
    else:
        output = Path(tempfile.mkdtemp(prefix='agent-browser-smoke-'))
    print(f'Evidence: {output}', flush=True)
    config = output / 'config.json'
    config.write_text('{}\n')
    fixture = output / 'fixture.html'
    fixture.write_text('''<!doctype html><meta charset="utf-8">
<title>Browser smoke test</title>
<style>body{font:24px sans-serif;margin:64px}input,button{font:inherit;padding:12px}
output{display:block;margin-top:24px}</style>
<h1>Browser smoke test</h1><label>Name <input id="name"></label>
<button onclick="document.querySelector('output').textContent='Saved: '+document.querySelector('input').value">Save</button>
<output>Waiting</output>''')

    # Retain only the configured executable from browser-specific environment.
    # Never inherit auto-connect, auth restoration, or a shared profile.
    env = {
        key: value for key, value in os.environ.items()
        if not key.startswith('AGENT_BROWSER_')
        and key not in ('DISPLAY', 'WAYLAND_DISPLAY')
    }
    executable = os.environ.get('AGENT_BROWSER_EXECUTABLE_PATH')
    if executable:
        env['AGENT_BROWSER_EXECUTABLE_PATH'] = executable
    namespace = f'smoke-{uuid.uuid4().hex[:12]}'
    log = output / 'commands.jsonl'

    def run(command: list[str]) -> str:
        result = subprocess.run(
            command, env=env, capture_output=True, text=True, timeout=60, check=False,
        )
        with log.open('a') as handle:
            handle.write(json.dumps({
                'command': command, 'exit': result.returncode,
                'stdout': result.stdout, 'stderr': result.stderr,
            }) + '\n')
        if result.returncode:
            raise RuntimeError(f'{command[0]} failed: {result.stderr or result.stdout}')
        return result.stdout

    def browser(session: str, *arguments: str) -> dict:
        raw = run([
            'agent-browser', '--namespace', namespace, '--session', session,
            '--config', str(config), '--json', *arguments,
        ])
        result = json.loads(raw)
        if not result.get('success'):
            raise RuntimeError(f'Browser command failed: {result}')
        return result['data']

    def evaluate(session: str, expression: str) -> object:
        return browser(session, 'eval', expression)['result']

    cleanup_errors: list[str] = []
    try:
        version = run(['agent-browser', '--version']).strip()
        browser('first', 'open', fixture.as_uri())
        snapshot = browser('first', 'snapshot', '-i')
        if 'Save' not in snapshot['snapshot']:
            raise RuntimeError('Fixture button missing from snapshot')
        browser('first', 'fill', '#name', 'Smoke test')
        browser('first', 'click', 'button')
        if evaluate('first', 'document.querySelector("output").textContent') != 'Saved: Smoke test':
            raise RuntimeError('Form interaction did not produce the expected result')
        screenshot = output / 'result.png'
        browser('first', 'screenshot', str(screenshot))
        if not screenshot.read_bytes().startswith(b'\x89PNG\r\n\x1a\n'):
            raise RuntimeError('Screenshot is not a PNG')
        evaluate('first', 'localStorage.setItem("smoke-marker", "first")')
        browser('second', 'open', fixture.as_uri())
        if evaluate('second', 'localStorage.getItem("smoke-marker")') is not None:
            raise RuntimeError('Session storage leaked into another browser')
        if evaluate('first', 'localStorage.getItem("smoke-marker")') != 'first':
            raise RuntimeError('First session lost its state')

        video = output / 'interaction.webm'
        browser('first', 'record', 'start', str(video), fixture.as_uri(), '--cursor', '--contact-sheet')
        browser('first', 'fill', '#name', 'Recorded test')
        browser('first', 'click', 'button')
        browser('first', 'wait', '--text', 'Saved: Recorded test')
        browser('first', 'wait', '1000')
        browser('first', 'record', 'stop')
        probe = json.loads(run([
            'ffprobe', '-v', 'error', '-count_frames', '-show_entries',
            'stream=codec_name,width,height,nb_read_frames:format=duration,size',
            '-of', 'json', str(video),
        ]))
        if float(probe['format']['duration']) <= 0 or not any(
            int(stream.get('nb_read_frames', '0')) > 1 for stream in probe['streams']
        ):
            raise RuntimeError('Recording has no usable frames or duration')
        run(['ffmpeg', '-v', 'error', '-i', str(video), '-f', 'null', '-'])
        run(['ffmpeg', '-v', 'error', '-y', '-sseof', '-0.1', '-i', str(video),
             '-frames:v', '1', str(output / 'video-end.png')])
        report = {'version': version, 'executable': executable, 'video': probe}
        (output / 'result.json').write_text(json.dumps(report, indent=2) + '\n')
    finally:
        for session in ('first', 'second'):
            try:
                browser(session, 'close')
            except (RuntimeError, subprocess.TimeoutExpired) as error:
                cleanup_errors.append(f'{session}: {error}')
        if cleanup_errors:
            raise RuntimeError('Session cleanup failed: ' + '; '.join(cleanup_errors))
    print('PASS: headless interaction, screenshot, storage isolation, video decode, session close.')
    print('Review result.png and video-end.png for visual acceptance.')


if __name__ == '__main__':
    main()
