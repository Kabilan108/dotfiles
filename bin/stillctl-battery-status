#!/usr/bin/env bash
set -euo pipefail

shell_output=false

case "${1:-}" in
  "")
    ;;
  --shell)
    shell_output=true
    ;;
  *)
    echo "Usage: stillctl-battery-status [--shell]" >&2
    exit 2
    ;;
esac

emit_sysfs() {
  local battery_dir="$1"
  local percentage state charge_full charge_now current_now voltage_now rate capacity time_remaining cycles threshold_start threshold_end threshold_label

  percentage="$(cat "$battery_dir/capacity" 2>/dev/null || true)"
  state="$(cat "$battery_dir/status" 2>/dev/null | tr '[:upper:]' '[:lower:]' || true)"
  charge_full="$(cat "$battery_dir/charge_full" 2>/dev/null || true)"
  charge_now="$(cat "$battery_dir/charge_now" 2>/dev/null || true)"
  current_now="$(cat "$battery_dir/current_now" 2>/dev/null || true)"
  voltage_now="$(cat "$battery_dir/voltage_now" 2>/dev/null || true)"
  cycles="$(cat "$battery_dir/cycle_count" 2>/dev/null || true)"
  threshold_start="$(cat "$battery_dir/charge_control_start_threshold" 2>/dev/null || true)"
  threshold_end="$(cat "$battery_dir/charge_control_end_threshold" 2>/dev/null || true)"

  if [[ -n "${charge_full:-}" && -n "${voltage_now:-}" ]]; then
    capacity="$(awk -v charge="$charge_full" -v voltage="$voltage_now" 'BEGIN { printf "%.0f", (charge * voltage) / 1000000000000 }')"
  fi

  if [[ -n "${current_now:-}" && -n "${voltage_now:-}" ]]; then
    rate="$(awk -v current="$current_now" -v voltage="$voltage_now" 'BEGIN { rounded = sprintf("%.1f", (current * voltage) / 1000000000000); sub(/\.0$/, "", rounded); print rounded }')"
  fi

  if [[ -n "${charge_full:-}" && -n "${charge_now:-}" && -n "${current_now:-}" && "$current_now" != "0" ]]; then
    if [[ "$state" == "charging" ]]; then
      time_remaining="$(awk -v full="$charge_full" -v now="$charge_now" -v current="$current_now" 'BEGIN { h = (full - now) / current; if (h < 0) h = 0; printf "%dh %02dm", int(h), int((h - int(h)) * 60) }')"
    else
      time_remaining="$(awk -v now="$charge_now" -v current="$current_now" 'BEGIN { h = now / current; if (h < 0) h = 0; printf "%dh %02dm", int(h), int((h - int(h)) * 60) }')"
    fi
  fi

  if [[ -n "${threshold_end:-}" ]]; then
    if [[ -n "${threshold_start:-}" && "$threshold_start" != "$threshold_end" ]]; then
      threshold_label="${threshold_start}-${threshold_end}%"
    else
      threshold_label="${threshold_end}%"
    fi
  fi

  if [[ "$shell_output" == "true" ]]; then
    [[ -n "${percentage:-}" ]] && printf 'percentage\t%s%%\n' "$percentage"
    [[ -n "${state:-}" ]] && printf 'state\t%s\n' "$state"
    [[ -n "${rate:-}" ]] && printf 'rate\t%sW\n' "$rate"
    [[ -n "${capacity:-}" ]] && printf 'size\t%sWh\n' "$capacity"
    [[ -n "${time_remaining:-}" ]] && printf 'time\t%s\n' "$time_remaining"
    [[ -n "${cycles:-}" ]] && printf 'cycles\t%s\n' "$cycles"
    [[ -n "${threshold_label:-}" ]] && printf 'threshold\t%s\n' "$threshold_label"
    exit 0
  fi

  echo "Battery ${percentage:-?}% · ${state:-unknown} · ${rate:-?}W / ${capacity:-?}Wh"
  exit 0
}

battery="$(command -v upower >/dev/null 2>&1 && upower -e 2>/dev/null | rg 'BAT|battery' | head -n 1 || true)"
if [[ -z "$battery" ]]; then
  for candidate in /sys/class/power_supply/BAT*; do
    [[ -d "$candidate" ]] || continue
    emit_sysfs "$candidate"
  done
  exit 0
fi

battery_info="$(upower -i "$battery" 2>/dev/null || true)"
[[ -z "$battery_info" ]] && exit 0

percentage="$(awk '/percentage/ { gsub(/%/, "", $2); print int($2); exit }' <<<"$battery_info")"
state="$(awk '/state/ { print $2; exit }' <<<"$battery_info")"
rate_raw="$(awk '/energy-rate/ { print $2; exit }' <<<"$battery_info")"
rate="$(awk '/energy-rate/ { rounded = sprintf("%.1f", $2); sub(/\.0$/, "", rounded); print rounded; exit }' <<<"$battery_info")"
capacity="$(awk '/energy-full:/ { rounded = sprintf("%.0f", $2); print rounded; exit }' <<<"$battery_info")"
time_remaining="$(awk -F: '/time to empty|time to full/ { gsub(/^[ \t]+/, "", $2); print $2; exit }' <<<"$battery_info")"
threshold_start="$(awk '/charge-start-threshold:/ { gsub(/%/, "", $2); print int($2); exit }' <<<"$battery_info")"
threshold_end="$(awk '/charge-end-threshold:/ { gsub(/%/, "", $2); print int($2); exit }' <<<"$battery_info")"

[[ -z "$threshold_end" ]] && threshold_end="$(cat /sys/class/power_supply/BAT*/charge_control_end_threshold 2>/dev/null | head -1 || true)"
[[ -z "$threshold_start" ]] && threshold_start="$(cat /sys/class/power_supply/BAT*/charge_control_start_threshold 2>/dev/null | head -1 || true)"
cycles="$(cat /sys/class/power_supply/BAT*/cycle_count 2>/dev/null | head -1 || true)"

ac_online=false
for supply in /sys/class/power_supply/*; do
  [[ -r "$supply/type" ]] || continue
  [[ "$(<"$supply/type")" == "Mains" ]] || continue
  [[ -r "$supply/online" ]] || continue
  if [[ "$(<"$supply/online")" == "1" ]]; then
    ac_online=true
    break
  fi
done

charge_holding=false
if [[ "$ac_online" == "true" && -n "$threshold_end" && -n "${percentage:-}" ]]; then
  if [[ "$state" == "discharging" || "$state" == "pending-charge" ]]; then
    charge_holding=true
  elif [[ "$state" == "fully-charged" ]] && (( percentage < 99 )); then
    charge_holding=true
  elif [[ "$state" == "charging" && -n "${rate_raw:-}" ]]; then
    if awk -v rate="$rate_raw" -v pct="$percentage" -v end="$threshold_end" 'BEGIN { exit !(rate <= 0.2 && end < 99 && pct >= end) }'; then
      charge_holding=true
    fi
  fi
fi

threshold_label=""
if [[ -n "$threshold_end" ]]; then
  if [[ -n "$threshold_start" && "$threshold_start" != "$threshold_end" ]]; then
    threshold_label="${threshold_start}-${threshold_end}%"
  else
    threshold_label="${threshold_end}%"
  fi
fi

if [[ "$shell_output" == "true" ]]; then
  [[ -n "${percentage:-}" ]] && printf 'percentage\t%s%%\n' "$percentage"
  if [[ "$charge_holding" == "true" ]]; then
    printf 'state\tholding\n'
  else
    printf 'state\t%s\n' "${state:-unknown}"
  fi
  [[ -n "${rate:-}" ]] && printf 'rate\t%sW\n' "$rate"
  [[ -n "${capacity:-}" ]] && printf 'size\t%sWh\n' "$capacity"
  [[ -n "${time_remaining:-}" ]] && printf 'time\t%s\n' "$time_remaining"
  [[ -n "${cycles:-}" ]] && printf 'cycles\t%s\n' "$cycles"
  [[ -n "$threshold_label" ]] && printf 'threshold\t%s\n' "$threshold_label"
  exit 0
fi

if [[ "$charge_holding" == "true" ]]; then
  echo "Battery ${percentage:-?}% · Holding at ${threshold_label:-threshold} · ${rate:-?}W / ${capacity:-?}Wh"
elif [[ "$state" == "charging" ]]; then
  echo "Battery ${percentage:-?}% · ${time_remaining:-unknown} to full · ${rate:-?}W / ${capacity:-?}Wh"
else
  echo "Battery ${percentage:-?}% · ${time_remaining:-unknown} left · ${rate:-?}W / ${capacity:-?}Wh"
fi
