{
	"autoDocstring.docstringFormat": "numpy",
	"cursor.cpp.enablePartialAccepts": true,
	"cursor.chat.ghostTextAtSymbols": true,
	"cursor.cmdk.useThemedDiffBackground": true,
	"cursor.cmdk.ghostTextAtSymbols": true,
	"editor.bracketPairColorization.enabled": true,
	"editor.fontFamily": "'FiraMono Nerd Font Mono'",
	"editor.guides.indentation": true,
	"editor.guides.bracketPairs": true,
	"editor.indentSize": "tabSize",
	"editor.insertSpaces": true,
	"editor.minimap.enabled": true,
	"editor.rulers": [90, 100],
	"editor.tabSize": 2,
	"editor.wordWrap": "off",
	"editor.wordWrapColumn": 90,
	"explorer.confirmDelete": false,
	"explorer.confirmDragAndDrop": false,
	"files.exclude": {
		"**/__pycache__": true,
		"**/.ruff_cache": true,
		"**/.venv": true
	},
	"files.simpleDialog.enable": true,
	"files.trimFinalNewlines": true,
	"git.autofetch": true,
	"git.confirmSync": false,
	"git.enableSmartCommit": true,
	"git.openRepositoryInParentFolders": true,
	"jupyter.askForKernelRestart": false,
	"latex-workshop.latex.outDir": "%DIR%/build",
	"latex-workshop.latex.recipe.default": "latexmk (xelatex)",
	"latex-workshop.latex.recipes": [
		{
			"name": "latexmk (xelatex)",
			"tools": ["latexmk"]
		}
	],
	"latex-workshop.latex.tools": [
		{
			"name": "latexmk",
			"command": "latexmk",
			"args": [
				"-xelatex",
				"-interaction=nonstopmode",
				"-synctex=1",
				"-file-line-error",
				"-output-directory=%DIR%/build",
				"%DOC%"
			]
		}
	],
	"notebook.lineNumbers": "on",
	"terminal.external.linuxExec": "ghostty",
	"terminal.integrated.enableMultiLinePasteWarning": false,
	"terminal.integrated.fontFamily": "'FiraMono Nerd Font Mono'",
	"terminal.integrated.cursorBlinking": true,
	"terminal.integrated.scrollback": 10000,
	"vim": {
		"overrideCopy": true,
		"highlightedyank": {
			"enable": true,
			"duration": 250
		},
		"hlsearch": true,
		"incsearch": true,
		"leader": "<Space>",
		"useCtrlKeys": true,
		"useSystemClipboard": true,
		"visualstar": true,

		"insertModeKeyBindings": [],
		"visualModeKeyBindings": [],

		"normalModeKeyBindings": [
			{ "before": ["<Esc>"], "commands": [":nohl"] },
			{
				"before": ["<leader>", "s", "f"],
				"commands": ["workbench.action.quickOpen"]
			},
			{
				"before": ["<leader>", "s", "g"],
				"commands": ["workbench.action.findInFiles"]
			},
			{
				"before": ["<leader>", "b"],
				"commands": ["workbench.action.showAllEditors"]
			},
			{
				"before": ["z", "c"],
				"commands": ["editor.fold"]
			},
			{
				"before": ["z", "o"],
				"commands": ["editor.unfold"]
			},
			{
				"before": ["<C-`>"],
				"commands": ["workbench.action.terminal.openInEditor"]
			}
		],

		"normalModeKeyBindingsNonRecursive": [
			{
				"before": ["j"],
				"after": ["g", "j"]
			},
			{
				"before": ["k"],
				"after": ["g", "k"]
			}
		],

		"visualModeKeyBindingsNonRecursive": [
			{
				"before": ["j"],
				"after": ["g", "j"]
			},
			{
				"before": ["k"],
				"after": ["g", "k"]
			}
		],
	},
	"extensions.experimental.affinity": {
		"vscodevim": 1
	},
	"vsicons.dontShowNewVersionMessage": true,
	"window.commandCenter": true,
	"window.customTitleBarVisibility": "auto",
	"window.menuBarVisibility": "compact",
	"workbench.activityBar.orientation": "vertical",
	"workbench.colorTheme": "Catppuccin Mocha",
	"workbench.editor.enablePreview": false,
	"workbench.iconTheme": "vscode-icons",
	"[javascript][typescript][javascriptreact][typescriptreact]": {
		"editor.defaultFormatter": "biomejs.biome",
		"editor.formatOnSave": true,
		"updateImportsOnFileMove.enabled": "always"
	},
	"[json]": {
		"editor.wordWrap": "wordWrapColumn"
	},
	"[kotlin]": {
		"editor.tabSize": 4,
		"editor.formatOnSave": false
	},
	"[latex]": {
		"editor.wordWrap": "wordWrapColumn"
	},
	"[markdown]": {
		"editor.wordWrap": "wordWrapColumn"
	},
	"[python][yaml]": {
		"editor.tabSize": 4
	},
	"[python]": {
		"editor.defaultFormatter": "charliermarsh.ruff",
		"editor.rulers": [88],
		"updateImportsOnFileMove.enabled": "always"
	},
	"[yaml]": {
		"editor.defaultFormatter": "redhat.vscode-yaml",
		"editor.formatOnSave": true
	},
	"cSpell.userWords": [
		"Advarra",
		"autoencoder",
		"binarizing",
		"Boxplots",
		"colsample",
		"Conv",
		"convolutional",
		"creitical",
		"deepclean",
		"Drexel",
		"ensembled",
		"gini",
		"grayscale",
		"HCFE",
		"Hirsch",
		"hyperparameters",
		"interpretability",
		"Interquartile",
		"manil",
		"minkowski",
		"Moberg",
		"Moyer",
		"multicenter",
		"multimodal",
		"multiparametric",
		"Natus",
		"neurocritical",
		"neuromonitoring",
		"OHCA",
		"Okeke",
		"overfitting",
		"Palo",
		"Pereira",
		"plethysmography",
		"PRECICECAP",
		"pulseless",
		"SCAE",
		"scikit",
		"Scipy's",
		"Shrestha",
		"torchvision",
		"xgboost",
		"Zihuai"
	],
	"cSpell.language": "en",
	"cursor.aipreview.enabled": true,
	"wakatime.apiUrl": "https://wakapi.dev/api",
	"editor.lineNumbers": "relative",
	"cursor.composer.renderPillsInsteadOfBlocks": true,
	"cursor.terminal.usePreviewBox": true,
	"cursor.composer.cmdPFilePicker2": true,
	"cursor.diffs.useCharacterLevelDiffs": true,
	"cursor.composer.shouldAllowCustomModes": true,
	"cursor.cpp.disabledLanguages": ["plaintext"],
	"python.defaultInterpreterPath": "/etc/profiles/per-user/kabilan/bin/python",
	"workbench.secondarySideBar.defaultVisibility": "hidden",
	"remote.SSH.remotePlatform": {
		"devserver3": "linux",
		"sietch": "linux"
	},
	"git.blame.editorDecoration.enabled": true,
	"cursor.agent_layout_browser_beta_setting": true,
	"cursor.composer.usageSummaryDisplay": "always",
	"cursor.general.globalCursorIgnoreList": [
		"**/.env",
		"**/.env.*",
		"**/credentials.json",
		"**/credentials.*.json",
		"**/secret.json",
		"**/secrets.json",
		"**/*.key",
		"**/*.pem",
		"**/*.pfx",
		"**/*.p12",
		"**/*.crt",
		"**/*.cer",
		"**/id_rsa",
		"**/id_dsa",
		"**/.ssh/id_*",
		"**/.envrc"
	],
	"cursor.enable_git_worktrees_setting": true,
	"editor.fontSize": 12
}
