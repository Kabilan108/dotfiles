# vim: syn=bash ft=bash
# if set, this overrides the default TS_SEARCH_PATHS (~/ ~/repos ~/dotfiles)
TS_SEARCH_PATHS=(~/ ~/repos ~/gists)

# if set, this adds additional search paths to the default TS_SEARCH_PATHS
# The number prefix is the depth for the Path [OPTIONAL]
TS_EXTRA_SEARCH_PATHS=(~/work/moberg:1 ~/work/moberg/dev-server:2 /vault/notes:2 ~/repos/cli:1 ~/repos/sites:1)

# if set, this overrides the TS_MAX_DEPTH (1)
TS_MAX_DEPTH=1

# this defines the commands to run when using the -s/--session option
TS_SESSION_COMMANDS=(claude 'codex -m gpt-5 -c model_reasoning_effort=high' opencode)
