[global]
  monitor = 0
  follow = mouse
  transparency = 0
  geometry = "150x1-30+20"  # [{width}]x{n_notifications}[+/-{x}+/-{y}]
  indicate_hidden = yes  # shouw count of hidden messages
  shrink = no  # shrink window if less than width

  background = "#45475a"
  foreground = "#cdd6f4"
  frame_color = "#cba6f7"
  separator_color = "#1e1e2e"

  separator_height = 1
  frame_width = 0
  notification_height = 0

  alignment = left
  vertical_alignment = center

  corner_radius = 10
  corners = all

  padding = 10
  horizontal_padding = 15

  sort = yes  # sort messages by urgency

  idle_threshold = 120

  font = FiraMono Nerd Font 10
  line_height = 0

  markup = full  # allow some html tags

  # format of the message
  #   %a  appname
  #   %s  summary
  #   %b  body
  #   %i  iconname (including its path)
  #   %I  iconname (without its path)
  #   %p  progress value if set ([  0%] to [100%]) or nothing
  #   %n  progress value if set without any extra characters
  #   %%  Literal %
  format = "<b>%s</b>\n%b"

  show_age_threshold = 60

  word_wrap = yes

  ignore_newline = no

  stack_duplicates = true
  hide_duplicate_count = false

  show_indicators = yes  # indicators for URLs and actions

  icon_position = right
  min_icon_size = 18
  max_icon_size = 18

  # Should a notification popped up from history be sticky or timeout
  # as if it would normally do.
  sticky_history = yes

  history_length = 20

  # Always run rule-defined scripts, even if the notification is suppressed
  always_run_script = true

  # window props
  title = Dunst
  class = Dunst

  startup_notification = false

  verbosity = mesg

  # Ignore the dbus closeNotification message.
  # Useful to enforce the timeout set by dunst configuration. Without this
  # parameter, an application may close the notification sent before the
  # user defined timeout.
  ignore_dbusclose = false

  # mouse actions
  mouse_left_click = close_current
  mouse_middle_click = do_action, close_current
  mouse_right_click = close_all

[urgency_low]
  foreground = "#a6adc8"
  timeout = 7

[urgency_normal]
  timeout = 10

[urgency_critical]
  foreground = "#eba0ac"
  timeout = 15

[stack-brightness]
  appname = "brightctl"
  set_stack_tag = "brightctl"
  foreground = "#f9e2af"
  format = "<b>%s</b>"

[stack-volume]
  set_stack_tag = "volctl"
  appname = "volctl"
  foreground = "#b4befe"
  format = "<b>%s</b>"

[stack-battery]
  appname = "battery"
  set_stack_tag = "battery"
  format = "<b>%s</b>\n%b"

[battery-full]
  appname = "battery"
  category = "battery-full"
  foreground = "#a6e3a1"

[battery-low]
  appname = "battery"
  category = "battery-low"
  foreground = "#fab387"

[battery-critical]
  appname = "battery"
  category = "battery-critical"
  timeout = 0

# vim: ft=cfg
