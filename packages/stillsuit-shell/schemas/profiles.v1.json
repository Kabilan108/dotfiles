{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stillsuit.local/schemas/profiles.v1.json",
  "title": "Stillsuit plugin profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profiles"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "profiles": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(?!default$)[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "plugins": {
          "type": "object",
          "propertyNames": {
            "pattern": "^stillsuit\\.[a-z][a-z0-9.-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/pluginOverride"
          }
        }
      }
    },
    "pluginOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "section": {
          "enum": ["left", "center", "right"]
        },
        "order": {
          "type": "integer"
        },
        "settings": {
          "type": "object"
        }
      }
    }
  }
}
