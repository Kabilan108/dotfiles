{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stillsuit.local/schemas/theme.v1.json",
  "title": "Stillsuit theme v1",
  "description": "Canonical semantic theme record. Base16 and application themes are generated projections.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "identity",
    "palette",
    "colors",
    "controls",
    "typography",
    "geometry",
    "motion"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "mode"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^stillsuit(?:\\.[a-z][a-z0-9-]*)+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "mode": {
          "enum": [
            "dark",
            "light"
          ]
        }
      }
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "neutral",
        "chromatic"
      ],
      "properties": {
        "neutral": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "crust",
            "mantle",
            "base",
            "surface0",
            "surface1",
            "surface2",
            "overlay0",
            "overlay1",
            "overlay2",
            "subtext0",
            "subtext1",
            "text"
          ],
          "properties": {
            "crust": {
              "$ref": "#/$defs/color"
            },
            "mantle": {
              "$ref": "#/$defs/color"
            },
            "base": {
              "$ref": "#/$defs/color"
            },
            "surface0": {
              "$ref": "#/$defs/color"
            },
            "surface1": {
              "$ref": "#/$defs/color"
            },
            "surface2": {
              "$ref": "#/$defs/color"
            },
            "overlay0": {
              "$ref": "#/$defs/color"
            },
            "overlay1": {
              "$ref": "#/$defs/color"
            },
            "overlay2": {
              "$ref": "#/$defs/color"
            },
            "subtext0": {
              "$ref": "#/$defs/color"
            },
            "subtext1": {
              "$ref": "#/$defs/color"
            },
            "text": {
              "$ref": "#/$defs/color"
            }
          }
        },
        "chromatic": {
          "type": "object",
          "required": [
            "red",
            "yellow",
            "green",
            "cyan",
            "blue",
            "magenta"
          ],
          "properties": {
            "red": {
              "$ref": "#/$defs/color"
            },
            "yellow": {
              "$ref": "#/$defs/color"
            },
            "green": {
              "$ref": "#/$defs/color"
            },
            "cyan": {
              "$ref": "#/$defs/color"
            },
            "blue": {
              "$ref": "#/$defs/color"
            },
            "magenta": {
              "$ref": "#/$defs/color"
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/color"
          }
        }
      }
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "text",
        "border",
        "status"
      ],
      "properties": {
        "surface": {
          "$ref": "#/$defs/surfaceColors"
        },
        "text": {
          "$ref": "#/$defs/textColors"
        },
        "border": {
          "$ref": "#/$defs/borderColors"
        },
        "status": {
          "$ref": "#/$defs/statusColors"
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normal",
        "hover",
        "active",
        "focus",
        "disabled"
      ],
      "properties": {
        "normal": {
          "$ref": "#/$defs/controlState"
        },
        "hover": {
          "$ref": "#/$defs/controlState"
        },
        "active": {
          "$ref": "#/$defs/controlState"
        },
        "focus": {
          "$ref": "#/$defs/controlState"
        },
        "disabled": {
          "$ref": "#/$defs/controlState"
        }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "monospaceFamily",
        "baseSize",
        "scale",
        "weightNormal",
        "weightMedium",
        "weightBold"
      ],
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1
        },
        "monospaceFamily": {
          "type": "string",
          "minLength": 1
        },
        "baseSize": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "scale": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 3
        },
        "weightNormal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "weightMedium": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "weightBold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "radius",
        "density",
        "barHeight",
        "panelGap"
      ],
      "properties": {
        "radius": {
          "type": "number",
          "minimum": 0
        },
        "density": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "barHeight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "panelGap": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "motion": {
      "description": "Animation durations in milliseconds. Generators assert fast <= medium <= slow.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fast",
        "medium",
        "slow"
      ],
      "properties": {
        "fast": {
          "type": "integer",
          "minimum": 0
        },
        "medium": {
          "type": "integer",
          "minimum": 0
        },
        "slow": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-f]{6}$"
    },
    "surfaceColors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canvas",
        "panel",
        "raised",
        "hover"
      ],
      "properties": {
        "canvas": {
          "$ref": "#/$defs/color"
        },
        "panel": {
          "$ref": "#/$defs/color"
        },
        "raised": {
          "$ref": "#/$defs/color"
        },
        "hover": {
          "$ref": "#/$defs/color"
        }
      }
    },
    "textColors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "secondary",
        "tertiary",
        "onAccent"
      ],
      "properties": {
        "primary": {
          "$ref": "#/$defs/color"
        },
        "secondary": {
          "$ref": "#/$defs/color"
        },
        "tertiary": {
          "$ref": "#/$defs/color"
        },
        "onAccent": {
          "$ref": "#/$defs/color"
        }
      }
    },
    "borderColors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subtle",
        "normal",
        "focus"
      ],
      "properties": {
        "subtle": {
          "$ref": "#/$defs/color"
        },
        "normal": {
          "$ref": "#/$defs/color"
        },
        "focus": {
          "$ref": "#/$defs/color"
        }
      }
    },
    "statusColors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "info",
        "success",
        "warning",
        "danger"
      ],
      "properties": {
        "info": {
          "$ref": "#/$defs/color"
        },
        "success": {
          "$ref": "#/$defs/color"
        },
        "warning": {
          "$ref": "#/$defs/color"
        },
        "danger": {
          "$ref": "#/$defs/color"
        }
      }
    },
    "controlState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fill",
        "text",
        "border"
      ],
      "properties": {
        "fill": {
          "$ref": "#/$defs/color"
        },
        "text": {
          "$ref": "#/$defs/color"
        },
        "border": {
          "$ref": "#/$defs/color"
        }
      }
    }
  }
}
