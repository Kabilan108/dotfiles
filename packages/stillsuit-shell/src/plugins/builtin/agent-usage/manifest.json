{
  "schemaVersion": 1,
  "id": "stillsuit.agent-usage",
  "name": "Agent usage",
  "description": "Multi-account Codex and Claude Code rate-limit monitor.",
  "version": "1.0.0",
  "apiVersion": "1",
  "kinds": ["service", "bar-widget", "panel"],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "Widget.qml",
    "panel": "Panel.qml"
  },
  "scope": {
    "service": "global",
    "barWidget": "per-output",
    "panel": "per-output"
  },
  "capabilities": ["agent-credential-read", "network-access"],
  "barWidget": {
    "defaultSection": "right",
    "allowMultiple": false,
    "order": 30
  }
}
