{
  "schemaVersion": 1,
  "id": "stillsuit.resources",
  "name": "Resources",
  "description": "Local performance metrics and on-demand PC snapshots over fleet SSH.",
  "version": "1.1.0",
  "apiVersion": "1",
  "kinds": ["service", "bar-widget", "panel"],
  "entryPoints": { "service": "ResourceService.qml", "barWidget": "ResourceWidget.qml", "panel": "Panel.qml" },
  "scope": { "service": "global", "barWidget": "per-output", "panel": "per-output" },
  "capabilities": ["network-access"],
  "keepLoaded": true,
  "barWidget": { "defaultSection": "right", "allowMultiple": false, "order": 5 }
}
