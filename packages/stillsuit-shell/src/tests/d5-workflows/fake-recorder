#!/usr/bin/env bash
set -euo pipefail

printf '%s\n' "$*" >> "$STILLSUIT_FIXTURE_HELPER_LOG"
if [[ ${1:-} == rename ]]; then
  title=""
  while (($# > 0)); do
    if [[ $1 == --title ]]; then title=$2; shift 2; else shift; fi
  done
  printf '{"schemaVersion":1,"phase":"completed","output":"/tmp/fixture-recordings/%s.mp4","title":"%s","elapsed_seconds":62,"size_bytes":2048}\n' "$title" "$title" \
    | tee "$STILLSUIT_FIXTURE_RECORDING_STATE"
elif [[ ${1:-} == export ]]; then
  # The real helper spawns a worker and reports the export as running; a later
  # status call settles it once the worker exits. The fixture settles on the
  # second status call after the export was requested.
  format=$3
  jq -c --arg format "$format" '.export = {format: $format, phase: "running",
    output: (.output | sub("\\.mp4$"; "." + $format)), error: ""}' \
    "$STILLSUIT_FIXTURE_RECORDING_STATE" > "$STILLSUIT_FIXTURE_RECORDING_STATE.tmp"
  mv -- "$STILLSUIT_FIXTURE_RECORDING_STATE.tmp" "$STILLSUIT_FIXTURE_RECORDING_STATE"
  printf '0\n' > "$STILLSUIT_FIXTURE_RECORDING_STATE.polls"
  cat -- "$STILLSUIT_FIXTURE_RECORDING_STATE"
elif [[ ${1:-} == status && -s $STILLSUIT_FIXTURE_RECORDING_STATE.polls ]]; then
  polls=$(( $(<"$STILLSUIT_FIXTURE_RECORDING_STATE.polls") + 1 ))
  printf '%s\n' "$polls" > "$STILLSUIT_FIXTURE_RECORDING_STATE.polls"
  if (( polls >= 2 )); then
    result=completed
    [[ -e $STILLSUIT_FIXTURE_RECORDING_STATE.export-fail ]] && result=error
    jq -c --arg result "$result" '.export.phase = $result
      | .export.error = (if $result == "error" then "ffmpeg exited 1" else "" end)' \
      "$STILLSUIT_FIXTURE_RECORDING_STATE" > "$STILLSUIT_FIXTURE_RECORDING_STATE.tmp"
    mv -- "$STILLSUIT_FIXTURE_RECORDING_STATE.tmp" "$STILLSUIT_FIXTURE_RECORDING_STATE"
    rm -f -- "$STILLSUIT_FIXTURE_RECORDING_STATE.polls"
  fi
  cat -- "$STILLSUIT_FIXTURE_RECORDING_STATE"
elif [[ -s $STILLSUIT_FIXTURE_RECORDING_STATE ]]; then
  cat -- "$STILLSUIT_FIXTURE_RECORDING_STATE"
else
  printf '{"schemaVersion":1,"phase":"idle"}\n'
fi
