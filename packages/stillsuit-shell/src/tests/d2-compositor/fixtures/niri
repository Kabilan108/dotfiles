#!/usr/bin/env bash
set -euo pipefail

: "${STILLSUIT_D2_FIXTURE_STATE:?}"
printf '%s\n' "$*" >>"$STILLSUIT_D2_FIXTURE_STATE/argv.log"

next_count() {
  local name count_file count
  name=$1
  count_file="$STILLSUIT_D2_FIXTURE_STATE/$name-count"
  count=0
  if [[ -f $count_file ]]; then count=$(<"$count_file"); fi
  count=$((count + 1))
  printf '%s\n' "$count" >"$count_file"
  printf '%s\n' "$count"
}

wait_for_gate() {
  local gate
  gate=$1
  for _ in {1..400}; do
    if [[ -f $STILLSUIT_D2_FIXTURE_STATE/$gate ]]; then return 0; fi
    sleep 0.01
  done
  return 70
}

wait_while_held() {
  for _ in {1..400}; do
    if [[ ! -f $STILLSUIT_D2_FIXTURE_STATE/hold-reconcile ]]; then return 0; fi
    sleep 0.01
  done
  return 70
}

if [[ $* == 'msg --json event-stream' ]]; then
  count=$(next_count stream)
  if (( count == 1 )); then
    printf '%s\n' '{"OutputsChanged":{"outputs":{"eDP-1":{"logical":{"x":0}},"DP-2":{"id":"desk-output"}}}}'
    printf '%s\n' '{"WorkspacesChanged":{"workspaces":[{"id":1,"idx":1,"output":"DP-2","is_active":true,"is_focused":true,"is_urgent":false}]}}'
    printf '%s\n' '{"WindowsChanged":{"windows":[{"id":10,"workspace_id":1,"title":"generation-1","is_focused":true,"is_floating":false,"is_urgent":false,"layout":{"pos_in_scrolling_layout":[1,1],"tile_size":[640,480],"window_size":[640,480],"window_offset_in_tile":[0,0]}}]}}'
    printf '%s\n' 'not-json'
    # The first stream stays connected until the harness releases it, so the
    # harness can observe steady state with no reconnects.
    for _ in {1..2400}; do
      if [[ ! -d $STILLSUIT_D2_FIXTURE_STATE || -f $STILLSUIT_D2_FIXTURE_STATE/release-stream ]]; then break; fi
      sleep 0.05
    done
  else
    sleep 0.2
  fi
  exit 0
fi

case "$*" in
  'msg -j outputs')
    generation=$(next_count outputs)
    case "$generation" in
      1) printf '%s\n' '{"eDP-1":{"logical":{"x":0}},"DP-2":{"id":"desk-output"}}' ;;
      2) printf '%s\n' '{"BROKEN-OUTPUT":{"name":"must-not-commit"}}' ;;
      3)
        wait_for_gate allow-malformed
        printf '%s\n' 'malformed-command-output'
        ;;
      4)
        wait_for_gate allow-recovery
        sleep 8
        printf '%s\n' '{"HDMI-A-1":{"make":"must-time-out"}}'
        ;;
      *)
        wait_for_gate allow-final-recovery
        wait_while_held
        printf '%s\n' '{"HDMI-A-1":{"make":"Recovered"}}'
        ;;
    esac
    ;;
  'msg -j workspaces')
    generation=$(next_count workspaces)
    case "$generation" in
      1) printf '%s\n' '[{"id":1,"idx":1,"output":"DP-2","is_active":true,"is_focused":true,"is_urgent":false}]' ;;
      2) exit 23 ;;
      3)
        wait_for_gate allow-malformed
        printf '%s\n' '[{"id":300,"idx":1,"output":"MALFORMED","is_active":true,"is_focused":true,"is_urgent":false}]'
        ;;
      4)
        wait_for_gate allow-recovery
        sleep 8
        printf '%s\n' '[{"id":400,"idx":1,"output":"TIMEOUT","is_active":true,"is_focused":true,"is_urgent":false}]'
        ;;
      *)
        wait_for_gate allow-final-recovery
        wait_while_held
        printf '%s\n' '[{"id":4,"idx":1,"output":"HDMI-A-1","is_active":true,"is_focused":true,"is_urgent":false}]'
        ;;
    esac
    ;;
  'msg -j windows')
    generation=$(next_count windows)
    case "$generation" in
      1) printf '%s\n' '[{"id":10,"workspace_id":1,"title":"generation-1","is_focused":true,"is_floating":false,"is_urgent":false,"layout":{"pos_in_scrolling_layout":[1,1],"tile_size":[640,480],"window_size":[640,480],"window_offset_in_tile":[0,0]}}]' ;;
      2) printf '%s\n' '[{"id":20,"workspace_id":2,"title":"must-not-commit","is_focused":true,"is_floating":false,"is_urgent":false,"layout":{"pos_in_scrolling_layout":[1,1],"tile_size":[640,480],"window_size":[640,480],"window_offset_in_tile":[0,0]}}]' ;;
      3)
        wait_for_gate allow-malformed
        printf '%s\n' '[{"id":300,"workspace_id":300,"title":"must-not-commit","is_focused":true,"is_floating":false,"is_urgent":false,"layout":{"pos_in_scrolling_layout":[1,1],"tile_size":[640,480],"window_size":[640,480],"window_offset_in_tile":[0,0]}}]'
        ;;
      4)
        wait_for_gate allow-recovery
        sleep 8
        printf '%s\n' '[{"id":400,"workspace_id":400,"title":"must-time-out","is_focused":true,"is_floating":false,"is_urgent":false,"layout":{"pos_in_scrolling_layout":[1,1],"tile_size":[640,480],"window_size":[640,480],"window_offset_in_tile":[0,0]}}]'
        ;;
      *)
        wait_for_gate allow-final-recovery
        wait_while_held
        printf '%s\n' '[{"id":40,"workspace_id":4,"title":"generation-5","is_focused":true,"is_floating":false,"is_urgent":false,"layout":{"pos_in_scrolling_layout":[1,1],"tile_size":[640,480],"window_size":[640,480],"window_offset_in_tile":[0,0]}}]'
        ;;
    esac
    ;;
  'msg action focus-monitor '*|'msg action focus-workspace '*) ;;
  *) exit 64 ;;
esac
