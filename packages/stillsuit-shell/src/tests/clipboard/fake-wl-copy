#!/usr/bin/env python3
"""Records wl-copy argv and the exact stdin bytes under $FAKE_CLIP_DIR."""

import os
import sys
from pathlib import Path

root = Path(os.environ["FAKE_CLIP_DIR"])
(root / "wl-copy.argv").write_text("\n".join(sys.argv[1:]) + "\n", encoding="utf-8")
(root / "wl-copy.stdin").write_bytes(sys.stdin.buffer.read())
