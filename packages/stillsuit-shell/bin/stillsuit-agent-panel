#!/usr/bin/env bash
set -euo pipefail

readonly SESSION_NAME="stillsuit-agent"
readonly SESSION_TARGET="=$SESSION_NAME"
readonly APP_ID="com.mitchellh.ghostty"
readonly WINDOW_TITLE="Stillsuit Agent"
readonly DEFAULT_MODEL="gpt-5.6-sol"
readonly DEFAULT_EFFORT="low"
readonly DEFAULT_TIER="fast"
readonly SHUTDOWN_POLL_INTERVAL="0.05"
readonly SHUTDOWN_POLL_ATTEMPTS=100
readonly WINDOW_OPEN_POLL_INTERVAL="0.05"
readonly WINDOW_OPEN_POLL_ATTEMPTS=100
readonly SELF=${STILLSUIT_AGENT_PANEL_SELF:-$(readlink -f "${BASH_SOURCE[0]}")}
# Ghostty 1.3 prepends "--posix" to the command it starts in a new window.
readonly GHOSTTY_COMMAND="direct:$SELF attach"

usage() {
  printf 'usage: %s {open|hide|toggle|status|terminate}\n' "${0##*/}" >&2
  exit 64
}

while [[ $# -gt 0 && $1 == --posix ]]; do shift; done
[[ $# -eq 1 ]] || usage
readonly ACTION=$1
case "$ACTION" in
  attach) exec tmux attach-session -t "$SESSION_TARGET" ;;
  open | hide | toggle | status | terminate) ;;
  *) usage ;;
esac

readonly CONFIG_ROOT=${XDG_CONFIG_HOME:-${HOME:?HOME is not set}/.config}
readonly STATE_ROOT=${XDG_STATE_HOME:-${HOME:?HOME is not set}/.local/state}/stillsuit
readonly RUNTIME_ROOT=${XDG_RUNTIME_DIR:-$STATE_ROOT/run}
readonly CONFIG_FILE="$CONFIG_ROOT/stillsuit/agent-panel.json"
readonly LOCK_FILE="$RUNTIME_ROOT/agent-panel.lock"

mkdir -p "$RUNTIME_ROOT"
exec 9>"$LOCK_FILE"
flock 9

query_window_ids() {
  local windows
  windows=$(niri msg -j windows 2>/dev/null) || return
  jq -r --arg app_id "$APP_ID" --arg title "$WINDOW_TITLE" '.[] | select(.app_id == $app_id and .title == $title) | .id' <<<"$windows"
}

window_ids() {
  query_window_ids || true
}

load_window_ids() {
  local output id
  local -n destination=$1
  if ! output=$(query_window_ids); then
    printf 'failed to query Niri windows for the agent panel\n' >&2
    return 75
  fi
  destination=()
  if [[ -n $output ]]; then
    while IFS= read -r id; do
      destination+=("$id")
    done <<<"$output"
  fi
}

session_state() {
  local panes
  if ! tmux has-session -t "$SESSION_TARGET" 2>/dev/null; then
    printf 'absent\n'
    return
  fi
  if ! panes=$(tmux list-panes -t "$SESSION_TARGET" -F '#{pane_dead}' 2>/dev/null); then
    printf 'dead\n'
    return
  fi
  if [[ -z $panes ]] || grep -qx '1' <<<"$panes"; then
    printf 'dead\n'
  else
    printf 'running\n'
  fi
}

read_launch_config() {
  local config
  if [[ -e $CONFIG_FILE ]]; then
    [[ -f $CONFIG_FILE ]] || {
      printf 'agent panel config must be a regular file: %s\n' "$CONFIG_FILE" >&2
      return 78
    }
    config=$(<"$CONFIG_FILE")
  else
    config=$(jq -cn \
      --arg model "$DEFAULT_MODEL" \
      --arg effort "$DEFAULT_EFFORT" \
      --arg tier "$DEFAULT_TIER" \
      '{model: $model, reasoningEffort: $effort, serviceTier: $tier}')
  fi

  jq -e '
    type == "object" and
    (keys | sort) == ["model", "reasoningEffort", "serviceTier"] and
    (.model | type == "string" and IN("gpt-5.6-sol", "gpt-5.6-terra", "gpt-5.6-luna")) and
    (.reasoningEffort | type == "string" and IN("low", "medium", "high", "xhigh", "max", "ultra")) and
    (.serviceTier | type == "string" and IN("fast", "priority"))
  ' >/dev/null <<<"$config" || {
    printf 'invalid agent panel config: %s\n' "$CONFIG_FILE" >&2
    return 78
  }

  MODEL=$(jq -r '.model' <<<"$config")
  EFFORT=$(jq -r '.reasoningEffort' <<<"$config")
  TIER=$(jq -r '.serviceTier' <<<"$config")
  readonly MODEL EFFORT TIER
}

wait_for_windows_closed() {
  local attempt id windows all_closed
  local -a ids=("$@")
  ((${#ids[@]} > 0)) || return 0

  for ((attempt = 0; attempt < SHUTDOWN_POLL_ATTEMPTS; attempt++)); do
    if ! windows=$(query_window_ids); then
      printf 'failed to query Niri while waiting for agent panel windows to close\n' >&2
      return 75
    fi
    all_closed=true
    for id in "${ids[@]}"; do
      if grep -Fqx -- "$id" <<<"$windows"; then
        all_closed=false
        break
      fi
    done
    if [[ $all_closed == true ]]; then
      return
    fi
    ((attempt + 1 == SHUTDOWN_POLL_ATTEMPTS)) || sleep "$SHUTDOWN_POLL_INTERVAL"
  done

  printf 'timed out waiting for agent panel window IDs to close: %s\n' "${ids[*]}" >&2
  return 75
}

wait_for_window_open() {
  local attempt output
  for ((attempt = 0; attempt < WINDOW_OPEN_POLL_ATTEMPTS; attempt++)); do
    if ! output=$(query_window_ids); then
      printf 'failed to query Niri while waiting for the agent panel window to open\n' >&2
      return 75
    fi
    if [[ -n $output ]]; then
      return
    fi
    ((attempt + 1 == WINDOW_OPEN_POLL_ATTEMPTS)) || sleep "$WINDOW_OPEN_POLL_INTERVAL"
  done

  printf 'timed out waiting for the agent panel window to open\n' >&2
  return 75
}

close_window_ids() {
  local id
  local -a ids=("$@")
  ((${#ids[@]} > 0)) || return 0
  for id in "${ids[@]}"; do
    niri msg action close-window --id "$id" >/dev/null
  done
  wait_for_windows_closed "${ids[@]}"
}

close_windows() {
  local -a ids=()
  load_window_ids ids
  close_window_ids "${ids[@]}"
}

ensure_session() {
  local state=$1
  case "$state" in
    running)
      tmux set-option -t "$SESSION_NAME" set-titles off >/dev/null
      return ;;

    dead) tmux kill-session -t "$SESSION_TARGET" 2>/dev/null || true ;;
    absent) ;;
  esac

  read_launch_config
  tmux new-session -d -s "$SESSION_NAME" -c "$HOME" -- \
    codex --yolo --model "$MODEL" \
    --config "model_reasoning_effort=$EFFORT" \
    --config "service_tier=$TIER"
  tmux set-option -t "$SESSION_NAME" remain-on-exit on >/dev/null
  tmux set-option -t "$SESSION_NAME" set-titles off >/dev/null
}

launch_window() {
  if ! ghostty +new-window --title="$WINDOW_TITLE" --command="$GHOSTTY_COMMAND" >/dev/null 2>&1; then
    printf 'failed to request the agent window from shared Ghostty\n' >&2
    return 75
  fi
  wait_for_window_open
}

focus_single_window() {
  local -a ids=("$@")
  ((${#ids[@]} > 0)) || return 75
  niri msg action focus-window --id "${ids[0]}" >/dev/null
  close_window_ids "${ids[@]:1}"
}

open_panel() {
  local before
  local -a ids=()
  before=$(session_state)
  if [[ $before != running ]]; then
    close_windows
  fi
  ensure_session "$before"

  load_window_ids ids
  if ((${#ids[@]} > 0)); then
    focus_single_window "${ids[@]}"
  else
    launch_window
    load_window_ids ids
    focus_single_window "${ids[@]}"
  fi
}

toggle_panel() {
  local -a ids=()
  load_window_ids ids
  if ((${#ids[@]} > 0)); then
    hide_panel
  else
    open_panel
  fi
}

hide_panel() {
  close_windows
}

terminate_panel() {
  hide_panel
  if tmux has-session -t "$SESSION_TARGET" 2>/dev/null; then
    tmux kill-session -t "$SESSION_TARGET"
  fi
}

print_status() {
  local session windows window_state
  session=$(session_state)
  windows=$(window_ids | wc -l)
  windows=${windows//[[:space:]]/}
  if ((windows > 0)); then
    window_state=visible
  else
    window_state=absent
  fi
  jq -cn \
    --arg session "$session" \
    --arg window "$window_state" \
    --argjson windowCount "$windows" \
    '{session: $session, window: $window, windowCount: $windowCount, launchPending: false}'
}

case "$ACTION" in
  open) open_panel ;;
  hide) hide_panel ;;
  toggle) toggle_panel ;;
  status) ;;
  terminate) terminate_panel ;;
esac

print_status
