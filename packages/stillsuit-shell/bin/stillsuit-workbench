#!/usr/bin/env bash
# Runs the Stillsuit plugin workbench: the production core against fixture
# service models, in an isolated XDG sandbox on a nested compositor.
set -euo pipefail

usage() {
  cat >&2 <<'USAGE'
usage: stillsuit-workbench [options] {run|call ...|status|plugins|fixtures}

  run                 start the workbench (default)
  call TARGET FN ...  quickshell ipc call against the running workbench
  status              workbench status JSON
  plugins             sandbox plugin catalog (stillsuit-plugins list)
  fixtures            fixture ids

options:
  --fixture ID        initial fixture (default: default)
  --plugins DIR       sandbox plugin root (default: $XDG_CONFIG_HOME/stillsuit/workbench/plugins)
  --sandbox DIR       sandbox state root (default: $XDG_STATE_HOME/stillsuit/workbench)
  --source DIR        shell source tree (default: packaged source)
  --headless          nested compositor without a visible window (tests)
  --size WxH          nested output size (default: 1600x900)
  --theme PATH        theme.v2 json (default: production theme)
USAGE
  exit 64
}

fixture_id="default"
plugin_root="${XDG_CONFIG_HOME:-$HOME/.config}/stillsuit/workbench/plugins"
sandbox_root="${XDG_STATE_HOME:-$HOME/.local/state}/stillsuit/workbench"
source_root="${STILLSUIT_WORKBENCH_SOURCE:-}"
theme_path="${STILLSUIT_WORKBENCH_THEME:-${XDG_CONFIG_HOME:-$HOME/.config}/stillsuit/theme.json}"
headless=0
size="1600x900"
command_name="run"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --fixture) fixture_id=$2; shift 2 ;;
    --plugins) plugin_root=$2; shift 2 ;;
    --sandbox) sandbox_root=$2; shift 2 ;;
    --source) source_root=$2; shift 2 ;;
    --theme) theme_path=$2; shift 2 ;;
    --headless) headless=1; shift ;;
    --size) size=$2; shift 2 ;;
    -h | --help) usage ;;
    run | call | status | plugins | fixtures) command_name=$1; shift; break ;;
    *) usage ;;
  esac
done

[[ -n $source_root ]] || source_root=${STILLSUIT_WORKBENCH_PACKAGED_SOURCE:?no shell source; pass --source}
[[ -d $source_root ]] || { printf 'shell source not found: %s\n' "$source_root" >&2; exit 66; }
fixture_root="$source_root/../design-lab/fixtures"
[[ -d $fixture_root ]] || fixture_root="${STILLSUIT_WORKBENCH_FIXTURES:?no fixture directory}"
schema_path="$source_root/../schemas/manifest.v1.json"
config_id="stillsuit-workbench"
pid_file="$sandbox_root/quickshell.pid"

runtime_root="$sandbox_root/runtime"
config_home="$sandbox_root/config"
data_home="$sandbox_root/data"
state_home="$sandbox_root/state"
workflow_root="$sandbox_root/workflow"

ipc() {
  [[ -f $pid_file ]] || { printf 'workbench is not running\n' >&2; exit 69; }
  local pid
  pid=$(<"$pid_file")
  kill -0 "$pid" 2>/dev/null || { printf 'workbench is not running\n' >&2; exit 69; }
  XDG_RUNTIME_DIR="$runtime_root" quickshell ipc --pid "$pid" call "$@"
}

case "$command_name" in
  call) ipc "$@"; exit ;;
  status) ipc stillsuit-workbench status; exit ;;
  fixtures) ipc stillsuit-workbench fixtures; exit ;;
  plugins) exec stillsuit-plugins --config "$config_home/stillsuit/runtime-discovery.json" list ;;
  run) ;;
esac

mkdir -p "$runtime_root" "$config_home/stillsuit" "$data_home" "$state_home" "$workflow_root" "$plugin_root"
chmod 700 "$runtime_root"
: > "$workflow_root/recording.json"

# Named module imports (Stillsuit.Ui, Stillsuit.Services) for sandbox plugins.
qml_root="$sandbox_root/qml/Stillsuit"
mkdir -p "$qml_root"
ln -sfn "$source_root/ui" "$qml_root/Ui"
ln -sfn "$source_root/services" "$qml_root/Services"

# Seed: every builtin plugin with sandbox-safe settings. Nothing here reaches
# real helpers, sockets, or the session bus.
python3 - "$source_root" "$config_home/stillsuit/seed.json" "$workflow_root" <<'PY'
import json, sys
from pathlib import Path
source, seed_path, workflow = Path(sys.argv[1]), Path(sys.argv[2]), sys.argv[3]
builtin = source / "plugins" / "builtin"
settings = {
    "stillsuit.bar": {"shadowMode": False},
    "stillsuit.notifications": {"shadowMode": True, "claimNotificationBus": False},
    "stillsuit.workflows": {
        "recordingStatePath": f"{workflow}/recording.json",
        "meetingJobsPath": f"{workflow}/meeting-jobs.json",
        "meetingStatusPath": f"{workflow}/meeting-status.json",
        "recordingDirectory": f"{workflow}/recordings",
    },
    "stillsuit.osd": {"brightnessPath": "", "brightnessMaxPath": ""},
    "stillsuit.agent-usage": {"includeDefaults": True, "accounts": []},
}
rows = []
for folder in sorted(builtin.iterdir()):
    manifest_path = folder / "manifest.json"
    if not manifest_path.is_file():
        continue
    manifest = json.loads(manifest_path.read_text())
    rows.append({"manifest": manifest, "packageRoot": str(folder.resolve()),
                 "enabled": True, "settings": settings.get(manifest["id"], {})})
seed_path.write_text(json.dumps({"schemaVersion": 1, "selectedBar": "stillsuit.bar", "plugins": rows}, indent=2))
PY

cat > "$config_home/stillsuit/runtime-discovery.json" <<JSON
{
  "seed": "$config_home/stillsuit/seed.json",
  "roots": ["$plugin_root", "$source_root/plugins/builtin"],
  "state": "$state_home/stillsuit",
  "core": "$source_root",
  "schema": "$schema_path",
  "preferences": "$config_home/stillsuit/plugins.json"
}
JSON

sway_bin=$(command -v sway || true)
[[ -n $sway_bin ]] || { printf 'sway is required for the nested compositor\n' >&2; exit 69; }
sway_conf="$sandbox_root/sway.conf"
printf 'output * resolution %s\n' "${size/x/ }" > "$sway_conf"
if [[ $headless -eq 1 ]]; then
  export WLR_BACKENDS=headless WLR_HEADLESS_OUTPUTS=1 WLR_LIBINPUT_NO_DEVICES=1 WLR_RENDERER=pixman
else
  export WLR_BACKENDS=wayland
fi
env -u DISPLAY XDG_RUNTIME_DIR="$runtime_root" DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime_root/no-bus" \
  "$sway_bin" -c "$sway_conf" > "$sandbox_root/sway.log" 2>&1 &
sway_pid=$!
cleanup() {
  [[ -f $pid_file ]] && { kill "$(<"$pid_file")" 2>/dev/null || true; rm -f "$pid_file"; }
  kill "$sway_pid" 2>/dev/null || true
}
trap cleanup EXIT

nested_socket=""
for _ in $(seq 1 200); do
  for candidate in "$runtime_root"/wayland-*; do
    [[ -S $candidate ]] && { nested_socket=$(basename "$candidate"); break; }
  done
  [[ -n $nested_socket ]] && break
  sleep 0.05
done
[[ -n $nested_socket ]] || { cat "$sandbox_root/sway.log" >&2; exit 70; }

export HOME="$sandbox_root/home"
mkdir -p "$HOME"
export XDG_RUNTIME_DIR="$runtime_root" XDG_CONFIG_HOME="$config_home" \
  XDG_DATA_HOME="$data_home" XDG_STATE_HOME="$state_home" \
  WAYLAND_DISPLAY="$nested_socket" QT_QPA_PLATFORM=wayland
unset DBUS_SESSION_BUS_ADDRESS
export STILLSUIT_CONFIG_ID="$config_id" \
  STILLSUIT_THEME_PATH="$theme_path" \
  STILLSUIT_ALLOW_LOCAL_PLUGINS=1 \
  STILLSUIT_PLUGIN_RUNTIME_CONFIG="$config_home/stillsuit/runtime-discovery.json" \
  STILLSUIT_PLUGIN_HELPER="$(command -v stillsuit-plugins)" \
  STILLSUIT_WORKBENCH_FIXTURES="$fixture_root" \
  STILLSUIT_WORKBENCH_FIXTURE="$fixture_id" \
  STILLSUIT_WORKBENCH_STATE="$workflow_root" \
  QML_IMPORT_PATH="$sandbox_root/qml"

quickshell --no-color -p "$source_root/workbench.qml" > "$sandbox_root/shell.log" 2>&1 &
shell_pid=$!
printf '%s\n' "$shell_pid" > "$pid_file"
printf 'workbench pid %s, plugins %s, log %s\n' "$shell_pid" "$plugin_root" "$sandbox_root/shell.log"
wait "$shell_pid"
