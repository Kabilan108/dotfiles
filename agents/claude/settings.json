{
  "cleanupPeriodDays": 99999999,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_NO_FLICKER": "1"
  },
  "permissions": {
    "allow": [
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "mcp__nixos__nixos_search",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "mcp__nixos__home_manager_search",
      "mcp__nixos__home_manager_info",
      "Bash(nix flake check:*)",
      "Bash(ls:*)",
      "Read(//home/kabilan/.local/state/nvim/**)",
      "Bash(nvim:*)",
      "WebSearch",
      "WebFetch(domain:chatgpt.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:wiki.hypr.land)",
      "WebFetch(domain:docs.vicinae.com)",
      "WebFetch(domain:wiki.hyprland.org)",
      "Bash(unzip:*)",
      "Bash(cat:*)",
      "WebFetch(domain:docs.exa.ai)",
      "Bash(find:*)",
      "Bash(mkdir:*)",
      "Bash(bun run:*)",
      "Bash(~/.config/claude/bin/exa \"python logging\")",
      "Bash(/home/kabilan/dotfiles/config/claude/bin/exa:*)",
      "Bash(atuin status:*)",
      "Bash(echo:*)",
      "Bash(atuin history list:*)",
      "Bash(atuin:*)",
      "Bash(bash -l -c:*)",
      "Bash(bash:*)",
      "Bash(chmod:*)",
      "Bash(nmcli connection:*)",
      "WebFetch(domain:nixos.wiki)",
      "Bash(git push)",
      "WebFetch(domain:ampcode.com)",
      "WebFetch(domain:hamel.dev)",
      "WebFetch(domain:gist.github.com)",
      "Bash(tmux capture-pane:*)",
      "Skill(tmux)",
      "mcp__deepwiki__ask_question",
      "Bash(ghostty +list-keybinds --default)"
    ],
    "deny": [],
    "defaultMode": "default"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "send-notify -u normal \"Claude: $(jq -r '.message')\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '\"\\(.session_id), \\(.tool_input.command), \\(.tool_input.description // \"No description\")\"' >> $HOME/.claude/logs/bash-commands.txt"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "voiceEnabled": true,
  "editorMode": "vim"
}
