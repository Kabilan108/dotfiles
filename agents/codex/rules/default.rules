prefix_rule(pattern=["perl", "-0pi", "-e", "s/    def _span\\(self, name: str, \\*\\*attrs\\) -> LogfireSpan \\| ContextManager\\[None\\]:\\n        \"\"\"Create a Logfire span if enabled, otherwise return nullcontext\\.\"\"\"\\n        if self\\._logfire_enabled:\\n            return logfire\\.span\\(name, \\*\\*attrs\\)\\n        return nullcontext\\(\\)/    @property\\n    def logfire_enabled(self) -> bool:\\n        \"\"\"Whether Logfire span creation is enabled for this observer.\"\"\"\\n        return self._logfire_enabled\\n\\n    def span(self, name: str, **attrs) -> LogfireSpan | ContextManager[None]:\\n        \"\"\"Create a Logfire span if enabled, otherwise return nullcontext.\"\"\"\\n        if self._logfire_enabled:\\n            return logfire.span(name, **attrs)\\n        return nullcontext()\\n\\n    def current_span_ids(self) -> tuple[str | None, str | None]:\\n        \"\"\"Get current trace/span IDs when Logfire is enabled, otherwise None IDs.\"\"\"\\n        if not self._logfire_enabled:\\n            return None, None\\n        return get_current_span_ids()/s", "xploit/observability/observer.py"], decision="allow")
