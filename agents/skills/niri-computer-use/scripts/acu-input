#!/usr/bin/env python3
from __future__ import annotations

import argparse
import shutil
import subprocess

from libacu import run_tool


MODIFIER_ALIASES = {
    "mod": "super",
    "meta": "super",
}


def normalize_chord(chord: str) -> str:
    parts = chord.split("+")
    normalized = [MODIFIER_ALIASES.get(part.lower(), part) for part in parts]
    return "+".join(normalized)


def run_dotool(lines: list[str]) -> None:
    payload = "\n".join(lines) + "\n"
    if shutil.which("dotool"):
        command = ["dotool"]
    elif shutil.which("nix-shell"):
        command = ["nix-shell", "-p", "dotool", "--run", "dotool"]
    else:
        raise SystemExit("missing required tool: dotool")

    subprocess.run(command, input=payload, text=True, check=True)


def main() -> None:
    parser = argparse.ArgumentParser(description="Send Wayland text, key, pointer, and click events.")
    subparsers = parser.add_subparsers(dest="command", required=True)

    type_parser = subparsers.add_parser("type", help="type text with wtype")
    type_parser.add_argument("text")

    key_parser = subparsers.add_parser("key", help="send a key or chord with wtype")
    key_parser.add_argument("key")

    shortcut_parser = subparsers.add_parser("shortcut", help="send a desktop shortcut, accepting niri-style mod+ chords")
    shortcut_parser.add_argument("chord")

    move_parser = subparsers.add_parser("move", help="move the pointer")
    move_parser.add_argument("x", type=float)
    move_parser.add_argument("y", type=float)
    move_parser.add_argument("--absolute", action="store_true", help="treat x/y as 0.0-1.0 screen fractions")

    click_parser = subparsers.add_parser("click", help="click a pointer button")
    click_parser.add_argument("button", choices=("left", "middle", "right"))

    down_parser = subparsers.add_parser("buttondown", help="press a pointer button")
    down_parser.add_argument("button", choices=("left", "middle", "right"))

    up_parser = subparsers.add_parser("buttonup", help="release a pointer button")
    up_parser.add_argument("button", choices=("left", "middle", "right"))

    wheel_parser = subparsers.add_parser("wheel", help="scroll vertically")
    wheel_parser.add_argument("amount", type=int)

    args = parser.parse_args()

    if args.command == "type":
        run_tool(["wtype", args.text])
    elif args.command == "key":
        run_dotool([f"key {args.key}"])
    elif args.command == "shortcut":
        run_dotool([f"key {normalize_chord(args.chord)}"])
    elif args.command == "move":
        verb = "mouseto" if args.absolute else "mousemove"
        run_dotool([f"{verb} {args.x} {args.y}"])
    elif args.command == "click":
        run_dotool([f"click {args.button}"])
    elif args.command == "buttondown":
        run_dotool([f"buttondown {args.button}"])
    elif args.command == "buttonup":
        run_dotool([f"buttonup {args.button}"])
    elif args.command == "wheel":
        run_dotool([f"wheel {args.amount}"])


if __name__ == "__main__":
    main()
