#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json

from libacu import niri_json, run_tool


def collect_state() -> dict[str, object]:
    state: dict[str, object] = {}
    for name in ("outputs", "workspaces", "windows", "layers", "keyboard-layouts", "focused-window", "overview-state"):
        try:
            state[name] = niri_json(name)
        except Exception as exc:
            state[name] = {"error": str(exc)}

    try:
        state["version"] = run_tool(["niri", "msg", "version"]).stdout.strip()
    except Exception as exc:
        state["version"] = {"error": str(exc)}

    return state


def print_summary(state: dict[str, object]) -> None:
    print("Outputs")
    outputs = state.get("outputs")
    if isinstance(outputs, dict):
        for name, output in outputs.items():
            logical = output.get("logical", {}) if isinstance(output, dict) else {}
            print(f"  {name}: {logical.get('width')}x{logical.get('height')}+{logical.get('x')}+{logical.get('y')} scale={logical.get('scale')}")

    print("Workspaces")
    workspaces = state.get("workspaces")
    if isinstance(workspaces, list):
        for workspace in workspaces:
            if isinstance(workspace, dict):
                marker = "*" if workspace.get("is_focused") else " "
                print(f" {marker} id={workspace.get('id')} idx={workspace.get('idx')} output={workspace.get('output')} active_window={workspace.get('active_window_id')}")

    print("Windows")
    windows = state.get("windows")
    if isinstance(windows, list):
        for window in windows:
            if isinstance(window, dict):
                marker = "*" if window.get("is_focused") else " "
                print(f" {marker} id={window.get('id')} app={window.get('app_id')} workspace={window.get('workspace_id')} title={window.get('title')}")

    print("Layers")
    layers = state.get("layers")
    if isinstance(layers, list):
        for layer in layers:
            if isinstance(layer, dict):
                print(f"  {layer.get('namespace')}: layer={layer.get('layer')} output={layer.get('output')}")

    version = state.get("version")
    if isinstance(version, str):
        print("Version")
        for line in version.splitlines():
            print(f"  {line}")


def main() -> None:
    parser = argparse.ArgumentParser(description="Inspect the current niri desktop state.")
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--summary", action="store_true", help="print a human-readable summary")
    group.add_argument("--json", action="store_true", help="print raw JSON")
    args = parser.parse_args()

    state = collect_state()
    if args.json:
        print(json.dumps(state, indent=2, sort_keys=True))
    else:
        print_summary(state)


if __name__ == "__main__":
    main()
