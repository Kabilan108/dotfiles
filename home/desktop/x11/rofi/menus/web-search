#!/usr/bin/env bash
# vim: syn=bash ft=bash

BROWSER_BIN="helium"
SEARCH_URL="https://unduck.link?q=%s"

chosen=$(rofi -dmenu -p "Search" -theme-str 'window { width: 600px; height: 75px; }')

if [[ -z "$chosen" ]]; then
    exit 0
fi

if ! command -v jq &> /dev/null; then
    rofi -e "jq command not found. Cannot URL encode search query."
    exit 1
fi

# printf %s ensures no trailing newline is passed to jq
# jq -sRr @uri:
#   -s: Slurp the entire input into a single string
#   -R: Raw input (don't parse as JSON)
#   -r: Raw output (don't wrap in quotes)
#   @uri: URI encode the string
encoded_chosen=$(printf %s "$chosen" | jq -sRr @uri)
final_url=$(printf "$SEARCH_URL" "$encoded_chosen")

if [[ -n "$final_url" ]]; then
    setsid "$BROWSER_BIN" "$final_url" >/dev/null 2>&1 &
fi

exit 0
