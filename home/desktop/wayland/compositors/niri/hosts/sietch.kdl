output "DP-1" {
    mode "3440x1440@180.000"
    scale 1
    position x=0 y=0
}

spawn-sh-at-startup "swaybg -i $HOME/dotfiles/wallpapers/uwide/lucy.png -m fill"

debug {
    disable-pipewire-dmabuf
}

binds {
    Mod+Alt+Shift+D hotkey-overlay-title="Toggle DP-1 Output" { spawn "niri-toggle-output" "DP-1" "HDMI-A-1"; }
}
