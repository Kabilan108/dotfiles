input {
    keyboard {
        xkb {
        }
    }

    touchpad {
        tap
    }

    mouse {
    }

    trackpoint {
    }

    focus-follows-mouse max-scroll-amount="0%"
}

include optional=true "~/.config/niri/host.kdl"

layout {
    gaps 6

    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 2

        active-color "#89b4faee"
        inactive-color "#45475aaa"
    }

    border {
        off

        width 4
        active-color "#ffc87f"
        inactive-color "#505050"

        urgent-color "#9b0000"
    }

    shadow {
        softness 30

        spread 5

        offset x=0 y=5

        color "#0007"
    }

    tab-indicator {
        width 10
        gap 8
        length total-proportion=0.2
        position "left"
        gaps-between-tabs 10
        corner-radius 9999

        hide-when-single-tab
        place-within-column

  active-color  "#11111bff"
  inactive-color "#6c7086ff"
  urgent-color   "#f38ba8ff"
    }

    struts {
    }
}

spawn-at-startup "niriusd"
spawn-sh-at-startup "sleep 2 && busctl --user set-property org.a11y.Bus /org/a11y/bus org.a11y.Status ScreenReaderEnabled b true"
spawn-at-startup "swayidle" "-w"
spawn-at-startup "obsidian"

hotkey-overlay {
    skip-at-startup
}

prefer-no-csd

screenshot-path "~/media/screenshots/%Y.%m.%d-%H.%M.%S.png"

animations {
    slowdown 0.7
}

window-rule {
    match app-id=r#"^com\.mitchellh\.ghostty$"# title=r#"^Stillsuit Agent$"#
    open-floating true
    default-column-width { proportion 0.3; }
    default-window-height { proportion 0.8; }
    default-floating-position x=64 y=64 relative-to="bottom-right"
}

window-rule {
    match app-id=r#"^(obsidian|md\.obsidian\.Obsidian)$"# app-id=r#"^com\.onepassword\.OnePassword$"#
    block-out-from "screen-capture"
}

window-rule {
    match app-id=r#"^HeliumAgentsDevTools$"#
    open-focused false
}

window-rule {
    match title="^Picture[- ]in[- ][Pp]icture$"
    open-floating true
    default-column-width { fixed 650; }
    default-window-height { fixed 350; }
}

window-rule {
    match app-id=r#"^org\.pulseaudio\.pavucontrol$"#
    open-floating true
}

window-rule {
    match app-id=r#"^nm-connection-editor$"#
    open-floating true
    default-column-width { fixed 560; }
    default-window-height { fixed 420; }
}

window-rule {
    match app-id=r#"^org\.gnome\.Loupe$"#
    open-floating true
}

window-rule {
    match app-id=r#"^omasnap$"#
    open-floating true
}

window-rule {
    match app-id=r#"^scout$"#
    open-floating true
    default-column-width { proportion 0.6; }
    default-window-height { proportion 0.7; }
}

window-rule {
    match app-id=r#"^blueman-manager$"#
    open-floating true
    default-column-width { fixed 560; }
    default-window-height { fixed 420; }
}

window-rule {
    match title=r#"^Extension:"#
    open-floating true
}

window-rule {
    match app-id=r#"^Signal$"#
    open-floating true
}

window-rule {
    match app-id=r#"^zoom$"#
    open-floating true
}

window-rule {
    match app-id=r#"^TelegramDesktop$"#
    open-floating true
}

window-rule {
    match app-id=r#"^org.gnome.Papers$"#
    open-floating true
}

window-rule {
    match app-id=r#"^steam$"#
    open-floating true
}

window-rule {
    match app-id=r#"^Emulator$"#
    open-floating true
}

window-rule {
    match app-id=r#"^chrome-"#
    open-floating true
}

window-rule {
    match app-id=r#"^chrome-messages.google.com__web-Default$"#
    open-floating false
}

window-rule {
    match app-id=r#"^chrome-sietch-kvm\.sole-pierce\.ts\.net__-Default$"#
    open-floating false
}

window-rule {
    geometry-corner-radius 5
    clip-to-geometry true
    draw-border-with-background false
    open-maximized-to-edges false
}

window-rule {
    match app-id=r#"^com\.mitchellh\.ghostty$"#
    match app-id=r#"^Slack$"#
    match app-id=r#"^(obsidian|md\.obsidian\.Obsidian)$"#

    opacity 0.85
    background-effect {
        blur true
    }
}

overview {
    backdrop-color "#11111b"
}

gestures {
    hot-corners {
        off
    }
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+D hotkey-overlay-title="Run an Application" { spawn "qs" "ipc" "-c" "stillsuit-next" "call" "stillsuit-surface" "toggle" "stillsuit.launcher" "{\"mode\":\"combi\"}"; }
    Mod+Tab hotkey-overlay-title="Switch Window" { spawn "qs" "ipc" "-c" "stillsuit-next" "call" "stillsuit-surface" "toggle" "stillsuit.launcher" "{\"mode\":\"windows\"}"; }
    Mod+Shift+E hotkey-overlay-title="Power Menu" { spawn "qs" "ipc" "-c" "stillsuit-next" "call" "stillsuit-surface" "toggle" "stillsuit.launcher" "{\"mode\":\"power\"}"; }
    Mod+Alt+P hotkey-overlay-title="Plugin Profiles" { spawn "qs" "ipc" "-c" "stillsuit-next" "call" "stillsuit-surface" "toggle" "stillsuit.launcher" "{\"mode\":\"profiles\"}"; }
    Mod+Alt+C hotkey-overlay-title="Remote Connections" { spawn "qs" "ipc" "-c" "stillsuit-next" "call" "stillsuit-surface" "toggle" "stillsuit.launcher" "{\"mode\":\"remmina\"}"; }
    Mod+V hotkey-overlay-title="Clipboard" { spawn "qs" "ipc" "-c" "stillsuit-next" "call" "stillsuit-surface" "toggle" "stillsuit.launcher" "{\"mode\":\"clipboard\"}"; }

    Mod+A hotkey-overlay-title="Audio Mixer" { spawn "qs" "ipc" "-c" "stillsuit-next" "call" "stillsuit-surface" "toggle" "stillsuit.audio" "{}"; }
    Mod+Alt+B hotkey-overlay-title="Bluetooth" { spawn "qs" "ipc" "-c" "stillsuit-next" "call" "stillsuit-surface" "toggle" "stillsuit.bluetooth" "{}"; }
    Mod+N hotkey-overlay-title="Toggle Quiet Mode" { spawn "qs" "ipc" "-c" "stillsuit-next" "call" "stillsuit-notifications" "toggleQuiet"; }
    Mod+Alt+R hotkey-overlay-title="Screen Recording" { spawn "qs" "ipc" "-c" "stillsuit-next" "call" "stillsuit-surface" "toggle" "stillsuit.recording" "{}"; }
    Mod+Grave hotkey-overlay-title="Toggle Agent Panel" { spawn "qs" "ipc" "-c" "stillsuit-next" "call" "stillsuit-agent-panel" "toggle"; }

    Mod+Alt+L hotkey-overlay-title="Lock the Screen: swaylock" { spawn "lock-screen"; }

    Mod+Return hotkey-overlay-title="Open a Terminal: ghostty" { spawn "ghostty" "+new-window"; }
    Mod+Shift+Return hotkey-overlay-title="Open Floating Note: Obsidian" { spawn "coppermind-quick-note"; }
    Mod+B hotkey-overlay-title="Open Browser: helium" { spawn "helium"; }

    Mod+T { spawn "dictator" "toggle"; }
    F3 { spawn "dictator" "cancel"; }

    XF86AudioPlay  allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPause allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext  allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev  allow-when-locked=true { spawn "playerctl" "previous"; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "volctl" "+5"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "volctl" "-5"; }
    XF86AudioMute        allow-when-locked=true { spawn "volctl" "mute"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "volctl" "mute-mic"; }

    XF86MonBrightnessUp allow-when-locked=true { spawn "brightctl" "+10"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightctl" "-10"; }

    Mod+O repeat=false { toggle-overview; }

    Mod+S hotkey-overlay-title="Toggle Sticky Window: nirius" { spawn "nirius" "toggle-follow-mode"; }

    Mod+Shift+Q repeat=false { close-window; }

    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    Mod+Shift+H     { move-column-left; }
    Mod+Shift+J     { move-window-down; }
    Mod+Shift+K     { move-window-up; }
    Mod+Shift+L     { move-column-right; }

    Mod+Left { focus-column-first; }
    Mod+Right  { focus-column-last; }
    Mod+Shift+Left { move-column-to-first; }
    Mod+Shift+Right  { move-column-to-last; }

    Mod+Ctrl+H     { focus-monitor-left; }
    Mod+Ctrl+J     { focus-monitor-down; }
    Mod+Ctrl+K     { focus-monitor-up; }
    Mod+Ctrl+L     { focus-monitor-right; }

    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }

    Mod+Alt+Ctrl+H     { move-workspace-to-monitor-left; }
    Mod+Alt+Ctrl+J     { move-workspace-to-monitor-down; }
    Mod+Alt+Ctrl+K     { move-workspace-to-monitor-up; }
    Mod+Alt+Ctrl+L     { move-workspace-to-monitor-right; }

    Mod+BracketLeft        { focus-workspace-up; }
    Mod+Shift+BracketLeft  { move-column-to-workspace-up; }
    Mod+Ctrl+BracketLeft   { move-workspace-up; }

    Mod+BracketRight       { focus-workspace-down; }
    Mod+Shift+BracketRight { move-column-to-workspace-down; }
    Mod+Ctrl+BracketRight  { move-workspace-down; }

    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Shift+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Shift+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Shift+WheelScrollRight { move-column-right; }
    Mod+Shift+WheelScrollLeft  { move-column-left; }

    Mod+Ctrl+WheelScrollDown      { focus-column-right; }
    Mod+Ctrl+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }

    Mod+F { maximize-column; }
    Mod+Shift+F { spawn-sh "niri msg action toggle-windowed-fullscreen && niri msg action maximize-window-to-edges"; }

    Mod+C { center-column; }

    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    Mod+Shift+Space { toggle-window-floating; }
    Mod+Space       { switch-focus-between-floating-and-tiling; }

    Mod+W { toggle-column-tabbed-display; }

    Print { spawn-sh "OMASNAP_SCREENSHOT_DIR=$HOME/media/screenshots exec omasnap"; }
    Ctrl+Print { spawn-sh "OMASNAP_SCREENSHOT_DIR=$HOME/media/screenshots exec omasnap --editor overlay"; }
    Mod+Print { spawn-sh "OMASNAP_SCREENSHOT_DIR=$HOME/media/screenshots exec omasnap --scroll"; }
    Shift+Print { spawn-sh "OMASNAP_SCREENSHOT_DIR=$HOME/media/screenshots exec omasnap --capture-window"; }
    Alt+Print { spawn-sh "OMASNAP_SCREENSHOT_DIR=$HOME/media/screenshots exec omasnap --capture-fullscreen"; }

    Mod+Escape { focus-workspace-previous; }
    Mod+Shift+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
}
